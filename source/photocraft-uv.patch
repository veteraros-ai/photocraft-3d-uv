+    fn benchmark_uv_seam_4k_refresh() {
+        for wrap in [false, true] {
+            let (mut app, scene, g) = setup(Tool::Brush);
+            app.run("uv.texture.create", json!({"width":4096,"height":4096,"depth":16})).unwrap();
