+pub(crate) struct Draw<'a> {
+    pub scene: &'a Scene,
+    pub geometry: Arc<Geometry>,
+    pub camera: Camera,
+    pub size: [u32; 2],
+    pub antialias: bool,
+    pub selected: &'a BTreeSet<usize>,
+    pub hidden: &'a BTreeSet<usize>,
