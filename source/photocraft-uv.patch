+    #[serde(default)]
+    source_stamp: Option<crate::uv_reload_cmds::SourceStamp>,
+    selected: BTreeSet<usize>,
+    #[serde(default)]
+    selection_documents: Option<Vec<usize>>,
+    material: usize,
+    guard: f64,
+    #[serde(default)]
+    horizontal: f64,
+    #[serde(default)]
+    vertical: f64,
+    feather: f64,
+    open_borders: bool,
+    documents: Vec<Option<String>>,
+    #[serde(default)]
+    normal_documents: Vec<Option<String>>,
+    #[serde(default)]
