diff --git a/crates/ui-egui/src/uv_lighting.rs b/crates/ui-egui/src/uv_lighting.rs
new file mode 100644
index 0000000000000000000000000000000000000000..923fe4378944d39605bc145cebcd0c1e9be3c40f
--- /dev/null
+++ b/crates/ui-egui/src/uv_lighting.rs
@@ -0,0 +1,327 @@
+//! View-only environment resources, source-profile-aware PBR maps and native environment picker.
+use crate::PhotocraftApp;
+use photocraft_uv::{
+    lighting::Environment,
+    preview::{Channel, Image},
+};
+use std::sync::Arc;
+
+pub(crate) const MAPS: [Channel; 5] = [Channel::Color, Channel::Metallic, Channel::Roughness, Channel::Ao, Channel::Emissive];
+pub(crate) type Key = (u64, u64, u64, u64);
+pub(crate) type RegionHint = (Key, Vec<[u32; 4]>);
+#[derive(Default)]
+pub(crate) struct SurfaceMaps {
+    pub images: [Vec<Option<Image>>; 5],
+    pub keys: [Vec<Key>; 5],
+    pub regions: [Vec<Option<RegionHint>>; 5],
+    pub output: Option<(u64, Image)>,
+    snapshots: [Vec<Option<Arc<photocraft_doc::Document>>>; 5],
+}
+#[derive(Default)]
+pub(crate) struct Cache {
+    pub path: String,
+    pending_path: String,
+    pub surface: SurfaceMaps,
+    pub environment: Option<Arc<Environment>>,
+    pub name: String,
+    preview: Option<egui::TextureHandle>,
+    #[cfg(not(target_arch = "wasm32"))]
+    pending: Option<std::sync::mpsc::Receiver<Result<(String, Environment), String>>>,
+}
+pub(crate) fn refresh(app: &mut PhotocraftApp, maps: &mut SurfaceMaps) -> Result<(), String> {
+    let monitor = app.session.active().and_then(|st| app.session.color.canvas_display(&st.doc).ok()).map(|d| d.monitor.clone());
+    let monitor = monitor.as_deref().unwrap_or(photocraft_cms::Builtin::Srgb.profile());
+    let hash = monitor.content_hash();
+    if maps.output.as_ref().is_none_or(|(key, _)| *key != hash) {
+        let mut lut = identity_lut();
+        let transform = photocraft_cms::transform::cached(photocraft_cms::Builtin::Srgb.profile(), monitor, Default::default()).map_err(|e| e.to_string())?;
+        let source = lut.rgba.as_flattened().to_vec();
+        transform.convert_f32(&source, 4, lut.rgba.as_flattened_mut(), 4, true);
+        maps.output = Some((hash, lut));
+    }
+    for (kind, channel) in MAPS.into_iter().enumerate() {
+        let bindings = app.session.uv.map_bindings(channel).to_vec();
+        maps.images[kind].resize_with(bindings.len(), || None);
+        maps.keys[kind].resize(bindings.len(), Key::default());
+        maps.regions[kind].resize(bindings.len(), None);
+        maps.regions[kind].fill(None);
+        maps.snapshots[kind].resize(bindings.len(), None);
+        for (material, id) in bindings.into_iter().enumerate() {
+            let Some(index) = id.and_then(|id| app.session.documents().iter().position(|s| s.doc.id == id)) else {
+                if let Some(v) = maps.images[kind].get_mut(material) {
+                    *v = None;
+                }
+                if let Some(v) = maps.keys[kind].get_mut(material) {
+                    *v = Key::default();
+                }
+                continue;
+            };
+            let revision = app.session.documents().get(index).map_or(0, |s| s.revision);
+            let (doc, live) = crate::canvas::display_doc(app, index);
+            let colored = matches!(channel, Channel::Color | Channel::Emissive);
+            // Profile assignment/conversion is a document revision. Avoid parsing an ICC
+            // profile for every unchanged slot, including numeric maps, on every refresh.
+            let key = (doc.id.0, revision, live, 0);
+            if maps.keys[kind].get(material) == Some(&key) {
+                continue;
+            }
+            let old = maps.keys[kind].get(material).copied().unwrap_or_default();
+            let damage = if old.0 == key.0
+                && maps.images[kind]
+                    .get(material)
+                    .and_then(Option::as_ref)
+                    .is_some_and(|im| im.width == doc.size.width as usize && im.height == doc.size.height as usize)
+            {
+                crate::canvas::damage_since(app, index, (old.1, old.2), (revision, live), 0, app.session.documents().get(index).and_then(|st| st.last_damage))
+            } else {
+                None
+            };
+            if maps.images[kind][material].is_none() {
+                maps.snapshots[kind][material] = None;
+            }
+            let regions = crate::uv_damage::regions(&mut maps.snapshots[kind][material], &doc, damage);
+            let mut hints = Vec::new();
+            for rect in regions {
+                let buffer = photocraft_compose::render_reduced_damage(&doc, doc.size.width, doc.size.height, rect);
+                let rect = buffer.rect;
+                let rgba = if colored {
+                    let profile = photocraft_engine::color_cmds::composite_profile(&doc);
+                    let transform = photocraft_cms::transform::cached(&profile, photocraft_cms::Builtin::LinearSrgb.profile(), Default::default())
+                        .map_err(|e| e.to_string())?;
+                    let mut dst = vec![[0.0; 4]; buffer.px.len()];
+                    transform.convert_f32(buffer.px.as_flattened(), 4, dst.as_flattened_mut(), 4, true);
+                    dst
+                } else {
+                    buffer.px
+                };
+                if let Some(v) = maps.images[kind].get_mut(material) {
+                    crate::uv_ui::patch_image(v, [doc.size.width, doc.size.height], rect, rgba)?;
+                }
+                hints.push(if rect.is_empty() { [0; 4] } else { [rect.x0 as u32, rect.y0 as u32, rect.width(), rect.height()] });
+            }
+            if old.0 == key.0
+                && let Some(hint) = maps.regions[kind].get_mut(material)
+            {
+                *hint = Some((old, hints));
+            }
+            if let Some(v) = maps.keys[kind].get_mut(material) {
+                *v = key;
+            }
+        }
+    }
+    Ok(())
+}
+pub(crate) fn identity_lut() -> Image {
+    Image {
+        width: 17 * 17,
+        height: 17,
+        rgba: (0..17 * 17 * 17).map(|i| [(i % 17) as f32 / 16.0, ((i / 17) % 17) as f32 / 16.0, (i / (17 * 17)) as f32 / 16.0, 1.0]).collect(),
+    }
+}
+
+#[cfg(not(target_arch = "wasm32"))]
+fn load(path: &str) -> Result<(String, Environment), String> {
+    use std::io::Read;
+    let file = std::fs::File::open(path).map_err(|e| e.to_string())?;
+    let mut bytes = Vec::new();
+    file.take(256 * 1024 * 1024 + 1).read_to_end(&mut bytes).map_err(|e| e.to_string())?;
+    if bytes.len() > 256 * 1024 * 1024 {
+        return Err(tl!("Environment map exceeds 256 MiB").into());
+    }
+    decode_environment(path, &bytes)
+}
+#[cfg(not(target_arch = "wasm32"))]
+fn decode_environment(path: &str, bytes: &[u8]) -> Result<(String, Environment), String> {
+    let format = photocraft_codecs::detect(bytes).ok_or(tl!("Unknown environment map format"))?;
+    if !matches!(format, photocraft_codecs::Format::Hdr | photocraft_codecs::Format::OpenExr) {
+        return Err(tl!("Choose a linear HDR or EXR panorama").into());
+    }
+    let opts = photocraft_codecs::DecodeOptions {
+        limits: photocraft_codecs::Limits { max_width: 16384, max_height: 8192, max_pixels: 33_554_432, max_alloc: 512 * 1024 * 1024 },
+        ..Default::default()
+    };
+    let decoded = photocraft_codecs::decode_with(bytes, &opts).map_err(|e| e.to_string())?;
+    let rgba = decoded.to_rgba_f32().as_chunks::<4>().0.iter().map(|p| p.map(|x| if x.is_finite() { x.clamp(0.0, 65504.0) } else { 0.0 })).collect();
+    let source = Image { width: decoded.width() as usize, height: decoded.height() as usize, rgba };
+    let env = Environment::prepare(&source).map_err(|e| e.to_string())?;
+    let name = std::path::Path::new(path).file_name().map_or_else(|| "HDR".into(), |s| s.to_string_lossy().into_owned());
+    Ok((name, env))
+}
+pub(crate) fn poll(cache: &mut Cache, ctx: &egui::Context) -> Option<String> {
+    #[cfg(not(target_arch = "wasm32"))]
+    if let Some(rx) = &cache.pending {
+        match rx.try_recv() {
+            Ok(result) => {
+                cache.pending = None;
+                match result {
+                    Ok((name, env)) => {
+                        cache.path = std::mem::take(&mut cache.pending_path);
+                        cache.name = name;
+                        cache.environment = Some(Arc::new(env));
+                        cache.preview = None;
+                    }
+                    Err(e) => return Some(e),
+                }
+            }
+            Err(std::sync::mpsc::TryRecvError::Empty) => ctx.request_repaint_after(std::time::Duration::from_millis(50)),
+            Err(std::sync::mpsc::TryRecvError::Disconnected) => {
+                cache.pending = None;
+                return Some(tl!("Environment preparation was interrupted").into());
+            }
+        }
+    }
+    let _ = (cache, ctx);
+    None
+}
+pub(crate) fn ensure(cache: &mut Cache) -> Arc<Environment> {
+    cache.environment.get_or_insert_with(|| Arc::new(Environment::studio())).clone()
+}
+pub(crate) fn select_environment(app: &mut PhotocraftApp, path: String) -> Result<serde_json::Value, String> {
+    if path.is_empty() {
+        let cache = &mut app.uv_cache.lighting;
+        cache.environment = None;
+        cache.preview = None;
+        cache.name.clear();
+        cache.path.clear();
+        cache.pending_path.clear();
+        #[cfg(not(target_arch = "wasm32"))]
+        {
+            cache.pending = None;
+        }
+        return Ok(serde_json::Value::Null);
+    }
+    if app.uv_cache.lighting.path == path && app.uv_cache.lighting.environment.is_some() {
+        return Ok(serde_json::Value::Null);
+    }
+    #[cfg(not(target_arch = "wasm32"))]
+    {
+        let (tx, rx) = std::sync::mpsc::sync_channel(1);
+        let source = path.clone();
+        let embedded = app
+            .session
+            .uv
+            .environment
+            .clone()
+            .filter(|_| app.session.uv.project_view.get("environment").and_then(serde_json::Value::as_str) == Some(path.as_str()));
+        std::thread::Builder::new()
+            .name("uv-environment".into())
+            .spawn(move || {
+                let _ = tx.send(if let Some(resource) = embedded { decode_environment(&resource.name, &resource.bytes) } else { load(&source) });
+            })
+            .map_err(|e| e.to_string())?;
+        app.uv_cache.lighting.pending_path = path;
+        app.uv_cache.lighting.pending = Some(rx);
+        Ok(serde_json::json!({"loading":true}))
+    }
+    #[cfg(target_arch = "wasm32")]
+    {
+        let _ = (app, path);
+        Err(tl!("Environment loading is available in the desktop build").into())
+    }
+}
+pub(crate) fn panel(app: &mut PhotocraftApp, state: &mut crate::uv_ui::State, ui: &mut egui::Ui) {
+    egui::CollapsingHeader::new(tl!("Environment / PBR")).default_open(true).show(ui, |ui| {
+        ui.spacing_mut().slider_width = (ui.available_width() - 195.0).clamp(60.0, 140.0);
+        let cache = &mut app.uv_cache.lighting;
+        if let Some(e) = poll(cache, ui.ctx()) {
+            state.status = e;
+        }
+        let env = ensure(cache);
+        let settings = &mut state.lighting;
+        ui.checkbox(&mut settings.pbr, "PBR · Roughness / Metallic");
+        if cache.preview.is_none()
+            && let Some(im) = env.specular.first()
+        {
+            let bytes: Vec<_> = im
+                .rgba
+                .iter()
+                .flat_map(|p| {
+                    let encode = |x: f32| (photocraft_color::convert::linear_to_srgb(x / (1.0 + x)) * 255.0).clamp(0.0, 255.0) as u8;
+                    [encode(p[0]), encode(p[1]), encode(p[2]), 255]
+                })
+                .collect();
+            cache.preview = Some(ui.ctx().load_texture(
+                "uv-environment-preview",
+                egui::ColorImage::from_rgba_unmultiplied([im.width, im.height], &bytes),
+                egui::TextureOptions::LINEAR,
+            ));
+        }
+        if let Some(preview) = &cache.preview {
+            ui.add(egui::Image::new(preview).fit_to_exact_size(egui::vec2(ui.available_width(), ui.available_width() * 0.5)));
+        }
+        ui.label(if cache.name.is_empty() { tl!("Studio environment") } else { &cache.name });
+        let mut choose = false;
+        ui.horizontal(|ui| {
+            choose = ui.button("HDR / EXR…").clicked();
+            if ui.button(tl!("Studio")).clicked() {
+                cache.environment = None;
+                cache.preview = None;
+                cache.name.clear();
+                cache.path.clear();
+                cache.pending_path.clear();
+                #[cfg(not(target_arch = "wasm32"))]
+                {
+                    cache.pending = None;
+                }
+            }
+        });
+        #[cfg(not(target_arch = "wasm32"))]
+        if cache.pending.is_some() {
+            ui.spinner();
+            ui.label(tl!("Preparing lighting…"));
+        }
+        ui.add(egui::Slider::new(&mut settings.brightness, 0.0..=8.0).text(tl!("Brightness")));
+        ui.add(egui::Slider::new(&mut settings.rotation, -180.0..=180.0).suffix("°").text(tl!("Rotation")));
+        ui.checkbox(&mut settings.background, tl!("Show environment background"));
+        if settings.background {
+            ui.add(egui::Slider::new(&mut settings.background_brightness, 0.0..=4.0).text(tl!("Background brightness")));
+        }
+        ui.add(egui::Slider::new(&mut settings.emissive, 0.0..=8.0).text(tl!("Emissive intensity")));
+        egui::CollapsingHeader::new(tl!("Material defaults")).show(ui, |ui| {
+            ui.add(egui::Slider::new(&mut settings.roughness, 0.045..=1.0).text("Roughness"));
+            ui.add(egui::Slider::new(&mut settings.metallic, 0.0..=1.0).text("Metallic"));
+        });
+        if choose {
+            use crate::file_dialog::{FileDialogAnswer, FileDialogRequest};
+            if let Err(e) = app.ask_file(
+                FileDialogRequest::Open { multiple: false, initial_dir: None, extensions: Some(vec!["hdr".into(), "exr".into()]) },
+                |app, answer| {
+                    let FileDialogAnswer::Paths(paths) = answer else { return Err(tl!("Choose a local HDR / EXR map").into()) };
+                    let path = paths.first().ok_or(tl!("No file selected"))?.clone();
+                    select_environment(app, path)
+                },
+            ) {
+                state.status = e;
+            }
+        }
+    });
+}
+
+pub(crate) fn pending(cache: &Cache) -> bool {
+    #[cfg(not(target_arch = "wasm32"))]
+    {
+        cache.pending.is_some()
+    }
+    #[cfg(target_arch = "wasm32")]
+    {
+        let _ = cache;
+        false
+    }
+}
+
+#[cfg(all(test, not(target_arch = "wasm32")))]
+mod tests {
+    use super::*;
+    #[test]
+    fn hdr_environment_loading_keeps_radiance_and_rejects_other_files() {
+        let image = photocraft_codecs::Image::from_f32(4, 2, photocraft_codecs::ChannelLayout::Rgb, &[4.0, 2.0, 0.5].repeat(8)).unwrap();
+        let bytes = photocraft_codecs::encode(&image, photocraft_codecs::Format::Hdr, &Default::default()).unwrap();
+        let path = std::env::temp_dir().join(format!("uv-environment-{}.hdr", std::process::id()));
+        std::fs::write(&path, bytes).unwrap();
+        let (_, env) = load(path.to_str().unwrap()).unwrap();
+        assert!((env.specular[0].rgba[0][0] - 4.0).abs() < 0.01);
+        std::fs::write(&path, b"invalid environment").unwrap();
+        assert!(load(path.to_str().unwrap()).is_err());
+        std::fs::remove_file(path).unwrap();
+    }
+}
diff --git a/crates/ui-egui/src/uv_mask.rs b/crates/ui-egui/src/uv_mask.rs
new file mode 100644
index 0000000000000000000000000000000000000000..337d88a9534e9cd750d56d67abcc8a8b113638c5
--- /dev/null
+++ b/crates/ui-egui/src/uv_mask.rs
@@ -0,0 +1,52 @@
+//! Native channel/mask display projected through each material UV, independent of source maps.
+use crate::PhotocraftApp;
+pub(crate) fn source(app: &PhotocraftApp, material: usize) -> Option<usize> {
+    let index = app.session.active_index()?;
+    let st = app.session.documents().get(index)?;
+    if st.channel_view.is_plain(&st.doc) {
+        return None;
+    }
+    photocraft_uv::preview::Channel::MAPS.iter().any(|kind| app.session.uv.map_bindings(*kind).get(material) == Some(&Some(st.doc.id))).then_some(index)
+}
+pub(crate) fn key(app: &PhotocraftApp, index: usize) -> u64 {
+    use std::hash::{Hash, Hasher};
+    let mut h = std::collections::hash_map::DefaultHasher::new();
+    if let Some(st) = app.session.documents().get(index) {
+        serde_json::to_string(&st.channel_view).unwrap_or_default().hash(&mut h);
+        st.active_layer.hash(&mut h);
+    }
+    let look = crate::channel_view::Look::of(&app.session);
+    look.in_color.hash(&mut h);
+    look.mask_rgb.map(f32::to_bits).hash(&mut h);
+    look.mask_opacity.to_bits().hash(&mut h);
+    h.finish()
+}
+pub(crate) fn overlay(app: &PhotocraftApp, index: usize, doc: &photocraft_doc::Document, rect: photocraft_geom::Rect, pixels: &mut [[f32; 4]], factor: u32) {
+    let Some(st) = app.session.documents().get(index) else {
+        return;
+    };
+    if let Some(px) = crate::channel_view::render(doc, &st.channel_view, rect, factor, crate::channel_view::Look::of(&app.session), st.active_layer) {
+        for (out, p) in pixels.iter_mut().zip(px) {
+            let rgba = p.to_array().map(|v| v as f32 / 255.0);
+            for i in 0..3 {
+                out[i] = rgba[i] + out[i] * (1.0 - rgba[3]);
+            }
+            out[3] = 1.0;
+        }
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    #[test]
+    fn uv_mask_cache_follows_native_overlay_display_options() {
+        let mut app = PhotocraftApp::new(photocraft_engine::Session::new(), Default::default());
+        let first = key(&app, 0);
+        app.session.prefs.edit(|p| p.layer_mask_overlay.color = "#00ff00".into());
+        let green = key(&app, 0);
+        assert_ne!(first, green);
+        app.session.prefs.edit(|p| p.layer_mask_overlay.opacity = 75.0);
+        assert_ne!(green, key(&app, 0));
+    }
+}
diff --git a/crates/ui-egui/src/uv_mips.rs b/crates/ui-egui/src/uv_mips.rs
new file mode 100644
index 0000000000000000000000000000000000000000..967c32896f71e899aaf8b9d0b3ba046fbcf7a4f8
--- /dev/null
+++ b/crates/ui-egui/src/uv_mips.rs
@@ -0,0 +1,131 @@
+//! GPU mip generation for full-resolution model maps, restricted to changed texels.
+use eframe::{egui_wgpu::RenderState, wgpu};
+pub(crate) struct Mips {
+    layout: wgpu::BindGroupLayout,
+    sampler: wgpu::Sampler,
+    color: wgpu::RenderPipeline,
+    data: wgpu::RenderPipeline,
+    separate: bool,
+}
+impl Mips {
+    pub fn new(rs: &RenderState) -> Self {
+        let device = &rs.device;
+        let layout = device.create_bind_group_layout(&wgpu::BindGroupLayoutDescriptor {
+            label: Some("uv mip"),
+            entries: &[
+                wgpu::BindGroupLayoutEntry {
+                    binding: 0,
+                    visibility: wgpu::ShaderStages::FRAGMENT,
+                    ty: wgpu::BindingType::Texture {
+                        sample_type: wgpu::TextureSampleType::Float { filterable: true },
+                        view_dimension: wgpu::TextureViewDimension::D2,
+                        multisampled: false,
+                    },
+                    count: None,
+                },
+                wgpu::BindGroupLayoutEntry {
+                    binding: 1,
+                    visibility: wgpu::ShaderStages::FRAGMENT,
+                    ty: wgpu::BindingType::Sampler(wgpu::SamplerBindingType::Filtering),
+                    count: None,
+                },
+            ],
+        });
+        let pipeline_layout =
+            device.create_pipeline_layout(&wgpu::PipelineLayoutDescriptor { label: Some("uv mip"), bind_group_layouts: &[Some(&layout)], immediate_size: 0 });
+        let module = device
+            .create_shader_module(wgpu::ShaderModuleDescriptor { label: Some("uv mip"), source: wgpu::ShaderSource::Wgsl(crate::gpu_canvas::MIP_WGSL.into()) });
+        let pipeline = |format| {
+            device.create_render_pipeline(&wgpu::RenderPipelineDescriptor {
+                label: Some("uv mip"),
+                layout: Some(&pipeline_layout),
+                vertex: wgpu::VertexState { module: &module, entry_point: Some("vs"), buffers: &[], compilation_options: Default::default() },
+                primitive: Default::default(),
+                depth_stencil: None,
+                multisample: Default::default(),
+                fragment: Some(wgpu::FragmentState {
+                    module: &module,
+                    entry_point: Some("fs"),
+                    targets: &[Some(wgpu::ColorTargetState { format, blend: None, write_mask: wgpu::ColorWrites::ALL })],
+                    compilation_options: Default::default(),
+                }),
+                multiview_mask: None,
+                cache: None,
+            })
+        };
+        let color = pipeline(wgpu::TextureFormat::Rgba8Unorm);
+        let data = pipeline(wgpu::TextureFormat::Rgba16Float);
+        let sampler = device.create_sampler(&wgpu::SamplerDescriptor {
+            min_filter: wgpu::FilterMode::Linear,
+            mag_filter: wgpu::FilterMode::Linear,
+            ..Default::default()
+        });
+        let info = rs.adapter.get_info();
+        let separate = crate::gpu_canvas::separate_mip_targets(info.backend, info.vendor, std::env::var("PHOTOCRAFT_SEPARATE_MIPS").ok().as_deref());
+        Self { layout, sampler, color, data, separate }
+    }
+    pub fn regenerate(&self, rs: &RenderState, texture: &wgpu::Texture, size: [u32; 2], levels: &[wgpu::TextureView], region: [u32; 4]) {
+        if levels.len() < 2 {
+            return;
+        }
+        let mut encoder = rs.device.create_command_encoder(&wgpu::CommandEncoderDescriptor { label: Some("uv mip update") });
+        let [mut x, mut y, w, h] = region;
+        let (mut x1, mut y1) = (x.saturating_add(w), y.saturating_add(h));
+        for level in 1..levels.len() {
+            let Some(previous) = levels.get(level - 1) else { continue };
+            let Some(target) = levels.get(level) else { continue };
+            let width = (size[0] >> level).max(1);
+            let height = (size[1] >> level).max(1);
+            x = (x / 2).saturating_sub(1).min(width - 1);
+            y = (y / 2).saturating_sub(1).min(height - 1);
+            x1 = x1.div_ceil(2).saturating_add(1).min(width);
+            y1 = y1.div_ceil(2).saturating_add(1).min(height);
+            let group = rs.device.create_bind_group(&wgpu::BindGroupDescriptor {
+                label: Some("uv mip"),
+                layout: &self.layout,
+                entries: &[
+                    wgpu::BindGroupEntry { binding: 0, resource: wgpu::BindingResource::TextureView(previous) },
+                    wgpu::BindGroupEntry { binding: 1, resource: wgpu::BindingResource::Sampler(&self.sampler) },
+                ],
+            });
+            let scratch = self.separate.then(|| {
+                rs.device.create_texture(&wgpu::TextureDescriptor {
+                    label: Some("uv mip scratch"),
+                    size: wgpu::Extent3d { width, height, depth_or_array_layers: 1 },
+                    mip_level_count: 1,
+                    sample_count: 1,
+                    dimension: wgpu::TextureDimension::D2,
+                    format: texture.format(),
+                    usage: wgpu::TextureUsages::RENDER_ATTACHMENT | wgpu::TextureUsages::COPY_SRC,
+                    view_formats: &[],
+                })
+            });
+            let scratch_view = scratch.as_ref().map(|t| t.create_view(&Default::default()));
+            {
+                let mut pass = encoder.begin_render_pass(&wgpu::RenderPassDescriptor {
+                    label: Some("uv mip"),
+                    color_attachments: &[Some(wgpu::RenderPassColorAttachment {
+                        view: scratch_view.as_ref().unwrap_or(target),
+                        resolve_target: None,
+                        depth_slice: None,
+                        ops: wgpu::Operations { load: wgpu::LoadOp::Load, store: wgpu::StoreOp::Store },
+                    })],
+                    ..Default::default()
+                });
+                pass.set_pipeline(if texture.format() == wgpu::TextureFormat::Rgba16Float { &self.data } else { &self.color });
+                pass.set_bind_group(0, &group, &[]);
+                pass.set_scissor_rect(x, y, (x1 - x).max(1), (y1 - y).max(1));
+                pass.draw(0..3, 0..1);
+            }
+            if let Some(scratch) = &scratch {
+                let origin = wgpu::Origin3d { x, y, z: 0 };
+                encoder.copy_texture_to_texture(
+                    wgpu::TexelCopyTextureInfo { texture: scratch, mip_level: 0, origin, aspect: wgpu::TextureAspect::All },
+                    wgpu::TexelCopyTextureInfo { texture, mip_level: level as u32, origin, aspect: wgpu::TextureAspect::All },
+                    wgpu::Extent3d { width: x1 - x, height: y1 - y, depth_or_array_layers: 1 },
+                );
+            }
+        }
+        rs.queue.submit([encoder.finish()]);
+    }
+}
diff --git a/crates/ui-egui/src/uv_paint.rs b/crates/ui-egui/src/uv_paint.rs
new file mode 100644
index 0000000000000000000000000000000000000000..dac007b8613da9b00d6919a86d6bbe6a2cbc8240
--- /dev/null
+++ b/crates/ui-egui/src/uv_paint.rs
@@ -0,0 +1,603 @@
+//! Visible-surface picking maps native brush events into the bound texture document.
+use crate::{
+    PhotocraftApp,
+    canvas::{self, ToolEvent},
+    state::Tool,
+};
+use egui::{Modifiers, Pos2, Response};
+use photocraft_uv::{
+    Scene,
+    prepared::Geometry,
+    preview::{Camera, Materials},
+};
+use serde_json::json;
+
+#[derive(Clone, Copy)]
+struct Sample {
+    triangle: usize,
+    shell: u32,
+    point: [f64; 2],
+}
+#[derive(Default)]
+pub(crate) struct State {
+    held: bool,
+    wrapped: bool,
+    material: Option<usize>,
+    doc: Option<photocraft_doc::DocId>,
+    tool: Option<Tool>,
+    last: Option<Sample>,
+    screen: Option<Pos2>,
+}
+pub(crate) fn pending(state: &State) -> bool {
+    state.doc.is_some() && state.last.is_some()
+}
+fn mods() -> Modifiers {
+    Modifiers::NONE
+}
+fn end_segment(app: &mut PhotocraftApp, state: &mut State) {
+    if let Some(last) = state.last.take()
+        && app.drag.is_some()
+    {
+        if app.session.active().is_none_or(|st| Some(st.doc.id) != state.doc) {
+            app.drag = None;
+            app.live_stroke = None;
+            app.session.clear_live_stroke();
+            return;
+        }
+        let deferred = std::mem::replace(&mut app.defer_live_stroke, false);
+        canvas::feed_live_stroke(app);
+        app.defer_live_stroke = deferred;
+        canvas::tool_event(app, ToolEvent::Up { x: last.point[0], y: last.point[1] }, mods());
+    }
+}
+pub(crate) fn finish(app: &mut PhotocraftApp, state: &mut State) {
+    end_segment(app, state);
+    if state.wrapped {
+        let _ = app.run("paint.uvWrap", json!({"end":true}));
+    }
+    *state = State::default();
+    app.uv_paint_key = None;
+}
+fn adjacent(scene: &Scene, a: usize, b: usize) -> bool {
+    if a == b {
+        return true;
+    }
+    let (Some(a), Some(b)) = (scene.triangles.get(a), scene.triangles.get(b)) else { return false };
+    a.corners.iter().filter(|a| b.corners.iter().any(|b| a.vertex == b.vertex && a.uv.iter().zip(b.uv).all(|(a, b)| (a - b).abs() < 1e-6))).count() >= 2
+}
+struct View<'a> {
+    wrap: bool,
+    geometry: &'a Geometry,
+    scene: &'a Scene,
+    camera: Camera,
+    maps: &'a Materials<'a>,
+    size: [u32; 2],
+    rect: egui::Rect,
+}
+fn sample(app: &mut PhotocraftApp, state: &mut State, view: &View<'_>, p: Pos2, source: bool) {
+    let at = (p - view.rect.min) / view.rect.size();
+    let hit = view.rect.contains(p).then(|| view.geometry.hit(view.scene, view.camera, view.maps, [f64::from(at.x), f64::from(at.y)], view.size)).flatten();
+    let Some(hit) = hit else {
+        end_segment(app, state);
+        return;
+    };
+    let Some(triangle) = view.geometry.triangles.get(hit.triangle) else { return };
+    if hit.uv.iter().any(|v| !(0.0..=1.0).contains(v)) {
+        end_segment(app, state);
+        return;
+    }
+    let material = triangle.material;
+    // One physical gesture targets one material/document, so it has one predictable Undo.
+    if state.material.is_some_and(|m| m != material) {
+        end_segment(app, state);
+        return;
+    }
+    let bindings = app.session.uv.map_bindings(app.session.uv.current_channel());
+    let Some(id) = bindings.get(material).copied().flatten() else {
+        app.ui.status = tl!("Assign a texture to this material before painting").into();
+        end_segment(app, state);
+        return;
+    };
+    if state.material.is_none() {
+        let changed = app.session.active().is_none_or(|st| st.doc.id != id);
+        if app.run("uv.material.select", json!({"material":material})).is_err() {
+            return;
+        }
+        if changed {
+            use photocraft_engine::channel_cmds::ChannelTarget;
+            app.ui.mask_target = app.session.active().is_some_and(|st| st.channel_view.target == ChannelTarget::LayerMask);
+            app.ui.vector_mask_target = app.session.active().is_some_and(|st| st.channel_view.target == ChannelTarget::VectorMask);
+            app.sync_mask_targets();
+        }
+        state.material = Some(material);
+        state.doc = Some(id);
+    }
+    if app.session.active().is_none_or(|st| Some(st.doc.id) != state.doc) {
+        finish(app, state);
+        return;
+    }
+    let Some(st) = app.session.active() else { return };
+    let point = [
+        (hit.uv[0] * f64::from(st.doc.size.width)).min(f64::from(st.doc.size.width) - 1e-6),
+        ((1.0 - hit.uv[1]) * f64::from(st.doc.size.height)).min(f64::from(st.doc.size.height) - 1e-6),
+    ];
+    if view.wrap && matches!(app.active_tool(), Tool::Brush | Tool::Pencil | Tool::Eraser) && !source {
+        end_segment(app, state);
+        let tool = app.active_tool();
+        let target = canvas::paint_target(app);
+        let result = app.run("paint.uvWrap", json!({"triangle":hit.triangle,"position":hit.position,"pressure":app.stylus.pressure(),"erase":tool == Tool::Eraser,"pencil":tool == Tool::Pencil || crate::eraser_ui::pencil_mode(app, tool),"target":target}));
+        if let Err(error) = result {
+            app.ui.status = error;
+            app.ui.status_error = true;
+        }
+        state.wrapped = true;
+        return;
+    }
+    if state.last.is_some_and(|last| {
+        last.shell != triangle.shell
+            || (!adjacent(view.scene, last.triangle, hit.triangle)
+                && (last.point[0] - point[0]).hypot(last.point[1] - point[1]) > f64::from(st.doc.size.width.max(st.doc.size.height)) * 0.02)
+    }) {
+        end_segment(app, state);
+    }
+    let pressure = app.stylus.pressure();
+    if source {
+        crate::retouch_ui::set_source(app, point[0], point[1]);
+        return;
+    }
+    let event = if state.last.is_some() && app.drag.is_some() {
+        ToolEvent::Move { x: point[0], y: point[1], pressure }
+    } else {
+        ToolEvent::Down { x: point[0], y: point[1], pressure }
+    };
+    canvas::tool_event(app, event, mods());
+    state.last = app.drag.is_some().then_some(Sample { triangle: hit.triangle, shell: triangle.shell, point });
+}
+/// Ctrl+RMB owns its drag until release, including after Ctrl is released.
+pub(crate) fn resize_brush(app: &mut PhotocraftApp, ui: &egui::Ui, response: &Response, enabled: bool) -> bool {
+    let mut handled = app.brush_resize.is_some_and(|r| r.screen);
+    if !enabled
+        || app.ui.brush_picker.is_some()
+        || !crate::brush_resize::applies(app.active_tool())
+        || !ui.input(|i| i.focused)
+        || !crate::menus::modal_allows(app, "paint.stroke")
+        || app.ui.transform.is_some()
+    {
+        if handled {
+            app.brush_resize = None;
+        }
+        return handled;
+    }
+    crate::paint_mouse::sync_tool_brush(app);
+    for event in ui.input(|i| i.events.clone()) {
+        let active = app.brush_resize.is_some_and(|r| r.screen);
+        match event {
+            egui::Event::PointerButton { pos, button: egui::PointerButton::Secondary, pressed: true, modifiers }
+                if modifiers.ctrl
+                    && !modifiers.alt
+                    && response.rect.contains(pos)
+                    && ui.ctx().layer_id_at(pos).is_none_or(|layer| layer == ui.layer_id())
+                    && app.drag.is_none() =>
+            {
+                handled |=
+                    crate::brush_resize::pointer_screen(app, ToolEvent::Down { x: f64::from(pos.x), y: f64::from(pos.y), pressure: 1.0 }, modifiers, true);
+            }
+            egui::Event::PointerMoved(pos) if active => {
+                crate::brush_resize::pointer_screen(app, ToolEvent::Move { x: f64::from(pos.x), y: f64::from(pos.y), pressure: 1.0 }, Modifiers::NONE, false);
+                handled = true;
+            }
+            egui::Event::PointerButton { pos, button: egui::PointerButton::Secondary, pressed: false, .. } if active => {
+                crate::brush_resize::pointer_screen(app, ToolEvent::Up { x: f64::from(pos.x), y: f64::from(pos.y) }, Modifiers::NONE, false);
+                handled = true;
+            }
+            egui::Event::PointerGone if active => {
+                app.brush_resize = None;
+                handled = true;
+            }
+            _ => {}
+        }
+    }
+    if app.brush_resize.is_some_and(|r| r.screen) && !ui.input(|i| i.pointer.secondary_down()) {
+        app.brush_resize = None;
+    }
+    handled
+}
+#[allow(clippy::too_many_arguments)]
+pub(crate) fn input(
+    app: &mut PhotocraftApp,
+    ui: &egui::Ui,
+    response: &Response,
+    state: &mut State,
+    geometry: &Geometry,
+    scene: &Scene,
+    camera: Camera,
+    maps: &Materials<'_>,
+    size: [u32; 2],
+    enabled: bool,
+    wrap: bool,
+) {
+    app.stylus.use_pressure = app.session.prefs().tools.use_tablet_pressure;
+    app.stylus.set_pressure_curve(&app.session.prefs().tools.pressure_curve.clone());
+    app.stylus.update_for_frame(ui.ctx().cumulative_frame_nr(), &ui.input(|i| i.events.clone()));
+    crate::stylus::Stylus::sync_eraser_tool(app);
+    let tool = if ui.input(|i| i.modifiers.ctrl) && matches!(app.ui.tool, Tool::CloneStamp | Tool::Healing) { app.ui.tool } else { app.active_tool() };
+    if app.brush_resize.is_some_and(|r| r.screen) {
+        finish(app, state);
+        let view = View { wrap, geometry, scene, camera, maps, size, rect: response.rect };
+        cursor(app, ui, &view);
+        if let Some(at) = ui.input(|i| i.pointer.latest_pos()) {
+            canvas::draw_readout(ui.ctx(), "uv-brush-size", at, [tl!("Size:")], [format!("{} px", app.session.tools.brush.size.round())]);
+        }
+        return;
+    }
+    if !enabled
+        || app.ui.brush_picker.is_some()
+        || !crate::menus::modal_allows(app, "paint.stroke")
+        || app.ui.transform.is_some()
+        || (!canvas::strokes_live(tool) && tool != Tool::Eyedropper)
+        || state.tool.is_some_and(|old| old != tool)
+        || ui.input(|i| i.key_pressed(egui::Key::Escape) || !i.focused)
+    {
+        finish(app, state);
+        return;
+    }
+    let view = View { wrap, geometry, scene, camera, maps, size, rect: response.rect };
+    crate::paint_mouse::sync_tool_brush(app);
+    let events = ui.input(|i| i.events.clone());
+    let deferred = app.defer_live_stroke;
+    app.defer_live_stroke = true;
+    for event in events {
+        match event {
+            egui::Event::PointerButton { pos, button: egui::PointerButton::Primary, pressed: true, modifiers }
+                if !modifiers.alt && response.contains_pointer() =>
+            {
+                finish(app, state);
+                static GESTURES: std::sync::atomic::AtomicU64 = std::sync::atomic::AtomicU64::new(0);
+                app.uv_paint_key = Some(format!("uv3d-{}", GESTURES.fetch_add(1, std::sync::atomic::Ordering::Relaxed)));
+                state.held = true;
+                state.tool = Some(tool);
+                state.screen = Some(pos);
+                let source = modifiers.ctrl && matches!(tool, Tool::CloneStamp | Tool::Healing);
+                sample(app, state, &view, pos, source);
+                if source {
+                    finish(app, state);
+                }
+            }
+            egui::Event::PointerMoved(pos) if state.held => {
+                let previous = state.screen.replace(pos).unwrap_or(pos);
+                let steps = ((pos - previous).length() / 1.5).ceil().clamp(1.0, 128.0) as usize;
+                for i in 1..=steps {
+                    sample(app, state, &view, previous.lerp(pos, i as f32 / steps as f32), false);
+                }
+            }
+            egui::Event::PointerButton { button: egui::PointerButton::Primary, pressed: false, .. } => finish(app, state),
+            egui::Event::PointerGone => finish(app, state),
+            _ => {}
+        }
+    }
+    if state.held && !ui.input(|i| i.pointer.primary_down()) {
+        finish(app, state);
+    }
+    if state.held
+        && !state.wrapped
+        && let Some(last) = state.last
+    {
+        canvas::tool_event(app, ToolEvent::Move { x: last.point[0], y: last.point[1], pressure: app.stylus.pressure() }, mods());
+    }
+    app.defer_live_stroke = deferred;
+    if !deferred {
+        canvas::feed_live_stroke(app);
+    }
+    if response.hovered() {
+        ui.ctx().set_cursor_icon(egui::CursorIcon::Crosshair);
+        if tool != Tool::Eyedropper {
+            cursor(app, ui, &view);
+            if tool == Tool::CloneStamp {
+                crate::uv_clone::preview(app, ui, geometry, scene, camera, maps, size, response.rect);
+            }
+        }
+    }
+    if state.held {
+        ui.ctx().request_repaint_after(std::time::Duration::from_millis(16));
+    }
+}
+
+fn cursor(app: &PhotocraftApp, ui: &egui::Ui, view: &View<'_>) {
+    let Some(p) =
+        app.brush_resize.filter(|r| r.screen).map(|r| egui::pos2(r.anchor[0] as f32, r.anchor[1] as f32)).or_else(|| ui.input(|i| i.pointer.hover_pos()))
+    else {
+        return;
+    };
+    let at = (p - view.rect.min) / view.rect.size();
+    let Some(hit) = view.geometry.hit(view.scene, view.camera, view.maps, [f64::from(at.x), f64::from(at.y)], view.size) else { return };
+    let Some(t) = view.geometry.triangles.get(hit.triangle) else { return };
+    let bindings = app.session.uv.map_bindings(app.session.uv.current_channel());
+    let Some(st) = bindings.get(t.material).copied().flatten().and_then(|id| app.session.documents().iter().find(|st| st.doc.id == id)) else { return };
+    let tex = t.uv.map(|uv| [f64::from(uv[0]) * f64::from(st.doc.size.width), -f64::from(uv[1]) * f64::from(st.doc.size.height)]);
+    let [u, v] = [0, 1].map(|axis| [tex[1][axis] - tex[0][axis], tex[2][axis] - tex[0][axis]]);
+    let det = u[0] * v[1] - u[1] * v[0];
+    if det.abs() < 1e-12 {
+        return;
+    }
+    if view.wrap && matches!(app.active_tool(), Tool::Brush | Tool::Pencil | Tool::Eraser) {
+        let sub = |a: [f64; 3], b: [f64; 3]| std::array::from_fn::<_, 3, _>(|i| a[i] - b[i]);
+        let cross = |a: [f64; 3], b: [f64; 3]| [a[1] * b[2] - a[2] * b[1], a[2] * b[0] - a[0] * b[2], a[0] * b[1] - a[1] * b[0]];
+        let norm = |a: [f64; 3]| {
+            let n = a.iter().map(|v| v * v).sum::<f64>().sqrt().max(1e-20);
+            a.map(|v| v / n)
+        };
+        let positions = t.positions.map(|p| p.map(f64::from));
+        let area = cross(sub(positions[1], positions[0]), sub(positions[2], positions[0])).iter().map(|v| v * v).sum::<f64>().sqrt();
+        let scale = app.session.uv.wrap_pixels_per_unit().map(|unit| unit * view.geometry.diameter).unwrap_or_else(|| (det.abs() / area.max(1e-24)).sqrt());
+        let radius = f64::from(app.session.tools.brush.size) * 0.5 / scale.max(1e-20);
+        let u = norm(t.tangent.map(f64::from));
+        let v = cross(t.face.map(f64::from), u).map(|v| v * det.signum());
+        let center = std::array::from_fn::<_, 3, _>(|i| (hit.position[i] - view.geometry.center[i]) / view.geometry.diameter);
+        let points: Option<Vec<_>> = (0..48)
+            .map(|i| {
+                let angle = f64::from(i) * std::f64::consts::TAU / 48.0;
+                let p = std::array::from_fn(|j| center[j] + radius * (u[j] * angle.cos() + v[j] * angle.sin()));
+                let q = view.geometry.project_normalized(view.camera, p, view.size)?;
+                Some(view.rect.min + egui::vec2(q[0] as f32 * view.rect.width(), q[1] as f32 * view.rect.height()))
+            })
+            .collect();
+        if let Some(points) = points {
+            paint_cursor_ring(ui, view, p, points);
+        }
+        return;
+    }
+    let screen = t.positions.map(|p| view.geometry.project_normalized(view.camera, p.map(f64::from), view.size));
+    let [Some(a), Some(b), Some(c)] = screen else {
+        return;
+    };
+    let screen = [a, b, c].map(|p| [p[0] * f64::from(view.rect.width()), p[1] * f64::from(view.rect.height())]);
+    let radius = f64::from(app.session.tools.brush.size) * 0.5;
+    let points: Vec<_> = (0..48)
+        .map(|i| {
+            let a = f64::from(i) * std::f64::consts::TAU / 48.0;
+            let (x, y) = (a.cos() * radius, a.sin() * radius);
+            let (a, b) = ((x * v[1] - y * u[1]) / det, (y * u[0] - x * v[0]) / det);
+            p + egui::vec2(
+                (a * (screen[1][0] - screen[0][0]) + b * (screen[2][0] - screen[0][0])) as f32,
+                (a * (screen[1][1] - screen[0][1]) + b * (screen[2][1] - screen[0][1])) as f32,
+            )
+        })
+        .collect();
+    paint_cursor_ring(ui, view, p, points);
+}
+fn paint_cursor_ring(ui: &egui::Ui, view: &View<'_>, p: Pos2, points: Vec<Pos2>) {
+    if points.iter().any(|q| !q.is_finite() || q.distance(p) > 2048.0) {
+        return;
+    }
+    let painter = ui.painter().with_clip_rect(view.rect);
+    painter.add(egui::Shape::closed_line(points.clone(), egui::Stroke::new(2.5, egui::Color32::BLACK)));
+    painter.add(egui::Shape::closed_line(points, egui::Stroke::new(1.0, egui::Color32::WHITE)));
+}
