+pub(crate) fn input(ui: &egui::Ui, response: &egui::Response, drag: &mut Option<Drag>) -> Option<(Rect, egui::Modifiers)> {
+    if ui.input(|i| i.key_pressed(egui::Key::Escape) || !i.focused) {
+        *drag = None;
+        return None;
+    }
+    if response.contains_pointer()
+        && ui.input(|i| i.pointer.primary_pressed() && !i.modifiers.alt)
+        && let Some(start) = ui.input(|i| i.pointer.interact_pos())
+    {
+        *drag = Some(Drag { start, modifiers: ui.input(|i| i.modifiers) });
+    }
+    let d = (*drag)?;
+    let end = ui.input(|i| i.pointer.interact_pos()).unwrap_or(d.start);
+    let rect = Rect::from_two_pos(d.start, end);
+    if rect.size().length() > 4.0 {
+        let t = Tokens::get(ui.ctx());
+        ui.painter_at(response.rect).rect(rect, 0, t.accent.gamma_multiply(0.12), egui::Stroke::new(1.0, t.accent), egui::StrokeKind::Inside);
+    }
+    if ui.input(|i| i.pointer.primary_released()) {
+        *drag = None;
+        return (rect.size().length() > 4.0).then_some((rect, d.modifiers));
+    }
+    if !ui.input(|i| i.pointer.primary_down()) {
+        *drag = None;
+    }
+    None
+}
+
+fn triangle_touches(rect: Rect, tri: [Pos2; 3]) -> bool {
+    if tri.iter().any(|p| rect.contains(*p)) {
+        return true;
+    }
+    if !Rect::from_points(&tri).intersects(rect) {
+        return false;
+    }
+    // Clip against the rectangle: includes edges crossing it and a rectangle inside a triangle.
+    let mut poly = tri.to_vec();
+    for (axis, edge, sign) in [(0, rect.left(), -1.0), (0, rect.right(), 1.0), (1, rect.top(), -1.0), (1, rect.bottom(), 1.0)] {
+        let mut out = Vec::new();
+        for (a, b) in poly.iter().zip(poly.iter().cycle().skip(1)).take(poly.len()) {
+            let value = |p: Pos2| ((if axis == 0 { p.x } else { p.y }) - edge) * sign;
+            let (va, vb) = (value(*a), value(*b));
+            if va <= 0.0 {
+                out.push(*a);
+            }
+            if (va <= 0.0) != (vb <= 0.0) {
+                out.push(a.lerp(*b, va / (va - vb)));
+            }
+        }
+        poly = out;
+    }
+    !poly.is_empty()
+}
+pub(crate) fn select(
+    app: &mut PhotocraftApp,
+    state: &mut crate::uv_ui::State,
+    rect: Rect,
+    modifiers: egui::Modifiers,
+    material: usize,
+    project: impl Fn(usize) -> Option<[Pos2; 3]>,
+) {
+    let Some(topology) = app.session.uv.topology.clone() else { return };
+    let shells: Vec<_> = topology
+        .shells
+        .iter()
+        .enumerate()
+        .filter(|(_, sh)| sh.material == material)
+        .filter_map(|(id, sh)| {
+            let selected = if state.shell_enclosed {
+                sh.triangles.iter().all(|id| project(*id).is_some_and(|tri| tri.iter().all(|p| rect.contains(*p))))
+            } else {
+                sh.triangles.iter().any(|id| project(*id).is_some_and(|tri| triangle_touches(rect, tri)))
+            };
+            selected.then_some(id)
+        })
+        .collect();
+    let mode = if modifiers.ctrl || modifiers.alt {
+        "subtract"
+    } else if modifiers.shift {
+        "add"
+    } else {
+        "replace"
+    };
+    match app.run("uv.shell.select", serde_json::json!({"material":material,"shells":shells,"mode":mode})) {
+        Ok(_) => {
+            if let Err(e) = app.run("uv.mask.apply", serde_json::json!({"guard":state.guard,"horizontal":state.horizontal,"vertical":state.vertical,"feather":state.feather,"openBorders":state.open_borders})) {
+                state.status = e;
+            }
+        }
+        Err(e) => state.status = e,
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn rectangle_selects_touched_or_enclosed_shells_and_supports_subtraction() {
+        let mut app = PhotocraftApp::new(photocraft_engine::Session::new(), Default::default());
+        let path = std::path::Path::new(env!("CARGO_MANIFEST_DIR")).join("../uv/tests/fixtures/two-shells.obj");
+        app.run("uv.model.import", serde_json::json!({"path":path})).unwrap();
+        let topology = app.session.uv.topology.clone().unwrap();
+        let material = app.session.uv.material;
+        let project = |id| {
+            if topology.triangle_shell[id] == 0 {
+                Some([egui::pos2(-2.0, 2.0), egui::pos2(2.0, 2.0), egui::pos2(2.0, 8.0)])
+            } else {
+                Some([egui::pos2(4.0, 4.0), egui::pos2(6.0, 4.0), egui::pos2(6.0, 8.0)])
+            }
+        };
+        let rect = Rect::from_min_max(Pos2::ZERO, egui::pos2(10.0, 10.0));
+        let mut state = crate::uv_ui::State::default();
+        select(&mut app, &mut state, rect, egui::Modifiers::NONE, material, project);
+        assert_eq!(app.session.uv.selected.len(), 2);
+        state.shell_enclosed = true;
+        select(&mut app, &mut state, rect, egui::Modifiers::NONE, material, project);
+        assert_eq!(app.session.uv.selected, std::collections::BTreeSet::from([1]));
+        select(&mut app, &mut state, rect, egui::Modifiers { ctrl: true, ..Default::default() }, material, project);
+        assert!(app.session.uv.selected.is_empty());
+    }
+    #[test]
+    fn touches_includes_crossing_edges_and_rect_inside_but_rejects_bounding_box_false_positive() {
+        let tri = [egui::pos2(0.0, 0.0), egui::pos2(100.0, 0.0), egui::pos2(0.0, 100.0)];
+        let r = |a, b, c, d| Rect::from_min_max(egui::pos2(a, b), egui::pos2(c, d));
+        assert!(triangle_touches(r(10.0, 10.0, 20.0, 20.0), tri));
+        assert!(triangle_touches(r(40.0, -1.0, 60.0, 1.0), tri));
+        assert!(!triangle_touches(r(80.0, 80.0, 90.0, 90.0), tri));
+    }
+}
diff --git a/crates/ui-egui/src/uv_clone.rs b/crates/ui-egui/src/uv_clone.rs
new file mode 100644
index 0000000000000000000000000000000000000000..8a63224fd5e2cbf12dd1e9ed9ae8101bfd7f3490
--- /dev/null
+++ b/crates/ui-egui/src/uv_clone.rs
@@ -0,0 +1,105 @@
+//! Project the native Clone Source overlay onto visible UV triangles, without GPU readback.
+use crate::PhotocraftApp;
+use egui::{Pos2, Rect};
+use photocraft_uv::{
+    Scene,
+    prepared::Geometry,
+    preview::{Camera, Materials},
+};
+
+// Clipping is in screen f32 coordinates. Its boundary vertices can land a few
+// ulps outside the original f64 triangle: evaluate its affine map without an
+// inside-triangle rejection, or neighboring preview triangles acquire holes.
+fn weights(p: [f64; 2], t: [[f64; 2]; 3]) -> Option<[f64; 3]> {
+    let [a, b, c] = t;
+    let cross = |a: [f64; 2], b: [f64; 2]| a[0] * b[1] - a[1] * b[0];
+    let e = [b[0] - a[0], b[1] - a[1]];
+    let f = [c[0] - a[0], c[1] - a[1]];
+    let q = [p[0] - a[0], p[1] - a[1]];
+    let area = cross(e, f);
+    if !area.is_finite() || area.abs() < 1e-15 {
+        return None;
+    }
+    let (v, w) = (cross(q, f) / area, cross(e, q) / area);
+    Some([1.0 - v - w, v, w])
+}
+
+#[allow(clippy::too_many_arguments)]
+pub(crate) fn preview(
+    app: &mut PhotocraftApp,
+    ui: &egui::Ui,
+    g: &Geometry,
+    scene: &Scene,
+    camera: Camera,
+    maps: &Materials<'_>,
+    size: [u32; 2],
+    viewport: Rect,
+) {
+    let Some(p) = ui.input(|i| i.pointer.hover_pos()).filter(|p| viewport.contains(*p)) else { return };
+    let at = (p - viewport.min) / viewport.size();
+    let Some(hit) = g.hit(scene, camera, maps, [f64::from(at.x), f64::from(at.y)], size) else { return };
+    let Some(tri) = g.triangles.get(hit.triangle) else { return };
+    let Some(st) = app.session.active() else { return };
+    if app.session.uv.map_bindings(app.session.uv.current_channel()).get(tri.material).copied().flatten() != Some(st.doc.id) {
+        return;
+    }
+    let dimensions = [f64::from(st.doc.size.width), f64::from(st.doc.size.height)];
+    let point = [hit.uv[0] * dimensions[0], (1.0 - hit.uv[1]) * dimensions[1]];
+    let painter = ui.painter_at(viewport);
+    let Some((texture, patch, tint)) = crate::canvas::clone_preview_texture(app, &painter, point, None) else { return };
+    if patch.is_empty() {
+        return;
+    }
+    let rect = Rect::from_min_max(egui::pos2(patch.x0 as f32, patch.y0 as f32), egui::pos2(patch.x1 as f32, patch.y1 as f32));
+    let mut mesh = egui::Mesh::with_texture(texture);
+    for (id, t) in g.triangles.iter().enumerate().filter(|(_, t)| t.material == tri.material) {
+        let uv = t.uv.map(|q| [f64::from(q[0]) * dimensions[0], (1.0 - f64::from(q[1])) * dimensions[1]]);
+        let points = uv.map(|q| egui::pos2(q[0] as f32, q[1] as f32));
+        if !Rect::from_points(&points).intersects(rect) {
+            continue;
+        }
+        let mut poly = points.to_vec();
+        for (axis, edge, sign) in [(0, rect.left(), -1.0), (0, rect.right(), 1.0), (1, rect.top(), -1.0), (1, rect.bottom(), 1.0)] {
+            let mut out = Vec::new();
+            for (a, b) in poly.iter().zip(poly.iter().cycle().skip(1)).take(poly.len()) {
+                let val = |p: Pos2| ((if axis == 0 { p.x } else { p.y }) - edge) * sign;
+                let (a0, b0) = (val(*a), val(*b));
+                if a0 <= 0.0 {
+                    out.push(*a);
+                }
+                if (a0 <= 0.0) != (b0 <= 0.0) {
+                    out.push(a.lerp(*b, a0 / (a0 - b0)));
+                }
+            }
+            poly = out;
+        }
+        if poly.len() < 3 {
+            continue;
+        }
+        let center = poly.iter().fold(egui::Vec2::ZERO, |a, p| a + p.to_vec2()) / poly.len() as f32;
+        let Some(center_weights) = weights([f64::from(center.x), f64::from(center.y)], uv) else { continue };
+        let position = std::array::from_fn(|j| t.positions.iter().zip(center_weights).map(|(p, w)| f64::from(p[j]) * w).sum());
+        let Some(q) = g.project_normalized(camera, position, size) else { continue };
+        // Discard occluded triangles; the source must not shine through another part of the mesh.
+        if id != hit.triangle && g.hit(scene, camera, maps, q, size).is_none_or(|h| h.triangle != id) {
+            continue;
+        }
+        let mut vertices = Vec::new();
+        for p in poly {
+            let Some(w) = weights([f64::from(p.x), f64::from(p.y)], uv) else { continue };
+            let pos = std::array::from_fn(|j| t.positions.iter().zip(w).map(|(p, w)| f64::from(p[j]) * w).sum());
+            let Some(q) = g.project_normalized(camera, pos, size) else { continue };
+            vertices.push(egui::epaint::Vertex {
+                pos: viewport.min + egui::vec2(q[0] as f32 * viewport.width(), q[1] as f32 * viewport.height()),
+                uv: egui::pos2((p.x - patch.x0 as f32) / patch.width() as f32, (p.y - patch.y0 as f32) / patch.height() as f32),
+                color: tint,
+            });
+        }
+        let base = mesh.vertices.len() as u32;
+        for i in 1..vertices.len().saturating_sub(1) {
+            mesh.indices.extend_from_slice(&[base, base + i as u32, base + i as u32 + 1]);
+        }
+        mesh.vertices.extend(vertices);
+    }
+    painter.add(egui::Shape::mesh(mesh));
+}
diff --git a/crates/ui-egui/src/uv_damage.rs b/crates/ui-egui/src/uv_damage.rs
new file mode 100644
index 0000000000000000000000000000000000000000..7e60901e0956b4a666a72eefca3069de867bae10
--- /dev/null
+++ b/crates/ui-egui/src/uv_damage.rs
@@ -0,0 +1,142 @@
+//! Retained COW snapshots recover sparse changes across multiple commits in one frame.
+use photocraft_doc::{Document, LayerContent};
+use photocraft_geom::Rect;
+use std::sync::Arc;
+
+pub(crate) fn regions(previous: &mut Option<Arc<Document>>, doc: &Arc<Document>, fallback: Option<Rect>) -> Vec<Rect> {
+    let old = previous.replace(doc.clone());
+    let regions = match sparse(old.as_deref(), doc) {
+        Some(regions) => regions.into_iter().map(|r| fallback.map_or(r, |f| r.intersect(&f))).filter(|r| !r.is_empty()).collect(),
+        None => vec![fallback.unwrap_or_else(|| doc.bounds())],
+    };
+    coalesce(regions, doc.bounds())
+}
+
+fn coalesce(mut regions: Vec<Rect>, bounds: Rect) -> Vec<Rect> {
+    // Full adjustments must become one upload, not one submission per raster tile.
+    regions.sort_by_key(|r| (r.y0, r.y1, r.x0, r.x1));
+    let mut rows: Vec<Rect> = Vec::new();
+    for r in regions {
+        if let Some(last) = rows.last_mut()
+            && last.y0 == r.y0
+            && last.y1 == r.y1
+            && r.x0 <= last.x1
+        {
+            last.x1 = last.x1.max(r.x1);
+        } else {
+            rows.push(r);
+        }
+    }
+    rows.sort_by_key(|r| (r.x0, r.x1, r.y0, r.y1));
+    let mut out: Vec<Rect> = Vec::new();
+    for r in rows {
+        if let Some(last) = out.last_mut()
+            && last.x0 == r.x0
+            && last.x1 == r.x1
+            && r.y0 <= last.y1
+        {
+            last.y1 = last.y1.max(r.y1);
+        } else {
+            out.push(r);
+        }
+    }
+    let area: u64 = out.iter().map(|r| u64::from(r.width()) * u64::from(r.height())).sum();
+    if out.len() > 64 && area > u64::from(bounds.width()) * u64::from(bounds.height()) / 4 {
+        vec![out.iter().fold(Rect::EMPTY, |a, b| a.union(b))]
+    } else {
+        out
+    }
+}
+
+// Compare only changed encoded tiles. Equal rows are a byte comparison, without
+// allocating float buffers or decoding untouched texels at a distant UV seam.
+fn changed_bounds(a: Option<&[u8]>, b: Option<&[u8]>, default: &[u8], bpp: usize) -> Option<Rect> {
+    let side = photocraft_geom::TILE_SIZE as usize;
+    let stride = side.checked_mul(bpp)?;
+    if stride == 0 {
+        return None;
+    }
+    let mut bounds = Rect::EMPTY;
+    for y in 0..side {
+        let range = y * stride..(y + 1) * stride;
+        let (a, b) = (a.and_then(|a| a.get(range.clone())), b.and_then(|b| b.get(range)));
+        if a.zip(b).is_some_and(|(a, b)| a == b) {
+            continue;
+        }
+        let equal = |x: usize| {
+            let range = x * bpp..(x + 1) * bpp;
+            a.and_then(|v| v.get(range.clone())).unwrap_or(default) == b.and_then(|v| v.get(range)).unwrap_or(default)
+        };
+        if let Some(left) = (0..side).find(|x| !equal(*x)) {
+            let right = (left..side).rfind(|x| !equal(*x)).unwrap_or(left) + 1;
+            bounds = bounds.union(&Rect::new(left as i32, y as i32, right as i32, y as i32 + 1));
+        }
+    }
+    (!bounds.is_empty()).then_some(bounds)
+}
+fn sparse(old: Option<&Document>, doc: &Document) -> Option<Vec<Rect>> {
+    let old = old.filter(|old| old.id == doc.id && old.size == doc.size && old.layers.len() == doc.layers.len())?;
+    let mut probe = doc.clone();
+    let mut regions = Vec::new();
+    // Group/effect/adjustment changes use the compositor's conservative damage path.
+    for (a, b) in old.layers.iter().zip(&mut probe.layers) {
+        match (&a.content, &mut b.content) {
+            (LayerContent::Raster(x), LayerContent::Raster(y)) => {
+                if x.format() != y.format() || x.default_bytes() != y.default_bytes() {
+                    return None;
+                }
+                let coords: std::collections::BTreeSet<_> = x.tiles().chain(y.tiles()).map(|(coord, _)| *coord).collect();
+                for coord in coords {
+                    let (a, b) = (x.tile(coord), y.tile(coord));
+                    if a.zip(b).is_some_and(|(a, b)| Arc::ptr_eq(a, b)) {
+                        continue;
+                    }
+                    if let Some(local) = changed_bounds(a.map(|t| t.bytes()), b.map(|t| t.bytes()), x.default_bytes(), x.format().bytes_per_pixel()) {
+                        let origin = coord.rect();
+                        regions.push(Rect::new(origin.x0 + local.x0, origin.y0 + local.y0, origin.x0 + local.x1, origin.y0 + local.y1));
+                    }
+                }
+                *y = x.clone();
+            }
+            _ => return None,
+        }
+    }
+    if !photocraft_engine::layer_multi_cmds::same_pixels(old, &probe) {
+        return None;
+    }
+    let reach = crate::canvas::effect_reach(&doc.layers);
+    Some(regions.into_iter().map(|r| r.inflate(reach).intersect(&doc.bounds())).filter(|r| !r.is_empty()).collect())
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    #[test]
+    fn full_adjustments_merge_tiles_but_distant_islands_remain_separate() {
+        let bounds = Rect::from_xywh(0, 0, 4096, 4096);
+        let tiles = (0..16).flat_map(|y| (0..16).map(move |x| Rect::from_xywh(x * 256, y * 256, 256, 256))).collect();
+        assert_eq!(coalesce(tiles, bounds), vec![bounds]);
+        let islands = vec![Rect::from_xywh(1, 1, 20, 20), Rect::from_xywh(3800, 1, 20, 20)];
+        assert_eq!(coalesce(islands.clone(), bounds), islands);
+    }
+    #[test]
+    fn uv_damage_recovers_distant_tiles_across_multiple_commits_and_undo() {
+        let mut s = photocraft_engine::Session::new();
+        s.execute("file.new", serde_json::json!({"width":4096,"height":4096})).unwrap();
+        let before = s.active().unwrap().doc.clone();
+        let mut previous = Some(before.clone());
+        for x in [20, 3800] {
+            s.edit("point", |doc, layer| {
+                doc.layer_mut(layer.unwrap()).unwrap().surface_mut().unwrap().write_pixel(x, 20, &[1.0, 0.0, 0.0, 1.0]);
+                Ok(())
+            })
+            .unwrap();
+        }
+        let current = s.active().unwrap().doc.clone();
+        let rects = regions(&mut previous, &current, None);
+        assert_eq!(rects.len(), 2);
+        assert_eq!(rects.iter().map(|r| u64::from(r.width()) * u64::from(r.height())).sum::<u64>(), 2);
+        s.execute("edit.undo", serde_json::json!({})).unwrap();
+        assert_eq!(regions(&mut previous, &s.active().unwrap().doc, None).len(), 1);
+    }
+}
diff --git a/crates/ui-egui/src/uv_gpu.rs b/crates/ui-egui/src/uv_gpu.rs
new file mode 100644
index 0000000000000000000000000000000000000000..03dd52a5dadd29f58b73872e57105fddd590b19b
--- /dev/null
+++ b/crates/ui-egui/src/uv_gpu.rs
@@ -0,0 +1,1690 @@
+//! GPU-resident model preview. Only camera uniforms change during navigation.
+//! Separate depth/MSAA attachments keep the editor's own render pass untouched.
+use eframe::{
+    egui_wgpu::RenderState,
+    wgpu::{self, util::DeviceExt},
+};
+use photocraft_uv::{
+    Scene,
+    prepared::Geometry,
+    preview::{Camera, Image},
+};
+use std::{collections::BTreeSet, sync::Arc};
+
+const FORMAT: wgpu::TextureFormat = wgpu::TextureFormat::Rgba8Unorm;
+const DEPTH: wgpu::TextureFormat = wgpu::TextureFormat::Depth32Float;
+const STRIDE: u64 = 72;
+type Key = (u64, u64, u64, u64);
+struct GpuSurface {
+    maps: Vec<Map>,
+    present: [bool; 5],
+    version: u64,
+}
+impl GpuSurface {
+    fn flags(&self) -> u32 {
+        self.present.iter().enumerate().fold(0, |bits, (i, yes)| bits | (u32::from(*yes) << i))
+    }
+}
+struct GpuEnvironment {
+    source: Arc<photocraft_uv::lighting::Environment>,
+    layout: wgpu::BindGroupLayout,
+    output_hash: u64,
+    group: wgpu::BindGroup,
+    _textures: Vec<wgpu::Texture>,
+}
+impl GpuEnvironment {
+    fn new(
+        rs: &RenderState,
+        _mips: &crate::uv_mips::Mips,
+        source: Arc<photocraft_uv::lighting::Environment>,
+        output: Option<&(u64, Image)>,
+    ) -> Result<Self, String> {
+        let device = &rs.device;
+        let layout = device.create_bind_group_layout(&wgpu::BindGroupLayoutDescriptor {
+            label: Some("uv environment"),
+            entries: &[
+                env_texture_entry(0),
+                env_texture_entry(1),
+                wgpu::BindGroupLayoutEntry {
+                    binding: 2,
+                    visibility: wgpu::ShaderStages::FRAGMENT,
+                    ty: wgpu::BindingType::Sampler(wgpu::SamplerBindingType::Filtering),
+                    count: None,
+                },
+                env_texture_entry(3),
+                env_texture_entry(4),
+            ],
+        });
+        let upload = |levels: &[Image]| -> Result<(wgpu::Texture, wgpu::TextureView), String> {
+            let first = levels.first().ok_or("Empty environment")?;
+            let tex = device.create_texture(&wgpu::TextureDescriptor {
+                label: Some("uv linear HDR environment"),
+                size: extent([first.width as u32, first.height as u32]),
+                mip_level_count: levels.len() as u32,
+                sample_count: 1,
+                dimension: wgpu::TextureDimension::D2,
+                format: wgpu::TextureFormat::Rgba16Float,
+                usage: wgpu::TextureUsages::TEXTURE_BINDING | wgpu::TextureUsages::COPY_DST,
+                view_formats: &[],
+            });
+            for (mip, im) in levels.iter().enumerate() {
+                let data: Vec<_> = im.rgba.iter().flat_map(|p| p.iter().flat_map(|x| crate::gpu_canvas::f32_to_f16(*x).to_le_bytes())).collect();
+                rs.queue.write_texture(
+                    wgpu::TexelCopyTextureInfo { texture: &tex, mip_level: mip as u32, origin: wgpu::Origin3d::ZERO, aspect: wgpu::TextureAspect::All },
+                    &data,
+                    wgpu::TexelCopyBufferLayout { offset: 0, bytes_per_row: Some(im.width as u32 * 8), rows_per_image: Some(im.height as u32) },
+                    extent([im.width as u32, im.height as u32]),
+                );
+            }
+            let view = tex.create_view(&Default::default());
+            Ok((tex, view))
+        };
+        let (specular, sv) = upload(&source.specular)?;
+        let (diffuse, dv) = upload(std::slice::from_ref(&source.diffuse))?;
+        let (brdf, bv) = upload(std::slice::from_ref(&photocraft_uv::lighting::brdf_lut()))?;
+        let (output_texture, ov) = upload(std::slice::from_ref(output.map_or(&crate::uv_lighting::identity_lut(), |(_, im)| im)))?;
+        let sampler = device.create_sampler(&wgpu::SamplerDescriptor {
+            label: Some("uv sky sampler"),
+            address_mode_u: wgpu::AddressMode::Repeat,
+            address_mode_v: wgpu::AddressMode::ClampToEdge,
+            mag_filter: wgpu::FilterMode::Linear,
+            min_filter: wgpu::FilterMode::Linear,
+            mipmap_filter: wgpu::MipmapFilterMode::Linear,
+            ..Default::default()
+        });
+        let group = device.create_bind_group(&wgpu::BindGroupDescriptor {
+            label: Some("uv sky"),
+            layout: &layout,
+            entries: &[
+                wgpu::BindGroupEntry { binding: 0, resource: wgpu::BindingResource::TextureView(&sv) },
+                wgpu::BindGroupEntry { binding: 1, resource: wgpu::BindingResource::TextureView(&dv) },
+                wgpu::BindGroupEntry { binding: 2, resource: wgpu::BindingResource::Sampler(&sampler) },
+                wgpu::BindGroupEntry { binding: 3, resource: wgpu::BindingResource::TextureView(&bv) },
+                wgpu::BindGroupEntry { binding: 4, resource: wgpu::BindingResource::TextureView(&ov) },
+            ],
+        });
+        Ok(Self { source, layout, output_hash: output.map_or(0, |(hash, _)| *hash), group, _textures: vec![specular, diffuse, brdf, output_texture] })
+    }
+}
+fn env_texture_entry(binding: u32) -> wgpu::BindGroupLayoutEntry {
+    wgpu::BindGroupLayoutEntry {
+        binding,
+        visibility: wgpu::ShaderStages::FRAGMENT,
+        ty: wgpu::BindingType::Texture {
+            sample_type: wgpu::TextureSampleType::Float { filterable: true },
+            view_dimension: wgpu::TextureViewDimension::D2,
+            multisampled: false,
+        },
+        count: None,
+    }
+}
+struct Map {
