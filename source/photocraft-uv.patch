+                "mask is visible, grayscale and unlit"
+            );
+            assert!(r.materials[0].as_ref().unwrap().masked);
+        }
+        r.draw(Draw {
+            scene: &scene,
+            geometry: g,
+            camera: Camera::default(),
+            size: [256, 256],
+            antialias: false,
+            selected: &empty,
+            hidden: &empty,
+            generation: 1,
+            colors: &colors,
+            normals: &[],
+            keys: &[(1, 1, 0, 0)],
+            normal_keys: &[],
+            masked: &empty,
