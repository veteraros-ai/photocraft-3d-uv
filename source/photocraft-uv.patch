+//! Small synthetic, original-asset benchmark; not a production-scene FPS guarantee.
+//! cargo run -p photocraft-uv --release --example preview_bench
+#[cfg(not(target_arch = "wasm32"))]
+use photocraft_uv::{
+    import,
+    preview::{self, Camera, Image, Materials},
+};
+#[cfg(not(target_arch = "wasm32"))]
+use std::time::Instant;
+#[cfg(not(target_arch = "wasm32"))]
+fn main() -> Result<(), Box<dyn std::error::Error>> {
+    let path = std::path::Path::new(env!("CARGO_MANIFEST_DIR")).join("tests/fixtures/normals-reflected.fbx");
+    let scene = import::load("sphere.fbx", &std::fs::read(path)?, 0, |_| Err(photocraft_uv::Error("No external dependencies".into())))?;
+    let colors: Vec<_> = scene.materials.iter().map(|_| Some(Image { width: 2048, height: 2048, rgba: vec![[0.8, 0.8, 0.8, 1.0]; 2048 * 2048] })).collect();
+    let normals: Vec<_> = scene.materials.iter().map(|_| Some(Image { width: 2048, height: 2048, rgba: vec![[0.5, 0.5, 1.0, 1.0]; 2048 * 2048] })).collect();
+    let maps = Materials { colors: &colors, normals: &normals, ..Default::default() };
+    let camera = Camera { shaded: true, ..Default::default() };
+    for (w, h) in [(1024, 576), (1920, 1080), (3840, 2160)] {
+        let mut times = Vec::new();
+        for _ in 0..3 {
+            let start = Instant::now();
+            let frame = preview::render_materials(&scene, camera, &maps, &[], w, h)?;
+            times.push(start.elapsed().as_secs_f64() * 1000.0);
+            std::hint::black_box(&frame);
+        }
+        times.sort_by(f64::total_cmp);
+        println!("{w}x{h}: median {:.2} ms ({} triangles; 2K color and normal maps)", times.get(1).copied().unwrap_or(0.0), scene.triangles.len());
+    }
+    Ok(())
+}
+
+#[cfg(target_arch = "wasm32")]
+fn main() {}
diff --git a/crates/uv/src/import.rs b/crates/uv/src/import.rs
new file mode 100644
index 0000000000000000000000000000000000000000..aced0eab50e27202cb4bc74de8a97d3abda32530
--- /dev/null
+++ b/crates/uv/src/import.rs
@@ -0,0 +1,222 @@
+//! Mesh import entry points.
+
+mod fbx;
+use crate::{Corner, Error, MAX_FILE_BYTES, MAX_TRIANGLES, MAX_VERTICES, Material, Result, Scene, Triangle};
+use std::collections::BTreeMap;
+use std::path::Path;
+
+/// Dependencies are supplied by the host; no filesystem access is needed by the parser.
+pub fn load(name: &str, bytes: &[u8], uv_set: usize, mut resolve: impl FnMut(&str) -> Result<Vec<u8>>) -> Result<Scene> {
+    if bytes.len() as u64 > MAX_FILE_BYTES {
+        return Err(Error("Model file exceeds 256 MiB".into()));
+    }
+    let ext = Path::new(name).extension().and_then(|s| s.to_str()).unwrap_or("").to_ascii_lowercase();
+    let scene = match ext.as_str() {
+        "fbx" => fbx::load(bytes, uv_set)?,
+        "obj" => {
+            if uv_set != 0 {
+                return Err(Error("OBJ has only one UV set".into()));
+            }
+            obj(bytes, &mut resolve)?
+        }
+        _ => return Err(Error("Supported model formats: FBX (binary 7.4+), OBJ + MTL".into())),
+    };
+    scene.validate()?;
+    let mut scene = scene;
+    if scene.triangles.iter().flat_map(|t| t.corners).any(|c| c.uv.iter().any(|v| !(0.0..=1.0).contains(v))) {
+        scene.warnings.push("UV coordinates extend outside tile 1001. This version only edits tile 1001; UDIM is not supported".into());
+    }
+    Ok(scene)
+}
+
+fn obj(bytes: &[u8], resolve: &mut impl FnMut(&str) -> Result<Vec<u8>>) -> Result<Scene> {
+    let text = std::str::from_utf8(bytes).map_err(|e| Error(e.to_string()))?;
+    let mut scene = Scene::default();
+    scene.materials.push(Material::default());
+    let mut material_names = BTreeMap::new();
+    let mut uvs: Vec<[f64; 2]> = Vec::new();
+    let mut normals = Vec::new();
+    let mut material = 0;
+    for (line_number, line) in text.lines().enumerate() {
+        let line = line.split('#').next().unwrap_or("").trim();
+        let mut parts = line.split_whitespace();
+        let Some(kind) = parts.next() else { continue };
+        let bad = || Error(format!("Invalid OBJ data at line {}", line_number + 1));
+        match kind {
+            "vn" => {
+                let p: Vec<f64> = parts.take(3).map(str::parse).collect::<std::result::Result<_, _>>().map_err(|_| bad())?;
+                let [x, y, z] = p.as_slice() else { return Err(bad()) };
+                if normals.len() >= MAX_VERTICES * 3 {
+                    return Err(Error("Too many normals".into()));
+                }
+                normals.push([*x, *y, *z]);
+            }
+            "v" => {
+                let p: Vec<f64> = parts.take(3).map(str::parse).collect::<std::result::Result<_, _>>().map_err(|_| bad())?;
+                let [x, y, z] = p.as_slice() else { return Err(bad()) };
+                if scene.positions.len() >= MAX_VERTICES {
+                    return Err(Error("Too many vertices".into()));
+                }
+                scene.positions.push([*x, *y, *z]);
+            }
+            "vt" => {
+                let p: Vec<f64> = parts.take(2).map(str::parse).collect::<std::result::Result<_, _>>().map_err(|_| bad())?;
+                let [u, v] = p.as_slice() else { return Err(bad()) };
+                if uvs.len() >= MAX_VERTICES * 3 {
+                    return Err(Error("Too many UV values".into()));
+                }
+                uvs.push([*u, *v]);
+            }
+            "mtllib" => {
+                let path = parts.collect::<Vec<_>>().join(" ");
+                match resolve(&path) {
+                    Ok(bytes) => {
+                        let (materials, _) = tobj::load_mtl_buf(&mut std::io::BufReader::new(bytes.as_slice())).map_err(|e| Error(e.to_string()))?;
+                        for m in materials {
+                            if m.normal_texture.is_some() {
+                                scene.warnings.push(format!("{}: MTL bump/height map is not a tangent-space normal map; assign a normal map manually", m.name));
+                            }
+                            let c = m.diffuse.unwrap_or([1.0; 3]);
+                            let texture = m.diffuse_texture.map(|s| Path::new(&path).parent().unwrap_or(Path::new("")).join(s).to_string_lossy().into_owned());
+                            material_names.insert(m.name.clone(), scene.materials.len());
+                            scene.materials.push(Material {
+                                name: m.name,
+                                color: [c[0], c[1], c[2], m.dissolve.unwrap_or(1.0)],
+                                base_color: texture,
+                                embedded: None,
+                                normal_map: m
+                                    .unknown_param
+                                    .get("norm")
+                                    .map(|s| Path::new(&path).parent().unwrap_or(Path::new("")).join(s).to_string_lossy().into_owned()),
+                                embedded_normal: None,
+                                maps: [
+                                    (crate::preview::Channel::Emissive, "map_Ke"),
+                                    (crate::preview::Channel::Metallic, "map_Pm"),
+                                    (crate::preview::Channel::Roughness, "map_Pr"),
+                                ]
+                                .into_iter()
+                                .filter_map(|(kind, key)| {
+                                    m.unknown_param
+                                        .get(key)
+                                        .map(|s| (kind, Path::new(&path).parent().unwrap_or(Path::new("")).join(s).to_string_lossy().into_owned()))
+                                })
+                                .collect(),
+                            });
+                        }
+                    }
+                    Err(e) => scene.warnings.push(format!("MTL {path}: {e}; assign textures manually")),
+                }
+            }
+            "usemtl" => {
+                let name = parts.collect::<Vec<_>>().join(" ");
+                material = *material_names.entry(name.clone()).or_insert_with(|| {
+                    let id = scene.materials.len();
+                    scene.materials.push(Material { name, ..Material::default() });
+                    id
+                });
+            }
+            "f" => {
+                let mut face = Vec::new();
+                for word in parts {
+                    if face.len() >= 65_536 {
+                        return Err(Error("OBJ polygon is too large".into()));
+                    }
+                    let mut fields = word.split('/');
+                    let v = index(fields.next().unwrap_or(""), scene.positions.len())?;
+                    let t = index(fields.next().unwrap_or(""), uvs.len())
+                        .map_err(|_| Error(format!("Missing UV at OBJ line {}; unwrap the model before import", line_number + 1)))?;
+                    let uv = uvs.get(t).copied().ok_or_else(bad)?;
+                    let normal = fields
+                        .next()
+                        .filter(|s| !s.is_empty())
+                        .map(|s| index(s, normals.len()).and_then(|i| normals.get(i).copied().ok_or_else(bad)))
+                        .transpose()?;
+                    face.push(Corner { vertex: v, uv, normal });
+                }
+                if triangulate(&scene.positions, &face, material, &mut scene.triangles)? && scene.warnings.len() < 100 {
+                    scene.warnings.push(format!("OBJ line {}: redundant or degenerate polygon corners omitted", line_number + 1));
+                }
+            }
+            _ => {}
+        }
+    }
+    Ok(scene)
+}
+
+fn index(s: &str, len: usize) -> Result<usize> {
+    let n = s.parse::<i64>().map_err(|_| Error("Invalid OBJ index".into()))?;
+    let i = if n < 0 { len as i64 + n } else { n - 1 };
+    usize::try_from(i).ok().filter(|i| *i < len).ok_or_else(|| Error("OBJ index is out of range".into()))
+}
+
+/// Ear clipping in the polygon's dominant 3D plane also handles concave n-gons.
+fn triangulate(positions: &[[f64; 3]], face: &[Corner], material: usize, output: &mut Vec<Triangle>) -> Result<bool> {
+    if face.len() < 3 {
+        return Err(Error("Polygon has fewer than three vertices".into()));
+    }
+    if face.iter().any(|c| c.uv.iter().any(|v| !v.is_finite() || v.abs() > 100_000.0)) {
+        return Err(Error("Polygon contains invalid UV coordinates".into()));
+    }
+    if output.len().saturating_add(face.len().saturating_sub(2)) > MAX_TRIANGLES {
+        return Err(Error("Too many triangles".into()));
+    }
+    let points: Vec<glam::DVec3> = face
+        .iter()
+        .map(|c| positions.get(c.vertex).copied().map(glam::DVec3::from_array).ok_or_else(|| Error("Invalid polygon vertex".into())))
+        .collect::<Result<_>>()?;
+    if points.iter().any(|p| !p.is_finite() || p.abs().max_element() > 1e15) {
+        return Err(Error("Polygon contains invalid coordinates".into()));
+    }
+    let mut normal = glam::DVec3::ZERO;
+    for (a, b) in points.iter().zip(points.iter().cycle().skip(1)).take(points.len()) {
+        normal += a.cross(*b);
+    }
+    // Newell's normal can cancel on a folded or repeated contour. Find a stable
+    // projection without dividing by a zero vector; earcut still decides coverage.
+    if normal.length_squared() < 1e-24 {
+        for triple in points.windows(3) {
+            if let [a, b, c] = triple {
+                let candidate = (*b - *a).cross(*c - *a);
+                if candidate.length_squared() > normal.length_squared() {
+                    normal = candidate;
+                }
+            }
+        }
+    }
+    if normal.length_squared() < 1e-24 {
+        return Ok(true);
+    }
+    let axis = normal.abs().max_element();
+    let projected: Vec<f64> = points
+        .iter()
+        .flat_map(|p| {
+            if normal.x.abs() == axis {
+                [p.y, p.z]
+            } else if normal.y.abs() == axis {
+                [p.x, p.z]
+            } else {
+                [p.x, p.y]
+            }
+        })
+        .collect();
+    let indices = earcutr::earcut(&projected, &[], 2).map_err(|e| Error(format!("Cannot triangulate polygon: {e}")))?;
+    // Earcut legitimately removes repeated/collinear corners. Rejecting a whole
+    // model because its output has fewer triangles loses otherwise valid meshes.
+    let mut repaired = indices.len() != face.len().saturating_sub(2) * 3;
+    for &[a, b, c] in indices.as_chunks::<3>().0 {
+        let [Some(a), Some(b), Some(c)] = [a, b, c].map(|i| face.get(i).copied()) else {
+            return Err(Error("Invalid triangulation".into()));
+        };
+        let mut corners = [a, b, c];
+        let [pa, pb, pc] = corners.map(|c| glam::DVec3::from_array(positions.get(c.vertex).copied().unwrap_or([0.0; 3])));
+        if (pb - pa).cross(pc - pa).length_squared() < 1e-24 {
+            repaired = true;
+            continue;
+        }
+        if (pb - pa).cross(pc - pa).dot(normal) < 0.0 {
+            corners.swap(1, 2);
+        }
+        output.push(Triangle { corners, material });
+    }
+    Ok(repaired)
+}
diff --git a/crates/uv/src/import/fbx.rs b/crates/uv/src/import/fbx.rs
new file mode 100644
index 0000000000000000000000000000000000000000..e8043f2aea803194549f780e67040cb84cc4759a
--- /dev/null
+++ b/crates/uv/src/import/fbx.rs
@@ -0,0 +1,307 @@
+//! Binary FBX static meshes, preserving per-corner UV and control-point identities.
+use crate::{Corner, Error, MAX_VERTICES, Material, Result, Scene};
+use fbxcel::{
+    low::v7400::AttributeValue as A,
+    tree::{any::AnyTree, v7400::NodeHandle},
+};
+use glam::{DMat4, DQuat, DVec3, EulerRot};
+use std::collections::{BTreeMap, BTreeSet};
+
+fn child<'a>(n: NodeHandle<'a>, name: &str) -> Option<NodeHandle<'a>> {
+    n.first_child_by_name(name)
+}
+fn string(n: NodeHandle<'_>, index: usize) -> Option<&str> {
+    n.attributes().get(index)?.get_string()
+}
+fn id(n: NodeHandle<'_>) -> Option<i64> {
+    n.attributes().first()?.get_i64()
+}
+fn text<'a>(n: NodeHandle<'a>, name: &str) -> Option<&'a str> {
+    string(child(n, name)?, 0)
+}
+fn floats(n: NodeHandle<'_>, name: &str) -> Result<Vec<f64>> {
+    let values = child(n, name).and_then(|n| n.attributes().first());
+    match values {
+        Some(A::ArrF64(a)) => Ok(a.clone()),
+        Some(A::ArrF32(a)) => Ok(a.iter().map(|v| f64::from(*v)).collect()),
+        _ => Err(Error(format!("FBX {name} array is missing"))),
+    }
+}
+fn ints(n: NodeHandle<'_>, name: &str) -> Result<Vec<i32>> {
+    child(n, name)
+        .and_then(|n| n.attributes().first())
+        .and_then(A::get_arr_i32)
+        .map(|a| a.to_vec())
+        .ok_or_else(|| Error(format!("FBX {name} array is missing")))
+}
+fn property<'a>(n: NodeHandle<'a>, name: &str) -> Option<NodeHandle<'a>> {
+    child(n, "Properties70")?.children_by_name("P").find(|p| string(*p, 0) == Some(name))
+}
+fn vector(n: NodeHandle<'_>, name: &str, default: DVec3) -> DVec3 {
+    property(n, name)
+        .and_then(|p| {
+            let a = p.attributes();
+            Some(DVec3::new(a.get(4)?.get_f64()?, a.get(5)?.get_f64()?, a.get(6)?.get_f64()?))
+        })
+        .unwrap_or(default)
+}
+fn rotate(v: DVec3, order: i32) -> DMat4 {
+    let v = v * std::f64::consts::PI / 180.0;
+    let q = match order {
+        1 => DQuat::from_euler(EulerRot::YZX, v.y, v.z, v.x),
+        2 => DQuat::from_euler(EulerRot::XZY, v.x, v.z, v.y),
+        3 => DQuat::from_euler(EulerRot::ZXY, v.z, v.x, v.y),
+        4 => DQuat::from_euler(EulerRot::YXZ, v.y, v.x, v.z),
+        5 => DQuat::from_euler(EulerRot::XYZ, v.x, v.y, v.z),
+        _ => DQuat::from_euler(EulerRot::ZYX, v.z, v.y, v.x),
+    };
+    DMat4::from_quat(q)
+}
+fn integer(n: NodeHandle<'_>, name: &str) -> i32 {
+    property(n, name).and_then(|p| p.attributes().get(4)).and_then(A::get_i32).unwrap_or(0)
+}
+fn transform(n: NodeHandle<'_>, geometric: bool) -> DMat4 {
+    let v = |name, default| vector(n, name, default);
+    let t = |x| DMat4::from_translation(x);
+    if geometric {
+        return t(v("GeometricTranslation", DVec3::ZERO))
+            * rotate(v("GeometricRotation", DVec3::ZERO), 0)
+            * DMat4::from_scale(v("GeometricScaling", DVec3::ONE));
+    }
+    let rp = v("RotationPivot", DVec3::ZERO);
+    let sp = v("ScalingPivot", DVec3::ZERO);
+    t(v("Lcl Translation", DVec3::ZERO))
+        * t(v("RotationOffset", DVec3::ZERO))
+        * t(rp)
+        * rotate(v("PreRotation", DVec3::ZERO), 0)
+        * rotate(v("Lcl Rotation", DVec3::ZERO), integer(n, "RotationOrder"))
+        * rotate(v("PostRotation", DVec3::ZERO), 0).inverse()
+        * t(-rp)
+        * t(v("ScalingOffset", DVec3::ZERO))
+        * t(sp)
+        * DMat4::from_scale(v("Lcl Scaling", DVec3::ONE))
+        * t(-sp)
+}
+
+pub(super) fn load(bytes: &[u8], uv_set: usize) -> Result<Scene> {
+    if !bytes.starts_with(b"Kaydara FBX Binary") {
+        return Err(Error("This build imports binary FBX 7.4+; export FBX as Binary from Maya (ASCII FBX is not supported)".into()));
+    }
+    let tree = AnyTree::from_seekable_reader(std::io::Cursor::new(bytes)).map_err(|e| Error(format!("FBX: {e}")))?;
+    let AnyTree::V7400(_, tree, _) = tree else { return Err(Error("Unsupported FBX version".into())) };
+    let root = tree.root();
+    let objects = child(root, "Objects").ok_or_else(|| Error("FBX Objects missing".into()))?;
+    let connections: Vec<(i64, i64, String)> = child(root, "Connections")
+        .map(|c| {
+            c.children_by_name("C")
+                .filter_map(|n| {
+                    let a = n.attributes();
+                    Some((a.get(1)?.get_i64()?, a.get(2)?.get_i64()?, a.get(3).and_then(A::get_string).unwrap_or("").to_owned()))
+                })
+                .collect()
+        })
+        .unwrap_or_default();
+    let by_id: BTreeMap<i64, NodeHandle<'_>> = objects.children().filter_map(|n| Some((id(n)?, n))).collect();
+    let mut scene = Scene::default();
+    let mut materials = BTreeMap::new();
+    for m in objects.children_by_name("Material") {
+        let Some(mid) = id(m) else { continue };
+        let color = vector(m, "DiffuseColor", DVec3::ONE);
+        let texture = connections
+            .iter()
+            .filter(|(_, to, prop)| *to == mid && (prop == "DiffuseColor" || prop == "Diffuse" || prop == "BaseColor"))
+            .find_map(|(from, _, _)| by_id.get(from).copied().filter(|n| n.name() == "Texture"));
+        let filename = texture.and_then(|t| text(t, "RelativeFilename").filter(|s| !s.is_empty()).or_else(|| text(t, "FileName"))).map(str::to_owned);
+        let embedded = texture.and_then(id).and_then(|tid| {
+            connections.iter().find_map(|(from, to, _)| {
+                if *to != tid {
+                    return None;
+                }
+                let video = by_id.get(from).copied().filter(|n| n.name() == "Video")?;
+                child(video, "Content")?.attributes().first()?.get_binary().map(|b| b.to_vec())
+            })
+        });
+        let normal_texture = connections
+            .iter()
+            .filter(|(_, to, prop)| *to == mid && (prop == "NormalMap" || prop == "normalCamera"))
+            .find_map(|(from, _, _)| by_id.get(from).copied().filter(|n| n.name() == "Texture"));
+        let normal_map = normal_texture.and_then(|t| text(t, "RelativeFilename").filter(|s| !s.is_empty()).or_else(|| text(t, "FileName"))).map(str::to_owned);
+        let embedded_normal = normal_texture.and_then(id).and_then(|tid| {
+            connections.iter().find_map(|(from, to, _)| {
+                if *to != tid {
+                    return None;
+                }
+                let video = by_id.get(from).copied().filter(|n| n.name() == "Video")?;
+                child(video, "Content")?.attributes().first()?.get_binary().map(|b| b.to_vec())
+            })
+        });
+        let mut maps = BTreeMap::new();
+        for (kind, properties) in [
+            (crate::preview::Channel::Id, &["MaterialID", "ID"][..]),
+            (crate::preview::Channel::Ao, &["AmbientOcclusion", "AmbientOcclusionMap"][..]),
+            (crate::preview::Channel::Curvature, &["Curvature"][..]),
+            (crate::preview::Channel::Opacity, &["Opacity", "OpacityMap", "TransparentColor"][..]),
+            (crate::preview::Channel::Metallic, &["Metalness", "Metallic"][..]),
+            (crate::preview::Channel::Roughness, &["Roughness", "DiffuseRoughness"][..]),
+            (crate::preview::Channel::Emissive, &["EmissiveColor", "Emissive", "Emission"][..]),
+        ] {
+            if let Some(texture) = connections
+                .iter()
+                .filter(|(_, to, prop)| *to == mid && properties.contains(&prop.as_str()))
+                .find_map(|(from, _, _)| by_id.get(from).copied().filter(|n| n.name() == "Texture"))
+                && let Some(name) = text(texture, "RelativeFilename").filter(|s| !s.is_empty()).or_else(|| text(texture, "FileName"))
+            {
+                maps.insert(kind, name.to_owned());
+            }
+        }
+        materials.insert(mid, scene.materials.len());
+        scene.materials.push(Material {
+            name: string(m, 1).unwrap_or("Material").split('\0').next().unwrap_or("Material").trim_start_matches("Material::").to_owned(),
+            color: [color.x as f32, color.y as f32, color.z as f32, 1.0],
+            base_color: filename,
+            embedded,
+            normal_map,
+            embedded_normal,
+            maps,
+        });
+    }
+    let default_material = scene.materials.len();
+    scene.materials.push(Material::default());
+    let mut warned_skin = false;
+    for geometry in objects.children_by_name("Geometry").filter(|n| string(*n, 2) == Some("Mesh")) {
+        let gid = id(geometry).ok_or_else(|| Error("FBX geometry id missing".into()))?;
+        let vertices = floats(geometry, "Vertices")?;
+        let polygons = ints(geometry, "PolygonVertexIndex")?;
+        if !vertices.len().is_multiple_of(3) || vertices.len() / 3 > MAX_VERTICES {
+            return Err(Error("Invalid FBX vertex array".into()));
+        }
+        let uv = geometry
+            .children_by_name("LayerElementUV")
+            .nth(uv_set)
+            .ok_or_else(|| Error(format!("FBX mesh has no UV set {uv_set}; unwrap it before import")))?;
+        let uv_values = floats(uv, "UV")?;
+        let uv_indices = if text(uv, "ReferenceInformationType") == Some("IndexToDirect") { Some(ints(uv, "UVIndex")?) } else { None };
+        let mapping = text(uv, "MappingInformationType").unwrap_or("ByPolygonVertex");
+        let normals = child(geometry, "LayerElementNormal");
+        let normal_values = normals.map(|n| floats(n, "Normals")).transpose()?.unwrap_or_default();
+        let normal_mapping = normals.and_then(|n| text(n, "MappingInformationType")).unwrap_or("ByPolygonVertex");
+        let normal_indices = normals
+            .filter(|n| matches!(text(*n, "ReferenceInformationType"), Some("IndexToDirect" | "Index")))
+            .map(|n| ints(n, if child(n, "NormalsIndex").is_some() { "NormalsIndex" } else { "NormalIndex" }))
+            .transpose()?;
+        let material_layer = child(geometry, "LayerElementMaterial");
+        let material_indices = material_layer.and_then(|n| ints(n, "Materials").ok()).unwrap_or_default();
+        let all_same = material_layer.and_then(|n| text(n, "MappingInformationType")) == Some("AllSame");
+        let models: Vec<NodeHandle<'_>> =
+            connections.iter().filter(|(from, _, _)| *from == gid).filter_map(|(_, to, _)| by_id.get(to).copied().filter(|n| n.name() == "Model")).collect();
+        if models.is_empty() {
+            scene.warnings.push("Unconnected FBX geometry skipped".into());
+        }
+        for model in models {
+            let mid = id(model).ok_or_else(|| Error("Missing model id".into()))?;
+            let mut matrix = transform(model, false);
+            let mut current = mid;
+            let mut seen = BTreeSet::new();
+            seen.insert(mid);
+            while let Some(parent) =
+                connections.iter().filter(|(from, _, _)| *from == current).find_map(|(_, to, _)| by_id.get(to).copied().filter(|n| n.name() == "Model"))
+            {
+                current = id(parent).ok_or_else(|| Error("Missing parent id".into()))?;
+                if seen.len() >= 128 || !seen.insert(current) {
+                    return Err(Error("Cyclic or overly deep FBX hierarchy".into()));
+                }
+                matrix = transform(parent, false) * matrix;
+            }
+            matrix *= transform(model, true);
+            let reflected = matrix.determinant() < 0.0;
+            let normal_matrix = matrix.inverse().transpose();
+            if !normal_matrix.is_finite() {
+                return Err(Error("FBX has a singular mesh transform; freeze transforms before importing".into()));
+            }
+            if integer(model, "InheritType") != 0 {
+                scene.warnings.push("FBX nondefault transform inheritance is approximated; freeze mesh transforms for exact placement".into());
+            }
+            let attached: Vec<usize> = connections.iter().filter(|(_, to, _)| *to == mid).filter_map(|(from, _, _)| materials.get(from).copied()).collect();
+            let offset = scene.positions.len();
+            if offset.saturating_add(vertices.len() / 3) > MAX_VERTICES {
+                return Err(Error("Too many FBX vertices".into()));
+            }
+            scene.positions.extend(vertices.as_chunks::<3>().0.iter().map(|&[x, y, z]| matrix.transform_point3(DVec3::new(x, y, z)).to_array()));
+            let mut face = Vec::new();
+            let mut polygon = 0;
+            for (corner, &raw) in polygons.iter().enumerate() {
+                let vertex = usize::try_from(if raw < 0 { !raw } else { raw }).map_err(|_| Error("Invalid FBX vertex index".into()))?;
+                if vertex >= vertices.len() / 3 {
+                    return Err(Error("FBX vertex index is out of range".into()));
+                }
+                let mapped = match mapping {
+                    "ByPolygonVertex" => corner,
+                    "ByVertice" | "ByVertex" => vertex,
+                    "ByPolygon" => polygon,
+                    "AllSame" => 0,
+                    _ => return Err(Error(format!("Unsupported FBX UV mapping: {mapping}"))),
+                };
+                let direct = if let Some(indices) = &uv_indices {
+                    indices.get(mapped).copied().and_then(|n| usize::try_from(n).ok()).ok_or_else(|| Error("FBX UV index out of range".into()))?
+                } else {
+                    mapped
+                };
+                let at = direct.checked_mul(2).ok_or_else(|| Error("FBX UV index overflow".into()))?;
+                let (Some(&u), Some(&v)) = (uv_values.get(at), uv_values.get(at + 1)) else { return Err(Error("FBX UV coordinates out of range".into())) };
+                let normal = if normals.is_some() {
+                    let mapped = match normal_mapping {
+                        "ByPolygonVertex" => corner,
+                        "ByVertice" | "ByVertex" => vertex,
+                        "ByPolygon" => polygon,
+                        "AllSame" => 0,
+                        _ => return Err(Error("Unsupported FBX normal mapping".into())),
+                    };
+                    let direct = if let Some(indices) = &normal_indices {
+                        indices.get(mapped).and_then(|v| usize::try_from(*v).ok()).ok_or_else(|| Error("FBX normal index out of range".into()))?
+                    } else {
+                        mapped
+                    };
+                    let at = direct.checked_mul(3).ok_or_else(|| Error("FBX normal index overflow".into()))?;
+                    let xyz = normal_values.get(at..at.saturating_add(3)).ok_or_else(|| Error("FBX normals out of range".into()))?;
+                    let &[x, y, z] = xyz else { return Err(Error("Invalid FBX normal".into())) };
+                    let n = normal_matrix.transform_vector3(DVec3::new(x, y, z));
+                    if !n.is_finite() || n.length_squared() < 1e-24 {
+                        return Err(Error("Invalid FBX normal".into()));
+                    }
+                    Some(n.normalize().to_array())
+                } else {
+                    None
+                };
+                face.push(Corner { vertex: vertex + offset, uv: [u, v], normal });
+                if face.len() > 65_536 {
+                    return Err(Error("FBX polygon is too large".into()));
+                }
+                if raw < 0 {
+                    let slot = material_indices.get(if all_same { 0 } else { polygon }).copied().unwrap_or(0);
+                    let material = usize::try_from(slot).ok().and_then(|i| attached.get(i)).copied().unwrap_or(default_material);
+                    if reflected {
+                        face.reverse();
+                    }
+                    if super::triangulate(&scene.positions, &face, material, &mut scene.triangles)? && scene.warnings.len() < 100 {
+                        scene.warnings.push("FBX: redundant or degenerate polygon corners omitted during triangulation".into());
+                    }
+                    face.clear();
+                    polygon += 1;
+                }
+            }
+            if !face.is_empty() {
+                return Err(Error("Unterminated FBX polygon".into()));
+            }
+        }
+        if objects.children_by_name("Deformer").next().is_some() {
+            warned_skin = true;
+        }
+    }
+    if warned_skin {
+        scene.warnings.push("Skinning and animation are not evaluated; the original static mesh is shown".into());
+    }
+    scene.warnings.push("GPU Material supports Color, Normal, Metallic, Roughness, AO and Emissive; height/bump is not evaluated".into());
+    scene.warnings.sort();
+    scene.warnings.dedup();
+    Ok(scene)
+}
diff --git a/crates/uv/src/lib.rs b/crates/uv/src/lib.rs
new file mode 100644
index 0000000000000000000000000000000000000000..390bd293e1b22f0878da14eb781385a6802a3af7
--- /dev/null
+++ b/crates/uv/src/lib.rs
@@ -0,0 +1,111 @@
+//! Independent mesh topology, UV masks and reference 3D preview for PhotoCraft.
+#![forbid(unsafe_code)]
+#![deny(clippy::unwrap_used, clippy::expect_used, clippy::panic, clippy::unimplemented, clippy::todo, clippy::unreachable)]
+
+pub mod import;
+pub mod lighting;
+mod perspective;
+pub mod prepared;
+pub mod preview;
+pub mod topology;
+pub mod wrap;
+
+use serde::{Deserialize, Serialize};
+
+pub type Result<T> = std::result::Result<T, Error>;
+#[derive(Debug, thiserror::Error)]
+#[error("{0}")]
+pub struct Error(pub String);
+
+pub const MAX_TRIANGLES: usize = 1_000_000;
+pub const MAX_VERTICES: usize = 3_000_000;
+pub const MAX_PIXELS: usize = 16_777_216;
+pub const MAX_FILE_BYTES: u64 = 256 * 1024 * 1024;
+
+#[derive(Clone, Debug, Serialize, Deserialize)]
+pub struct Material {
+    pub name: String,
+    pub color: [f32; 4],
+    /// Resolved by the importer; an absent file remains visible to the user for relinking.
+    pub base_color: Option<String>,
+    #[serde(default)]
+    pub normal_map: Option<String>,
+    #[serde(default)]
+    pub maps: std::collections::BTreeMap<preview::Channel, String>,
+    #[serde(skip)]
+    pub embedded: Option<Vec<u8>>,
+    #[serde(skip)]
+    pub embedded_normal: Option<Vec<u8>>,
+}
+
+impl Default for Material {
+    fn default() -> Self {
+        Self {
+            name: "Default".into(),
+            color: [0.7, 0.7, 0.7, 1.0],
+            base_color: None,
+            normal_map: None,
+            maps: Default::default(),
+            embedded: None,
+            embedded_normal: None,
+        }
+    }
+}
+
+#[derive(Clone, Copy, Debug, Serialize, Deserialize)]
+pub struct Corner {
+    /// Original control-point identity, preserved across UV splits and material boundaries.
+    pub vertex: usize,
+    /// Bottom-left texture origin, independent of the source format.
+    pub uv: [f64; 2],
+    /// Authored split normal in world space; absent values use the geometric face normal.
+    #[serde(default)]
+    pub normal: Option<[f64; 3]>,
+}
+
+#[derive(Clone, Debug, Serialize, Deserialize)]
+pub struct Triangle {
+    pub corners: [Corner; 3],
+    pub material: usize,
+}
+
+#[derive(Clone, Debug, Default, Serialize, Deserialize)]
+pub struct Scene {
+    pub positions: Vec<[f64; 3]>,
+    pub triangles: Vec<Triangle>,
+    pub materials: Vec<Material>,
+    pub warnings: Vec<String>,
+}
+
+impl Scene {
+    pub fn validate(&self) -> Result<()> {
+        if self.triangles.is_empty() || self.positions.is_empty() || self.materials.is_empty() {
+            return Err(Error("The model has no UV-mapped mesh".into()));
+        }
+        if self.triangles.len() > MAX_TRIANGLES || self.positions.len() > MAX_VERTICES {
+            return Err(Error("Model exceeds the mesh budget (1M triangles / 3M vertices)".into()));
+        }
+        if self.positions.iter().flatten().any(|x| !x.is_finite() || x.abs() > 1e15) {
+            return Err(Error("Model contains invalid positions".into()));
+        }
+        for t in &self.triangles {
+            if t.material >= self.materials.len()
+                || t.corners.iter().any(|c| {
+                    c.vertex >= self.positions.len()
+                        || c.uv.iter().any(|x| !x.is_finite() || x.abs() > 100_000.0)
+                        || c.normal.is_some_and(|n| n.iter().any(|v| !v.is_finite() || v.abs() > 1e15) || glam::DVec3::from_array(n).length_squared() < 1e-24)
+                })
+            {
+                return Err(Error("Model contains invalid vertex, material or UV data".into()));
+            }
+        }
+        Ok(())
+    }
+}
+
+pub(crate) fn filled<T: Clone>(len: usize, value: T) -> Result<Vec<T>> {
+    let mut v = Vec::new();
+    v.try_reserve_exact(len).map_err(|_| Error("Not enough memory for the UV operation".into()))?;
+    v.resize(len, value);
+    Ok(v)
+}
diff --git a/crates/uv/src/lighting.rs b/crates/uv/src/lighting.rs
new file mode 100644
index 0000000000000000000000000000000000000000..df82ffda8cfcd81c9f1c381b2aebece4f8ed77d9
--- /dev/null
+++ b/crates/uv/src/lighting.rs
@@ -0,0 +1,177 @@
+//! Bounded, deterministic image-based lighting preparation. No work is repeated during orbit.
+use crate::{Error, Result, preview::Image};
+use glam::Vec3;
+use serde::{Deserialize, Serialize};
+use std::f32::consts::{PI, TAU};
+
+#[derive(Clone, Copy, Debug, PartialEq, Serialize, Deserialize)]
+#[serde(default)]
+pub struct Settings {
+    pub pbr: bool,
+    pub brightness: f32,
+    pub rotation: f32,
+    pub background: bool,
+    pub background_brightness: f32,
+    pub roughness: f32,
+    pub metallic: f32,
+    pub emissive: f32,
+}
+impl Default for Settings {
+    fn default() -> Self {
+        Self { pbr: true, brightness: 1.0, rotation: 0.0, background: false, background_brightness: 1.0, roughness: 0.5, metallic: 0.0, emissive: 1.0 }
+    }
+}
+impl Settings {
+    pub fn sanitized(mut self) -> Self {
+        fn bound(x: f32, default: f32, lo: f32, hi: f32) -> f32 {
+            if x.is_finite() { x.clamp(lo, hi) } else { default }
+        }
+        self.brightness = bound(self.brightness, 1.0, 0.0, 16.0);
+        self.rotation = bound(self.rotation, 0.0, -360.0, 360.0);
+        self.background_brightness = bound(self.background_brightness, 1.0, 0.0, 16.0);
+        self.roughness = bound(self.roughness, 0.5, 0.045, 1.0);
+        self.metallic = bound(self.metallic, 0.0, 0.0, 1.0);
+        self.emissive = bound(self.emissive, 1.0, 0.0, 32.0);
+        self
+    }
+}
+
+pub struct Environment {
+    /// Linear radiance, GGX-convolved at increasing perceptual roughness.
+    pub specular: Vec<Image>,
+    /// Cosine-weighted irradiance divided by pi.
+    pub diffuse: Image,
+}
+/// Split-sum GGX scale/bias integrated against the same Smith visibility used by the BRDF.
+pub fn brdf_lut() -> Image {
+    let size = 64;
+    let rgba = (0..size * size)
+        .map(|i| {
+            let nv = (i % size) as f32 / size as f32 + 0.5 / size as f32;
+            let rough = (i / size) as f32 / size as f32 + 0.5 / size as f32;
+            let v = Vec3::new((1.0 - nv * nv).sqrt(), 0.0, nv);
+            let a2 = rough.powi(4);
+            let mut sum = [0.0; 2];
+            for j in 0..128u32 {
+                let u = (j as f32 + 0.5) / 128.0;
+                let xi = j.reverse_bits() as f32 * 2.328_306_4e-10;
+                let cos = ((1.0 - xi) / (1.0 + (a2 - 1.0) * xi)).sqrt();
+                let sin = (1.0 - cos * cos).max(0.0).sqrt();
+                let (s, c) = (TAU * u).sin_cos();
+                let h = Vec3::new(sin * c, sin * s, cos);
+                let vh = v.dot(h).max(0.0);
+                let l = 2.0 * vh * h - v;
+                let nl = l.z.max(0.0);
+                if nl > 0.0 {
+                    let smith = |n: f32| 2.0 * n / (n + (a2 + (1.0 - a2) * n * n).sqrt()).max(1e-6);
+                    let visibility = smith(nv) * smith(nl) * vh / (cos * nv).max(1e-6);
+                    let f = (1.0 - vh).powi(5);
+                    sum[0] += (1.0 - f) * visibility;
+                    sum[1] += f * visibility;
+                }
+            }
+            [sum[0] / 128.0, sum[1] / 128.0, 0.0, 1.0]
+        })
+        .collect();
+    Image { width: size, height: size, rgba }
+}
+fn direction(u: f32, v: f32) -> Vec3 {
+    let (s, c) = (TAU * (u - 0.5)).sin_cos();
+    let (st, ct) = (PI * v).sin_cos();
+    Vec3::new(c * st, ct, s * st)
+}
+fn sample(im: &Image, d: Vec3) -> Vec3 {
+    let u = d.z.atan2(d.x) / TAU + 0.5;
+    let v = d.y.clamp(-1.0, 1.0).acos() / PI;
+    // Clamp latitude at poles, repeat longitude only.
+    let x = u * im.width as f32 - 0.5;
+    let y = v * im.height as f32 - 0.5;
+    let ix = x.floor() as i64;
+    let iy = y.floor() as i64;
+    let at = |x: i64, y: i64| {
+        let x = x.rem_euclid(im.width as i64) as usize;
+        let y = y.clamp(0, im.height.saturating_sub(1) as i64) as usize;
+        im.rgba.get(y * im.width + x).map_or(Vec3::ZERO, |p| Vec3::from_array([p[0], p[1], p[2]]))
+    };
+    at(ix, iy).lerp(at(ix + 1, iy), x - x.floor()).lerp(at(ix, iy + 1).lerp(at(ix + 1, iy + 1), x - x.floor()), y - y.floor())
+}
+fn image(w: usize, h: usize, f: impl Fn(Vec3) -> Vec3) -> Image {
+    let rgba = (0..w * h)
+        .map(|i| {
+            let c = f(direction((i % w) as f32 / w as f32 + 0.5 / w as f32, (i / w) as f32 / h as f32 + 0.5 / h as f32));
+            [c.x, c.y, c.z, 1.0]
+        })
+        .collect();
+    Image { width: w, height: h, rgba }
+}
+impl Environment {
+    pub fn studio() -> Self {
+        let source = image(256, 128, |d| {
+            let sky = Vec3::new(0.45, 0.52, 0.65).lerp(Vec3::splat(0.18), (-d.y).max(0.0));
+            let key = d.dot(Vec3::new(-0.5, 0.7, 0.5).normalize()).max(0.0).powf(48.0) * 10.0;
+            let rim = d.dot(Vec3::new(0.7, 0.3, -0.6).normalize()).max(0.0).powf(80.0) * 6.0;
+            sky + Vec3::new(1.0, 0.92, 0.82) * key + Vec3::new(0.7, 0.82, 1.0) * rim
+        });
+        // The generated dimensions/radiance obey the same bounds as imported maps.
+        Self::prepare_valid(&source)
+    }
+    pub fn prepare(source: &Image) -> Result<Self> {
+        if source.width == 0
+            || source.height == 0
+            || source.width.checked_mul(source.height) != Some(source.rgba.len())
+            || source.rgba.len() > 33_554_432
+            || source.rgba.iter().flatten().any(|v| !v.is_finite() || *v < 0.0 || *v > 65504.0)
+        {
+            return Err(Error("Invalid environment: expected finite positive linear HDR radiance (up to 32 MP)".into()));
+        }
+        Ok(Self::prepare_valid(source))
+    }
+    fn prepare_valid(source: &Image) -> Self {
+        let samples: Vec<_> = (0..64u32).map(|i| ((i as f32 + 0.5) / 64.0, i.reverse_bits() as f32 * 2.328_306_4e-10)).collect();
+        let convolve = |n: Vec3, roughness: f32, diffuse: bool| {
+            let up = if n.y.abs() < 0.999 { Vec3::Y } else { Vec3::X };
+            let t = up.cross(n).normalize();
+            let b = n.cross(t);
+            let (mut sum, mut weight) = (Vec3::ZERO, 0.0);
+            for &(u, v) in &samples {
+                let a2 = roughness.powi(4);
+                let cos = if diffuse { (1.0 - v).sqrt() } else { ((1.0 - v) / (1.0 + (a2 - 1.0) * v)).sqrt() };
+                let sin = (1.0 - cos * cos).max(0.0).sqrt();
+                let (s, c) = (TAU * u).sin_cos();
+                let h = t * (sin * c) + b * (sin * s) + n * cos;
+                let l = if diffuse { h } else { 2.0 * n.dot(h) * h - n };
+                let w = if diffuse { 1.0 } else { n.dot(l).max(0.0) };
+                sum += sample(source, l) * w;
+                weight += w;
+            }
+            sum / weight.max(1e-6)
+        };
+        let mut specular = Vec::new();
+        for level in 0..9 {
+            let w = (256 >> level).max(1);
+            let h = (128 >> level).max(1);
+            specular.push(image(w, h, |d| if level == 0 { sample(source, d) } else { convolve(d, level as f32 / 8.0, false) }));
+        }
+        Self { specular, diffuse: image(32, 16, |d| convolve(d, 1.0, true)) }
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    #[test]
+    fn constant_hdr_energy_survives_prefilter_and_invalid_input_is_rejected() {
+        let mut source = Image { width: 4, height: 2, rgba: vec![[4.0, 2.0, 0.5, 1.0]; 8] };
+        let e = Environment::prepare(&source).unwrap();
+        for p in e.specular.iter().chain(std::iter::once(&e.diffuse)).flat_map(|im| &im.rgba) {
+            assert!((p[0] - 4.0).abs() < 1e-4 && (p[1] - 2.0).abs() < 1e-4);
+        }
+        source.rgba[0][0] = f32::NAN;
+        assert!(Environment::prepare(&source).is_err());
+        source.width = usize::MAX;
+        assert!(Environment::prepare(&source).is_err());
+        let s = Settings { brightness: f32::INFINITY, roughness: -1.0, ..Default::default() }.sanitized();
+        assert_eq!(s.brightness, 1.0);
+        assert_eq!(s.roughness, 0.045);
+    }
+}
diff --git a/crates/uv/src/perspective.rs b/crates/uv/src/perspective.rs
new file mode 100644
index 0000000000000000000000000000000000000000..62e3e4b8f083584e7877e1f44dee15e1165d701f
--- /dev/null
+++ b/crates/uv/src/perspective.rs
@@ -0,0 +1,156 @@
+//! Perspective reference rasterizer: near/far clipping and perspective-correct attributes.
+use crate::{
+    Result, Scene, filled,
+    prepared::{Geometry, rotate},
+    preview::{Camera, Frame, Materials, sample},
+    topology::{Topology, barycentric},
+};
+use glam::DVec3;
+#[derive(Clone, Copy, Default)]
+struct Vertex {
+    p: DVec3,
+    uv: [f64; 2],
+    n: DVec3,
+}
+impl Vertex {
+    fn mix(self, b: Self, t: f64) -> Self {
+        Self { p: self.p.lerp(b.p, t), uv: std::array::from_fn(|i| self.uv[i] + (b.uv[i] - self.uv[i]) * t), n: self.n.lerp(b.n, t) }
+    }
+}
+fn clip(vertices: &[Vertex], plane: f64, greater: bool) -> ([Vertex; 6], usize) {
+    let mut out = [Vertex::default(); 6];
+    let mut len = 0;
+    let Some(mut a) = vertices.last().copied() else { return (out, 0) };
+    for &b in vertices {
+        let inside = |p: Vertex| if greater { p.p.z >= plane } else { p.p.z <= plane };
+        if inside(a) != inside(b) {
+            let t = (plane - a.p.z) / (b.p.z - a.p.z);
+            if let Some(v) = out.get_mut(len) {
+                *v = a.mix(b, t);
+                len += 1;
+            }
+        }
+        if inside(b)
+            && let Some(v) = out.get_mut(len)
+        {
+            *v = b;
+            len += 1;
+        }
+        a = b;
+    }
+    (out, len)
+}
+pub(crate) fn render(scene: &Scene, camera: Camera, maps: &Materials<'_>, selected: &[bool], width: usize, height: usize) -> Result<Frame> {
+    let geometry = Geometry::new(scene, &Topology::build(scene)?)?;
+    let count = width * height; // already bounded by preview::render_materials
+    let mut rgba = filled(count, [35, 35, 35, 255])?;
+    let mut triangles = filled(count, None)?;
+    let mut depth = filled(count, f64::INFINITY)?;
+    let c = geometry.camera_values(camera, [width as u32, height as u32]);
+    let light = DVec3::new(0.3, 0.6, 0.75).normalize();
+    let sign = if camera.flip_faces { -1.0 } else { 1.0 };
+    let focal = width.min(height) as f64 * 1.2;
+    for (id, t) in geometry.triangles.iter().enumerate() {
+        if maps.hidden.contains(&t.material) {
+            continue;
+        }
+        let face = DVec3::from_array(t.face.map(f64::from)) * sign;
+        let positions = t.positions.map(|p| rotate(DVec3::from_array(p.map(f64::from)), camera));
+        let camera_to_vertex =
+            DVec3::new(positions[0].x + f64::from(c[6]), positions[0].y + f64::from(c[7]), positions[0].z - f64::from(c[15]) - camera.distance());
+        if camera.cull_backfaces && rotate(face, camera).dot(camera_to_vertex) >= 0.0 {
+            continue;
+        }
+        let vertices = std::array::from_fn::<_, 3, _>(|i| Vertex {
+            p: DVec3::new(positions[i].x + f64::from(c[6]), positions[i].y + f64::from(c[7]), camera.distance() + f64::from(c[15]) - positions[i].z),
+            uv: t.uv[i].map(f64::from),
+            n: if camera.authored_normals { DVec3::from_array(t.normals[i].map(f64::from)) * sign } else { face },
+        });
+        let (near, n) = clip(&vertices, camera.near(), true);
+        let (poly, n) = clip(near.get(..n).unwrap_or_default(), camera.distance() + 2.0, false);
+        let Some(a) = poly.first().copied() else {
+            continue;
+        };
+        for pair in poly.get(1..n).unwrap_or_default().windows(2) {
+            let Some((&b, &d)) = pair.first().zip(pair.get(1)) else {
+                continue;
+            };
+            let v = [a, b, d];
+            let pts = v.map(|v| [width as f64 * 0.5 + v.p.x * focal / v.p.z, height as f64 * 0.5 - v.p.y * focal / v.p.z]);
+            let lo = [pts[0][0].min(pts[1][0]).min(pts[2][0]), pts[0][1].min(pts[1][1]).min(pts[2][1])];
+            let hi = [pts[0][0].max(pts[1][0]).max(pts[2][0]), pts[0][1].max(pts[1][1]).max(pts[2][1])];
+            let Some(material) = scene.materials.get(t.material) else {
+                continue;
+            };
+            let texture = maps.colors.get(t.material).and_then(Option::as_ref);
+            let normal_map = maps.normals.get(t.material).and_then(Option::as_ref);
+            for y in lo[1].floor().clamp(0.0, height as f64) as usize..hi[1].ceil().clamp(0.0, height as f64) as usize {
+                for x in lo[0].floor().clamp(0.0, width as f64) as usize..hi[0].ceil().clamp(0.0, width as f64) as usize {
+                    let Some(w) = barycentric([x as f64 + 0.5, y as f64 + 0.5], pts) else {
+                        continue;
+                    };
+                    let reciprocal = std::array::from_fn::<_, 3, _>(|i| w[i] / v[i].p.z);
+                    let sum = reciprocal.iter().sum::<f64>();
+                    let z = 1.0 / sum;
+                    let index = y * width + x;
+                    let Some(previous) = depth.get_mut(index) else {
+                        continue;
+                    };
+                    if z >= *previous {
+                        continue;
+                    }
+                    let w = reciprocal.map(|w| w / sum);
+                    let uv = std::array::from_fn(|axis| v.iter().zip(w).map(|(v, w)| v.uv[axis] * w).sum());
+                    let texel = texture.map_or([1.0; 4], |img| sample(img, uv));
+                    if texel[3] * material.color[3] < 0.5 {
+                        continue;
+                    }
+                    let texel =
+                        if camera.channel == super::preview::Channel::Normal { normal_map.map_or([0.5, 0.5, 1.0, 1.0], |img| sample(img, uv)) } else { texel };
+                    let mut n = v.iter().zip(w).fold(DVec3::ZERO, |n, (v, w)| n + v.n * w).normalize_or_zero();
+                    if let Some(map) = normal_map {
+                        let tangent = DVec3::from_array(t.tangent.map(f64::from));
+                        let bitangent = DVec3::from_array(t.bitangent.map(f64::from));
+                        let tangent = (tangent - n * n.dot(tangent)).normalize_or_zero();
+                        let bitangent = n.cross(tangent) * if n.cross(tangent).dot(bitangent) < 0.0 { -1.0 } else { 1.0 };
+                        let rgb = sample(map, uv);
+                        let strength = camera.normal_strength.clamp(0.0, 4.0);
+                        let bump = DVec3::new(
+                            (f64::from(rgb[0]) * 2.0 - 1.0) * strength,
+                            (f64::from(rgb[1]) * 2.0 - 1.0) * strength * if camera.flip_normal_y { -1.0 } else { 1.0 },
+                            f64::from(rgb[2]) * 2.0 - 1.0,
+                        )
+                        .normalize_or_zero();
+                        if tangent != DVec3::ZERO && bump != DVec3::ZERO {
+                            n = (tangent * bump.x + bitangent * bump.y + n * bump.z).normalize_or_zero();
+                        }
+                    }
+                    let lighting = if camera.shaded && camera.channel == super::preview::Channel::Material {
+                        (0.25 + rotate(n, camera).dot(light).max(0.0) * 0.75) as f32
+                    } else {
+                        1.0
+                    };
+                    let pixel = std::array::from_fn(|i| {
+                        let mut value = if i == 3 {
+                            1.0
+                        } else {
+                            texel[i] * if camera.channel != super::preview::Channel::Material { 1.0 } else { material.color[i] } * lighting
+                        };
+                        if i < 3 && selected.get(id).copied().unwrap_or(false) {
+                            value = value * 0.82 + [0.12, 0.55, 0.9, 0.0][i] * 0.18;
+                        }
+                        (value.clamp(0.0, 1.0) * 255.0 + 0.5) as u8
+                    });
+                    *previous = z;
+                    if let Some(p) = rgba.get_mut(index) {
+                        *p = pixel;
+                    }
+                    if let Some(p) = triangles.get_mut(index) {
+                        *p = Some(id);
+                    }
+                }
+            }
+        }
+    }
+    Ok(Frame { width, height, rgba, triangles })
+}
