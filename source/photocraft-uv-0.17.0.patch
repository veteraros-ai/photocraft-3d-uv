+pub(crate) fn mask_fill_source_bytes([width, height]: [u32; 2], max_side: u32) -> Result<u64, Unsupported> {
+    let row_width = width.div_ceil(64).checked_mul(64).ok_or_else(|| Unsupported("mask Fill image width overflows".into()))?;
