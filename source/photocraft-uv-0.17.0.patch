+    let paint_layer = |name: &str, surface| Paint {
+        name: name.into(),
+        visible: true,
+        opacity: 1.0,
+        blend: photocraft_color::BlendMode::Normal,
+        surface,
+        fill_map: None,
+        fill_map_size: [0, 0],
