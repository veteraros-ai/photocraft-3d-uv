+    #[serde(default)]
+    environment: Option<crate::uv_asset_cmds::Packed>,
+    #[serde(default)]
+    loose_documents: Vec<String>,
+}
+fn default_uv_padding() -> f64 {
+    3.0
+}
+fn validate_view(view: &Value) -> Result<()> {
+    if !view.is_null() && !view.is_object() {
+        return Err(err("Project view must be an object"));
+    }
+    let mut stack = vec![(view, 0usize)];
+    let (mut nodes, mut bytes) = (0usize, 0usize);
+    while let Some((value, depth)) = stack.pop() {
+        nodes += 1;
+        if depth > 16 || nodes > 8192 || bytes > 65536 {
+            return Err(err("Project view metadata exceeds its budget"));
+        }
+        match value {
+            Value::String(s) => bytes = bytes.saturating_add(s.len()),
+            Value::Array(a) => {
+                if a.len() > 8192 {
+                    return Err(err("Project view array is too large"));
+                }
+                stack.extend(a.iter().map(|v| (v, depth + 1)));
+            }
+            Value::Object(o) => {
+                if o.len() > 8192 {
+                    return Err(err("Project view object is too large"));
+                }
+                for (k, v) in o {
+                    bytes = bytes.saturating_add(k.len());
+                    stack.push((v, depth + 1));
+                }
+            }
+            _ => {}
+        }
+    }
+    if bytes > 65536 {
+        return Err(err("Project view metadata exceeds 64 KiB"));
+    }
+    Ok(())
+}
+fn project_save(s: &mut Session, p: &Value) -> Result<Value> {
+    let path = path(p)?;
+    if !path.to_ascii_lowercase().ends_with(".pcuv") {
+        return Err(err("UV projects must use the .pcuv extension"));
+    }
+    let explicit_view = p.get("view").is_some();
+    let view = p.get("view").unwrap_or(&s.uv.project_view);
+    validate_view(view)?;
+    let view = view.clone();
+    let count = s.uv.scene.as_ref().ok_or_else(|| err("No mesh"))?.materials.len();
+    if s.uv.bindings.len() != count || s.uv.normal_bindings.len() != count {
+        return Err(err("Invalid material bindings"));
+    }
+    if s.uv.map_bindings.values().any(|ids| ids.get(count..).is_some_and(|extra| extra.iter().any(Option::is_some))) {
+        return Err(err("Invalid auxiliary map length"));
+    }
+    if count > 4096 || s.uv.map_bindings.keys().any(|kind| matches!(kind, Channel::Material | Channel::Color | Channel::Normal)) {
+        return Err(err("Invalid material map table"));
+    }
+    let slots: Vec<_> =
+        s.uv.bindings
+            .iter()
+            .chain(&s.uv.normal_bindings)
+            .copied()
+            .chain(s.uv.map_bindings.values().flat_map(|ids| (0..count).map(move |i| ids.get(i).copied().flatten())))
+            .collect();
+    let uv_docs = s.uv_documents();
+    if slots.iter().flatten().any(|id| !uv_docs.iter().any(|doc| doc.doc.id == *id)) {
+        return Err(err("A bound UV document is missing from the UV workspace"));
+    }
+    let mut zip = photocraft_format::zip::ZipWriter::new();
+    let mut documents = Vec::new();
+    let mut saved = std::collections::BTreeMap::<u64, String>::new();
+    let mut document_paths = std::collections::BTreeMap::new();
+    let mut dirty_documents = BTreeSet::new();
+    for (i, id) in slots.iter().enumerate() {
+        if let Some(doc) = id.and_then(|id| uv_docs.iter().find(|d| d.doc.id == id)) {
+            if let Some(name) = saved.get(&doc.doc.id.0) {
+                documents.push(Some(name.clone()));
+                continue;
+            }
+            let name = format!("documents/{i}.pcraft");
+            let bytes = photocraft_format::save_to_bytes(&doc.doc, &Default::default()).map_err(|e| err(e.to_string()))?;
+            zip.add(&name, &bytes).map_err(|e| err(e.to_string()))?;
+            if let Some(path) = &doc.path {
+                document_paths.insert(name.clone(), path.clone());
+            }
+            if s.uv.needs_export(doc) {
+                dirty_documents.insert(name.clone());
+            }
+            saved.insert(doc.doc.id.0, name.clone());
+            documents.push(Some(name));
+        } else {
+            documents.push(None);
+        }
+    }
+    let mut loose_documents = Vec::new();
+    for doc in uv_docs {
+        if saved.contains_key(&doc.doc.id.0) {
+            continue;
+        }
+        let name = format!("documents/loose-{}.pcraft", loose_documents.len());
+        let bytes = photocraft_format::save_to_bytes(&doc.doc, &Default::default()).map_err(|e| err(e.to_string()))?;
+        zip.add(&name, &bytes).map_err(|e| err(e.to_string()))?;
+        if let Some(path) = &doc.path {
+            document_paths.insert(name.clone(), path.clone());
+        }
+        if s.uv.needs_export(doc) {
+            dirty_documents.insert(name.clone());
+        }
+        saved.insert(doc.doc.id.0, name.clone());
+        loose_documents.push(name);
+    }
+    let mut assets = Vec::new();
+    for asset in &s.uv.assets {
+        let entry = format!("assets/{}.bin", asset.id);
+        zip.add(&entry, &asset.source.bytes).map_err(|e| err(e.to_string()))?;
+        assets.push(crate::uv_asset_cmds::Packed { id: asset.id, name: asset.source.name.clone(), entry });
+    }
+    let environment_resource = if let Some(source) = view.get("environment").and_then(Value::as_str).filter(|v| !v.is_empty()) {
+        if s.uv.project_view.get("environment").and_then(Value::as_str) == Some(source) && s.uv.environment.is_some() {
+            s.uv.environment.clone()
+        } else if explicit_view {
+            let bytes = read_limited(source, crate::uv_asset_cmds::MAX_ASSET_BYTES)?;
+            let name = Path::new(source).file_name().map_or_else(|| "sky.exr".into(), |n| n.to_string_lossy().into_owned());
+            Some(crate::uv_asset_cmds::Resource { name, bytes: Arc::new(bytes) })
+        } else {
+            None
+        }
+    } else {
+        None
+    };
+    let environment = if let Some(resource) = &environment_resource {
+        let entry = "environment/source.bin".to_owned();
+        zip.add(&entry, &resource.bytes).map_err(|e| err(e.to_string()))?;
+        Some(crate::uv_asset_cmds::Packed { id: 0, name: resource.name.clone(), entry })
+    } else {
+        None
+    };
+    let mut extra = documents.split_off(s.uv.bindings.len() * 2);
+    let normal_documents = documents.split_off(s.uv.bindings.len());
+    let mut map_documents = std::collections::BTreeMap::new();
+    for kind in s.uv.map_bindings.keys() {
+        let tail = extra.split_off(count);
+        map_documents.insert(*kind, extra);
+        extra = tail;
+    }
+    let project = Project {
+        version: 1,
+        scene: s.uv.scene.as_deref().cloned().ok_or_else(|| err("No mesh"))?,
+        source: s.uv.source.clone(),
+        uv_set: s.uv.uv_set,
+        source_stamp: s.uv.source_stamp.clone(),
+        selected: s.uv.selected.clone(),
+        selection_documents: Some(
+            slots
+                .iter()
+                .enumerate()
+                .filter_map(|(i, id)| {
+                    id.and_then(|id| uv_docs.iter().find(|d| d.doc.id == id))
+                        .filter(|doc| s.uv.selection_masks.get(&doc.doc.id.0).is_some_and(|mask| doc.doc.selection.as_ref() == Some(mask)))
+                        .map(|_| i)
+                })
+                .collect(),
+        ),
+        material: s.uv.material,
+        guard: s.uv.guard,
+        horizontal: s.uv.horizontal,
+        vertical: s.uv.vertical,
+        feather: s.uv.feather,
+        open_borders: s.uv.open_borders,
+        padding: s.uv.padding,
+        documents,
+        normal_documents,
+        hidden_materials: s.uv.hidden_materials.clone(),
+        normal_channel: s.uv.normal_channel,
+        extra_channel: s.uv.extra_channel,
+        map_documents,
+        view: view.clone(),
+        document_paths,
+        dirty_documents: Some(dirty_documents),
+        assets,
+        environment,
+        loose_documents,
+    };
+    let manifest = serde_json::to_vec(&project).map_err(|e| err(e.to_string()))?;
+    if manifest.len() > 128 * 1024 * 1024 {
+        return Err(err("UV mesh manifest exceeds 128 MiB"));
+    }
+    zip.add("project.json", &manifest).map_err(|e| err(e.to_string()))?;
+    let bytes = zip.finish().map_err(|e| err(e.to_string()))?;
+    if bytes.len() as u64 > MAX_PROJECT_BYTES {
+        return Err(err("UV project exceeds 2 GiB; save texture documents separately"));
+    }
+    crate::file_cmds::write_file(path, &bytes)?;
+    // Checkpoints change only after the atomic container write succeeded. External
+    // exports have their own revision: saving a project never writes source textures.
+    let mut saved_state = Vec::new();
+    for st in s.uv_documents_mut() {
+        if saved.contains_key(&st.doc.id.0) {
+            saved_state.push((st.doc.id, st.saved_revision.saturating_sub(st.view_revision), st.revision.saturating_sub(st.view_revision)));
+            st.saved_revision = st.revision;
+        }
+    }
+    s.uv.saved_revisions.clear();
+    for (id, exported_revision, revision) in saved_state {
+        s.uv.exported_revisions.entry(id).or_insert(exported_revision);
+        s.uv.saved_revisions.insert(id, revision);
+    }
+    s.uv.saved_generation = s.uv.generation;
+    s.uv.project_path = path.to_owned();
+    s.uv.environment = environment_resource;
+    s.uv.project_view = view;
+    Ok(json!({"saved":path}))
+}
+fn project_load(s: &mut Session, p: &Value) -> Result<Value> {
+    let previous: Vec<_> = s.documents().iter().filter(|_| s.uv_workspace.active && s.uv.scene.is_some()).map(|st| st.doc.id).collect();
+    let bytes = read_limited(path(p)?, MAX_PROJECT_BYTES)?;
+    let zip = photocraft_format::zip::ZipReader::new(&bytes).map_err(|e| err(e.to_string()))?;
+    let json = zip.read_by_name("project.json", 128 * 1024 * 1024).map_err(|e| err(e.to_string()))?;
+    let mut project: Project = serde_json::from_slice(&json).map_err(|e| err(e.to_string()))?;
+    if project.version != 1 {
+        return Err(err("Unsupported UV project version"));
+    }
+    validate_view(&project.view)?;
+    if project.normal_documents.is_empty() {
+        project.normal_documents = vec![None; project.scene.materials.len()];
+    }
+    project.scene.validate().map_err(|e| err(e.to_string()))?;
+    let topology = Topology::build(&project.scene).map_err(|e| err(e.to_string()))?;
+    if project.uv_set > 31
+        || project.documents.len() != project.scene.materials.len()
+        || project.normal_documents.len() != project.scene.materials.len()
+        || project.hidden_materials.iter().any(|i| *i >= project.scene.materials.len())
+        || project.material >= project.scene.materials.len()
+        || project.selected.iter().any(|i| topology.shells.get(*i).is_none_or(|sh| sh.material != project.material))
+        || [project.horizontal, project.vertical].iter().any(|v| !v.is_finite() || !(0.0..=1024.0).contains(v))
+        || project.selection_documents.as_ref().is_some_and(|slots| {
+            slots.len() > project.documents.len() + project.normal_documents.len() + project.map_documents.values().map(Vec::len).sum::<usize>()
+                || slots
+                    .iter()
+                    .any(|i| *i >= project.documents.len() + project.normal_documents.len() + project.map_documents.values().map(Vec::len).sum::<usize>())
+        })
+        || !project.guard.is_finite()
+        || !(0.0..=1024.0).contains(&project.guard)
+        || !project.feather.is_finite()
+        || !(0.0..=1024.0).contains(&project.feather)
+        || !project.padding.is_finite()
+        || !(0.0..=1024.0).contains(&project.padding)
+    {
+        return Err(err("Invalid UV project state"));
+    }
+    if project.map_documents.len() > 7
+        || project
+            .map_documents
+            .iter()
+            .any(|(kind, maps)| matches!(kind, Channel::Material | Channel::Color | Channel::Normal) || maps.len() != project.documents.len())
+        || project.extra_channel.is_some_and(|kind| matches!(kind, Channel::Material | Channel::Color | Channel::Normal))
+    {
+        return Err(err("Invalid auxiliary map bindings"));
+    }
+    if project.assets.len() > 256 || project.loose_documents.len() > 4096 {
+        return Err(err("Project resource count exceeds budget"));
+    }
+    let mut assets = Vec::new();
+    let mut library_bytes = 0usize;
+    let mut asset_ids = BTreeSet::new();
+    for asset in &project.assets {
+        if !asset_ids.insert(asset.id) {
+            return Err(err("Duplicate library image id"));
+        }
+        let bytes = zip.read_by_name(&asset.entry, crate::uv_asset_cmds::MAX_ASSET_BYTES as usize).map_err(|e| err(e.to_string()))?;
+        library_bytes = library_bytes.saturating_add(bytes.len());
+        if library_bytes > crate::uv_asset_cmds::MAX_LIBRARY_BYTES {
+            return Err(err("Library exceeds 512 MiB"));
+        }
+        assets.push(crate::uv_asset_cmds::decode(asset.id, asset.name.clone(), bytes)?);
+    }
+    let environment = project
+        .environment
+        .as_ref()
+        .map(|env| -> Result<_> {
+            if env.name.len() > 4096 || env.name.contains('\0') {
+                return Err(err("Invalid environment name"));
+            }
+            let bytes = zip.read_by_name(&env.entry, crate::uv_asset_cmds::MAX_ASSET_BYTES as usize).map_err(|e| err(e.to_string()))?;
+            Ok(crate::uv_asset_cmds::Resource { name: env.name.clone(), bytes: Arc::new(bytes) })
+        })
+        .transpose()?;
+    let mut documents = Vec::new();
+    let mut decoded = BTreeSet::new();
+    let mut entries: Vec<_> = project.documents.iter().chain(&project.normal_documents).chain(project.map_documents.values().flatten()).cloned().collect();
+    let bound_count = entries.len();
+    entries.extend(project.loose_documents.iter().cloned().map(Some));
+    let mut decoded_bytes = library_bytes;
+    for entry in &entries {
+        documents.push(if let Some(name) = entry {
+            if decoded.insert(name.clone()) {
+                let bytes = zip.read_by_name(name, MAX_PROJECT_BYTES as usize).map_err(|e| err(e.to_string()))?;
+                decoded_bytes = decoded_bytes.saturating_add(bytes.len());
+                if decoded_bytes as u64 > MAX_PROJECT_BYTES {
+                    return Err(err("Expanded project exceeds 2 GiB"));
+                }
+                Some(photocraft_format::load_from_bytes(&bytes).map_err(|e| err(e.to_string()))?)
+            } else {
+                // Repeated material bindings restore the same document below. Decode
+                // it once so a small project cannot multiply a large image in memory.
+                None
+            }
+        } else {
+            None
+        });
+    }
+    for (doc, entry) in documents.iter().zip(&entries) {
+        if doc.as_ref().is_some_and(|d| d.mode != ColorMode::Rgb) && project.normal_documents.iter().any(|name| name.as_ref() == entry.as_ref()) {
+            return Err(err("Normal maps must use RGB mode"));
+        }
+    }
+    let mut blocked_exports = std::collections::HashSet::new();
+    let mut restored = std::collections::BTreeMap::new();
+    let mut exported_revisions = std::collections::HashMap::new();
+    let mut saved_revisions = std::collections::HashMap::new();
+    let mut bindings: Vec<Option<DocId>> = documents
+        .into_iter()
+        .zip(entries)
+        .map(|(doc, name)| {
+            if let Some(id) = name.as_ref().and_then(|name| restored.get(name)).copied() {
+                return Some(id);
+            }
+            doc.and_then(|doc| {
+                let source = name.as_ref().and_then(|name| project.document_paths.get(name)).filter(|p| p.len() <= 32768 && !p.contains('\0')).cloned();
+                // Legacy projects did not track external writeback. A linked embedded
+                // texture needs one writeback; saving .pcuv alone never wrote its map file.
+                let writeback = project.dirty_documents.as_ref().map_or(source.is_some(), |dirty| name.as_ref().is_some_and(|name| dirty.contains(name)));
+                let external = source.as_ref().is_some_and(|source| {
+                    !Path::new(source)
+                        .canonicalize()
+                        .ok()
+                        .zip(Path::new(path(p).unwrap_or("")).parent().and_then(|p| p.canonicalize().ok()))
+                        .is_some_and(|(file, base)| file.starts_with(base) && file.is_file())
+                });
+                let index = s.add_document(doc, source);
+                if external && let Some(st) = s.docs.get(index) {
+                    blocked_exports.insert(st.doc.id);
+                }
+                if let Some(st) = s.docs.get(index) {
+                    exported_revisions.insert(st.doc.id, if writeback { 0 } else { st.revision });
+                    saved_revisions.insert(st.doc.id, st.revision);
+                }
+                let id = s.documents().get(index).map(|d| d.doc.id);
+                if let (Some(name), Some(id)) = (name, id) {
+                    restored.insert(name.clone(), id);
+                }
+                id
+            })
+        })
+        .collect();
+    bindings.truncate(bound_count);
+    let mut extra = bindings.split_off(project.documents.len() * 2);
+    let normal_bindings = bindings.split_off(project.documents.len());
+    let mut map_bindings = std::collections::BTreeMap::new();
+    for kind in project.map_documents.keys() {
+        let tail = extra.split_off(project.documents.len());
+        map_bindings.insert(*kind, extra);
+        extra = tail;
+    }
+    let scene = Arc::new(project.scene);
+    let wrap_mesh = photocraft_uv::wrap::Mesh::new(&scene).ok().map(Arc::new);
+    s.uv = UvState {
+        blocked_exports,
+        project_view: project.view,
+        project_path: path(p)?.to_owned(),
+        assets,
+        environment,
+        exported_revisions,
+        saved_revisions,
+        saved_generation: s.uv.generation.wrapping_add(1),
+        wrap_mesh,
+        wrapped_stroke: None,
+        scene: Some(scene),
+        topology: Some(Arc::new(topology)),
+        source: project.source,
+        uv_set: project.uv_set,
+        source_stamp: project.source_stamp,
+        normal_bindings,
+        hidden_materials: project.hidden_materials,
+        normal_channel: project.normal_channel,
+        extra_channel: project.extra_channel,
+        map_bindings,
+        selected: project.selected,
+        selection_masks: Default::default(),
+        padding_cache_scene: None,
+        occupancy_cache: Default::default(),
+        padding_cache: Default::default(),
+        bindings,
+        material: project.material,
+        guard: project.guard,
+        horizontal: project.horizontal,
+        vertical: project.vertical,
+        feather: project.feather,
+        open_borders: project.open_borders,
+        padding: project.padding,
+        generation: s.uv.generation.wrapping_add(1),
+    };
+    let slots = project
+        .selection_documents
+        .unwrap_or_else(|| if s.uv.selected.is_empty() { Vec::new() } else { vec![s.uv.material + if s.uv.normal_channel { s.uv.bindings.len() } else { 0 }] });
+    let ids: Vec<_> = s.uv.all_bindings().copied().collect();
+    for slot in slots {
+        if let Some(id) = ids.get(slot).copied().flatten()
+            && let Some(mask) = s.documents().iter().find(|d| d.doc.id == id).and_then(|d| d.doc.selection.clone())
+        {
+            s.uv.selection_masks.insert(id.0, mask);
+        }
+    }
+    for id in previous {
+        if let Some(index) = s.documents().iter().position(|st| st.doc.id == id) {
+            s.close(index);
+        }
+    }
+    let _ = activate(s, s.uv.material);
+    let mut result = inspect(s, &Value::Null)?;
+    result["view"] = s.uv.project_view.clone();
+    Ok(result)
+}
+
+pub fn specs() -> Vec<CommandSpec> {
+    let spec = |id, label, params, enabled, run| CommandSpec { id, label, params, enabled, run, menu: &[], shortcut: None, journal: id != "uv.inspect" };
+    vec![
+        spec("uv.model.import", "Import UV model", r#"{"path":string,"uvSet":int=0}"#, crate::commands::always, import),
+        spec(
+            "uv.settings",
+            "UV seam protection settings",
+            r#"{"guard":px,"horizontal":px,"vertical":px,"feather":px,"openBorders":bool,"padding":px=3}"#,
+            mesh,
+            settings,
+        ),
+        spec(
+            "uv.material.select",
+            "Select material channel",
+            r#"{"material":int,"channel":"baseColor|normal|id|ao|curvature|opacity|metallic|roughness|emissive"}"#,
+            mesh,
+            material_select,
+        ),
+        spec("uv.material.visible", "Show or hide material", r#"{"material":int,"visible":bool}"#, mesh, material_visible),
+        spec("uv.inspect", "Inspect UV model", "{}", mesh, inspect),
+        spec(
+            "uv.texture.open",
+            "Open material texture",
+            r#"{"path":string,"material":int,"channel":"baseColor|normal|id|ao|curvature|opacity|metallic|roughness|emissive"}"#,
+            mesh,
+            texture_open,
+        ),
+        spec(
+            "uv.texture.create",
+            "Create material texture",
+            r#"{"material":int,"channel":"baseColor|normal|id|ao|curvature|opacity|metallic|roughness|emissive","width":int=1024,"height":int=1024,"depth":8|16|32=8}"#,
+            mesh,
+            texture_create,
+        ),
+        spec(
+            "uv.texture.bind",
+            "Use active document as material texture",
+            r#"{"material":int,"channel":"baseColor|normal|id|ao|curvature|opacity|metallic|roughness|emissive"}"#,
+            mesh,
+            texture_bind,
+        ),
+        spec("uv.shell.select", "Select UV shells", r#"{"shells":[int],"material":int,"mode":"replace|add|subtract|intersect"}"#, mesh, select),
+        spec(
+            "uv.mask.apply",
+            "Apply protected UV selection",
+            r#"{"material":int,"guard":px=0,"feather":px=0,"openBorders":bool=false,"padding":px=3}"#,
+            mesh,
+            apply_mask,
+        ),
+        spec(
+            "uv.layer.create",
+            "Create protected UV paint layer",
+            r#"{"material":int,"guard":px=0,"feather":px=0,"openBorders":bool=false}"#,
+            mesh,
+            paint_layer,
+        ),
+        spec("uv.project.save", "Save UV project", r#"{"path":string,"view":object?}"#, mesh, project_save),
+        spec("uv.project.load", "Open UV project", r#"{"path":string}"#, crate::commands::always, project_load),
+    ]
+}
+
+#[cfg(test)]
+mod asset_path_tests {
+    #[test]
+    fn model_references_cannot_escape_the_asset_directory() {
+        let root = tempfile::tempdir().unwrap();
+        let assets = root.path().join("assets");
+        std::fs::create_dir(&assets).unwrap();
+        let model = assets.join("mesh.obj");
+        std::fs::write(&model, "").unwrap();
+        std::fs::write(assets.join("map.png"), "map").unwrap();
+        std::fs::write(root.path().join("outside.png"), "outside").unwrap();
+        let source = model.to_str().unwrap();
+        assert!(!super::resolved(source, "map.png").is_empty());
+        assert!(super::resolved(source, "../outside.png").is_empty());
+        assert!(super::resolved(source, root.path().join("outside.png").to_str().unwrap()).is_empty());
+        assert!(super::resolved(source, ".").is_empty());
+    }
+}
diff --git a/crates/engine/src/uv_mask_paint_cmds.rs b/crates/engine/src/uv_mask_paint_cmds.rs
new file mode 100644
index 000000000..36021391f
--- /dev/null
+++ b/crates/engine/src/uv_mask_paint_cmds.rs
@@ -0,0 +1,599 @@
+//! Experimental, local-only editable mask brush stacks for the UV workspace.
+use crate::{EngineError, Result, Session, commands::CommandSpec};
+use photocraft_color::BlendMode;
+use photocraft_doc::{
+    LayerId,
+    mask_paint::{EffectKind, Paint, Stack},
+};
+use photocraft_raster::Surface;
+use serde_json::{Value, json};
+
+fn bad(message: &str) -> EngineError {
+    EngineError::Other(message.into())
+}
+fn mask_blend(value: &str) -> Option<BlendMode> {
+    let mode = match value {
+        "normal" => BlendMode::Normal,
+        "darken" => BlendMode::Darken,
+        "multiply" => BlendMode::Multiply,
+        "lighten" => BlendMode::Lighten,
+        "screen" => BlendMode::Screen,
+        "linear_dodge" => BlendMode::LinearDodge,
+        "subtract" => BlendMode::Subtract,
+        "difference" => BlendMode::Difference,
+        _ => return None,
+    };
+    photocraft_doc::mask_paint::is_mask_blend_mode(mode).then_some(mode)
+}
+fn blend_param(p: &Value) -> Result<BlendMode> {
+    p.get("blend")
+        .map(|value| value.as_str().and_then(mask_blend).ok_or_else(|| bad("Invalid grayscale mask blend mode")))
+        .transpose()
+        .map(|mode| mode.unwrap_or(BlendMode::Normal))
+}
+fn radius_param(p: &Value, default: u8) -> Result<u8> {
+    p.get("radius")
+        .map(|value| {
+            value
+                .as_u64()
+                .and_then(|v| u8::try_from(v).ok())
+                .filter(|v| (1..=64).contains(v))
+                .ok_or_else(|| bad("Blur radius must be an integer from 1 to 64 pixels"))
+        })
+        .transpose()
+        .map(|radius| radius.unwrap_or(default))
+}
+fn target(s: &Session, p: &Value) -> Result<LayerId> {
+    let st = s.active().ok_or(EngineError::NoDocument)?;
+    let id = p.get("layer").and_then(Value::as_u64).map(LayerId).or(st.active_layer).ok_or_else(|| bad("Select a masked layer"))?;
+    let l = st.doc.layer(id).ok_or(EngineError::NoLayer(id))?;
+    if l.mask.is_none() {
+        return Err(bad("Layer has no mask"));
+    }
+    if st.doc.effective_locks(id).all {
+        return Err(bad("Layer is locked"));
+    }
+    Ok(id)
+}
+fn index(p: &Value) -> Result<usize> {
+    p.get("index").and_then(Value::as_u64).and_then(|n| usize::try_from(n).ok()).ok_or_else(|| bad("Invalid paint layer index"))
+}
+fn unit_param(p: &Value, key: &str, default: f32) -> Result<f32> {
+    p.get(key)
+        .map(|v| v.as_f64().filter(|n| n.is_finite() && (0.0..=1.0).contains(n)).map(|n| n as f32).ok_or_else(|| bad("Effect values must be between 0 and 1")))
+        .transpose()
+        .map(|v| v.unwrap_or(default))
+}
+fn gamma_param(p: &Value) -> Result<f32> {
+    p.get("gamma")
+        .map(|v| v.as_f64().filter(|n| n.is_finite() && (0.01..=100.0).contains(n)).map(|n| n as f32).ok_or_else(|| bad("Gamma must be between 0.01 and 100")))
+        .transpose()
+        .map(|v| v.unwrap_or(1.0))
+}
+fn rotation_param(p: &Value) -> Result<f32> {
+    p.get("rotation")
+        .map(|v| {
+            v.as_f64()
+                .filter(|n| n.is_finite() && (-36_000.0..=36_000.0).contains(n))
+                .map(|n| n as f32)
+                .ok_or_else(|| bad("Fill rotation must be between -36000 and 36000 degrees"))
+        })
+        .transpose()
+        .map(|v| v.unwrap_or(0.0))
+}
+fn bool_param(p: &Value, key: &str, default: bool) -> Result<bool> {
+    p.get(key)
+        .map(|value| value.as_bool().ok_or_else(|| bad("Fill repeat and mirror options must be boolean")))
+        .transpose()
+        .map(|value| value.unwrap_or(default))
+}
+fn validate_effect(effect: &EffectKind) -> Result<()> {
+    match effect {
+        EffectKind::Paint => Ok(()),
+        EffectKind::Fill { value, rotation, .. } if value.is_finite() && (0.0..=1.0).contains(value) && rotation.is_finite() => Ok(()),
+        EffectKind::Fill { .. } => Err(bad("Fill value must be between 0 and 1 and rotation must be finite")),
+        EffectKind::Levels { input_black, gamma, input_white, output_black, output_white }
+            if input_black.is_finite()
+                && gamma.is_finite()
+                && input_white.is_finite()
+                && output_black.is_finite()
+                && output_white.is_finite()
+                && (0.0..=1.0).contains(input_black)
+                && (0.01..=100.0).contains(gamma)
+                && (0.0..=1.0).contains(input_white)
+                && (0.0..=1.0).contains(output_black)
+                && (0.0..=1.0).contains(output_white)
+                && input_black < input_white
+                && output_black <= output_white =>
+        {
+            Ok(())
+        }
+        EffectKind::Levels { .. } => Err(bad("Invalid Levels range")),
+        EffectKind::Blur { radius } if (1..=64).contains(radius) => Ok(()),
+        EffectKind::Blur { .. } => Err(bad("Blur radius must be between 1 and 64 pixels")),
+    }
+}
+fn validate_blur_budget(layers: &[Paint]) -> Result<()> {
+    let total = layers
+        .iter()
+        .filter_map(|layer| match &layer.kind {
+            EffectKind::Blur { radius } => Some(u32::from(*radius)),
+            _ => None,
+        })
+        .fold(0u32, u32::saturating_add);
+    if total > u32::from(photocraft_doc::mask_paint::MAX_BLUR_RADIUS_SUM) {
+        return Err(bad("The combined Blur radius in a mask stack cannot exceed 512 pixels"));
+    }
+    Ok(())
+}
+fn has_any(p: &Value, keys: &[&str]) -> bool {
+    keys.iter().any(|key| p.get(key).is_some())
+}
+fn add(s: &mut Session, p: &Value) -> Result<Value> {
+    let id = target(s, p)?;
+    let canvas = s.active().ok_or(EngineError::NoDocument)?.doc.bounds();
+    let from_selection = p.get("from_selection").and_then(Value::as_bool).unwrap_or(false);
+    let selection = if from_selection { Some(s.active().and_then(|st| st.doc.selection.clone()).ok_or_else(|| bad("Make a selection first"))?) } else { None };
+    let kind = p.get("kind").and_then(Value::as_str).unwrap_or("paint").to_owned();
+    let blend_supplied = p.get("blend").is_some();
+    let radius_supplied = p.get("radius").is_some();
+    let blend = blend_param(p)?;
+    let radius = radius_param(p, 8)?;
+    let default_name = match kind.as_str() {
+        "fill" => "Fill",
+        "levels" => "Levels",
+        "blur" => "Blur",
+        _ => "Paint",
+    };
+    let name = p.get("name").and_then(Value::as_str).unwrap_or(default_name).chars().take(128).collect::<String>();
+    let result = s.edit("Add mask Paint layer", |doc, active| {
+        let canvas = doc.bounds();
+        let mask = doc.layer_mut(id).and_then(|l| l.mask.as_mut()).ok_or_else(|| bad("Layer has no mask"))?;
+        let format = photocraft_color::PixelFormat::RGBA8.with_sample(mask.surface.format().sample);
+        let base = mask.surface.clone();
+        let stack = mask.paint.get_or_insert_with(|| Stack { base, layers: Vec::new(), active: 0 });
+        if stack.layers.len() >= 256 {
+            return Err(bad("Mask supports up to 256 Paint layers"));
+        }
+        let surface = Surface::new(format);
+        let effect = match kind.as_str() {
+            "paint" => EffectKind::Paint,
+            "fill" => EffectKind::Fill {
+                value: unit_param(p, "value", 1.0)?,
+                rotation: rotation_param(p)?,
+                repeat_u: bool_param(p, "repeat_u", true)?,
+                repeat_v: bool_param(p, "repeat_v", true)?,
+                mirror_u: bool_param(p, "mirror_u", false)?,
+                mirror_v: bool_param(p, "mirror_v", false)?,
+            },
+            "levels" => EffectKind::Levels {
+                input_black: unit_param(p, "input_black", 0.0)?,
+                gamma: gamma_param(p)?,
+                input_white: unit_param(p, "input_white", 1.0)?,
+                output_black: unit_param(p, "output_black", 0.0)?,
+                output_white: unit_param(p, "output_white", 1.0)?,
+            },
+            "blur" => EffectKind::Blur { radius },
+            _ => return Err(bad("Kind must be paint, fill, levels, or blur")),
+        };
+        validate_effect(&effect)?;
+        if blend_supplied && !matches!(&effect, EffectKind::Paint | EffectKind::Fill { .. } | EffectKind::Blur { .. }) {
+            return Err(bad("Blend mode applies only to Paint, Fill, and Blur mask layers"));
+        }
+        if radius_supplied && !matches!(&effect, EffectKind::Blur { .. }) {
+            return Err(bad("Radius applies only to Blur mask layers"));
+        }
+        match &effect {
+            EffectKind::Paint
+                if has_any(
+                    p,
+                    &[
+                        "value",
+                        "rotation",
+                        "repeat_u",
+                        "repeat_v",
+                        "mirror_u",
+                        "mirror_v",
+                        "input_black",
+                        "gamma",
+                        "input_white",
+                        "output_black",
+                        "output_white",
+                    ],
+                ) =>
+            {
+                return Err(bad("Effect settings do not apply to Paint layers"));
+            }
+            EffectKind::Fill { .. } if has_any(p, &["input_black", "gamma", "input_white", "output_black", "output_white"]) => {
+                return Err(bad("Levels settings do not apply to Fill layers"));
+            }
+            EffectKind::Levels { .. } if has_any(p, &["value", "rotation", "repeat_u", "repeat_v", "mirror_u", "mirror_v"]) => {
+                return Err(bad("Fill settings do not apply to Levels layers"));
+            }
+            _ => {}
+        }
+        let (fill_map, fill_map_size, fill_bounds) = if matches!(&effect, EffectKind::Fill { .. }) {
+            if let Some(selection) = &selection {
+                let bounds = selection.content_bounds().intersect(&canvas);
+                if bounds.is_empty() {
+                    return Err(bad("The selection is empty"));
+                }
+                let width = bounds.width();
+                let height = bounds.height();
+                if u64::from(width) * u64::from(height) > 64_000_000 {
+                    return Err(bad("Fill selections must contain at most 64 million pixels"));
+                }
+                let mut map = Surface::with_default(format, &[0.0, 0.0, 0.0, 1.0]);
+                for y0 in (bounds.y0..bounds.y1).step_by(256) {
+                    let y1 = y0.saturating_add(256).min(bounds.y1);
+                    let pixel_count = (width as usize)
+                        .checked_mul((y1 - y0) as usize)
+                        .and_then(|count| count.checked_mul(4))
+                        .ok_or_else(|| bad("Fill selection is too large"))?;
+                    let mut pixels = Vec::new();
+                    pixels.try_reserve_exact(pixel_count).map_err(|_| bad("Could not allocate Fill selection band"))?;
+                    for y in y0..y1 {
+                        for x in bounds.x0..bounds.x1 {
+                            let value = selection.sample_channel(x, y, 0).clamp(0.0, 1.0);
+                            pixels.extend_from_slice(&[value, value, value, 1.0]);
+                        }
+                    }
+                    let band = photocraft_geom::Rect::new(0, y0 - bounds.y0, width as i32, y1 - bounds.y0);
+                    map.try_write_region(band, &pixels).map_err(EngineError::from)?;
+                }
+                (Some(map), [width, height], Some([bounds.x0, bounds.y0, bounds.x1, bounds.y1]))
+            } else {
+                (None, [0, 0], Some([canvas.x0, canvas.y0, canvas.x1, canvas.y1]))
+            }
+        } else {
+            (None, [0, 0], None)
+        };
+        stack.layers.push(Paint { name, visible: true, opacity: 1.0, blend, surface, fill_map, fill_map_size, fill_bounds, kind: effect });
+        validate_blur_budget(&stack.layers)?;
+        stack.active = stack.layers.len().saturating_sub(1);
+        *active = Some(id);
+        Ok(json!({"index":stack.active}))
+    })?;
+    // In Gray mask view, the displayed image is the evaluated mask stack itself.
+    // Adding an effect can therefore change pixels even when the ordinary layer
+    // compositor reports empty damage (for example, an empty layer with a Fill).
+    // Invalidate the whole canvas so the UV mask preview cannot retain stale pixels.
+    if let Some(state) = s.active_mut() {
+        state.last_damage = Some(canvas);
+    }
+    Ok(result)
+}
+fn select(s: &mut Session, p: &Value) -> Result<Value> {
+    let id = target(s, p)?;
+    let index = index(p)?;
+    let st = s.active_mut().ok_or(EngineError::NoDocument)?;
+    let mask = std::sync::Arc::make_mut(&mut st.doc).layer_mut(id).and_then(|l| l.mask.as_mut()).ok_or_else(|| bad("Layer has no mask"))?;
+    let stack = mask.paint.as_mut().ok_or_else(|| bad("Mask has no Paint layers"))?;
+    if index >= stack.layers.len() {
+        return Err(bad("Paint layer is out of range"));
+    }
+    stack.active = index;
+    st.active_layer = Some(id);
+    Ok(Value::Null)
+}
+fn modify(s: &mut Session, p: &Value) -> Result<Value> {
+    let id = target(s, p)?;
+    let index = index(p)?;
+    let opacity = p
+        .get("opacity")
+        .map(|v| v.as_f64().filter(|n| n.is_finite() && (0.0..=1.0).contains(n)).ok_or_else(|| bad("Opacity must be between 0 and 1")))
+        .transpose()?;
+    let visible = p.get("visible").map(|v| v.as_bool().ok_or_else(|| bad("Visibility must be boolean"))).transpose()?;
+    let destination = p.get("to").map(|v| v.as_u64().and_then(|n| usize::try_from(n).ok()).ok_or_else(|| bad("Invalid destination"))).transpose()?;
+    let remove = p.get("remove").and_then(Value::as_bool).unwrap_or(false);
+    let clear_fill_map = p.get("clear_fill_map").map(|v| v.as_bool().ok_or_else(|| bad("clear_fill_map must be boolean"))).transpose()?.unwrap_or(false);
+    let fill_value = p.get("value").map(|_| unit_param(p, "value", 0.0)).transpose()?;
+    let rotation = p.get("rotation").map(|_| rotation_param(p)).transpose()?;
+    let repeat_u = p.get("repeat_u").map(|_| bool_param(p, "repeat_u", true)).transpose()?;
+    let repeat_v = p.get("repeat_v").map(|_| bool_param(p, "repeat_v", true)).transpose()?;
+    let mirror_u = p.get("mirror_u").map(|_| bool_param(p, "mirror_u", false)).transpose()?;
+    let mirror_v = p.get("mirror_v").map(|_| bool_param(p, "mirror_v", false)).transpose()?;
+    let input_black = p.get("input_black").map(|_| unit_param(p, "input_black", 0.0)).transpose()?;
+    let input_white = p.get("input_white").map(|_| unit_param(p, "input_white", 1.0)).transpose()?;
+    let output_black = p.get("output_black").map(|_| unit_param(p, "output_black", 0.0)).transpose()?;
+    let output_white = p.get("output_white").map(|_| unit_param(p, "output_white", 1.0)).transpose()?;
+    let gamma = p.get("gamma").map(|_| gamma_param(p)).transpose()?;
+    let blend = p.get("blend").map(|_| blend_param(p)).transpose()?;
+    let radius = p.get("radius").map(|_| radius_param(p, 8)).transpose()?;
+    let bounds = p
+        .get("bounds")
+        .and_then(Value::as_array)
+        .map(|v| {
+            if v.len() != 4 {
+                return Err(bad("Fill bounds require four coordinates"));
+            }
+            let mut out = [0i32; 4];
+            for (i, x) in v.iter().enumerate() {
+                out[i] = i32::try_from(x.as_i64().ok_or_else(|| bad("Invalid fill bounds"))?).map_err(|_| bad("Invalid fill bounds"))?;
+            }
+            if out[2] <= out[0] || out[3] <= out[1] {
+                return Err(bad("Fill bounds must have positive size"));
+            }
+            Ok(out)
+        })
+        .transpose()?;
+    let effect_changed = fill_value.is_some()
+        || rotation.is_some()
+        || repeat_u.is_some()
+        || repeat_v.is_some()
+        || mirror_u.is_some()
+        || mirror_v.is_some()
+        || input_black.is_some()
+        || input_white.is_some()
+        || output_black.is_some()
+        || output_white.is_some()
+        || gamma.is_some()
+        || bounds.is_some()
+        || clear_fill_map;
+    let effect_changed = effect_changed || blend.is_some() || radius.is_some();
+    let mut damage = photocraft_geom::Rect::EMPTY;
+    let result = s.edit("Edit mask Paint layer", |doc, _| {
+        let canvas = doc.bounds();
+        let mask = doc.layer_mut(id).and_then(|l| l.mask.as_mut()).ok_or_else(|| bad("Layer has no mask"))?;
+        let stack = mask.paint.as_mut().ok_or_else(|| bad("Mask has no Paint layers"))?;
+        if destination.is_some_and(|to| to >= stack.layers.len()) {
+            return Err(bad("Destination is out of range"));
+        }
+        if opacity.is_some() || visible.is_some() || remove || destination.is_some() || effect_changed {
+            // A Paint edit can change pixels beyond its own surface bounds when Blur layers
+            // follow it. Use the old stack here so hiding/removing/moving the Paint reports the
+            // pixels its former downstream Blurs used to influence as well.
+            let blur_reach = if destination.is_none() && matches!(stack.layers.get(index).map(|paint| &paint.kind), Some(EffectKind::Paint)) {
+                photocraft_compose::mask_paint::downstream_blur_reach(stack, index)
+            } else {
+                0
+            };
+            let affected = if destination.is_some() { stack.layers.iter().collect::<Vec<_>>() } else { stack.layers.get(index).into_iter().collect() };
+            for paint in affected {
+                let bounds = if !matches!(&paint.kind, EffectKind::Paint) || paint.surface.default_pixel().get(3).is_some_and(|a| *a != 0.0) {
+                    canvas
+                } else {
+                    paint.surface.content_bounds()
+                };
+                damage = damage.union(&bounds);
+            }
+            if !damage.is_empty() {
+                let feather = (mask.feather.max(0.0) * 3.0).ceil().min(100_000.0) as i32;
+                damage = damage.inflate(feather.saturating_add(blur_reach)).intersect(&canvas);
+            }
+        }
+        let paint = stack.layers.get_mut(index).ok_or_else(|| bad("Paint layer is out of range"))?;
+        if let Some(value) = opacity {
+            paint.opacity = value as f32;
+        }
+        if let Some(value) = visible {
+            paint.visible = value;
+        }
+        if let Some(value) = blend {
+            paint.blend = value;
+        }
+        if let Some(name) = p.get("name").and_then(Value::as_str) {
+            paint.name = name.chars().take(128).collect();
+        }
+        match &mut paint.kind {
+            EffectKind::Fill {
+                value,
+                rotation: fill_rotation,
+                repeat_u: fill_repeat_u,
+                repeat_v: fill_repeat_v,
+                mirror_u: fill_mirror_u,
+                mirror_v: fill_mirror_v,
+            } => {
+                if input_black.is_some() || gamma.is_some() || input_white.is_some() || output_black.is_some() || output_white.is_some() || radius.is_some() {
+                    return Err(bad("Levels and Blur settings do not apply to Fill layers"));
+                }
+                if let Some(next) = fill_value {
+                    *value = next;
+                }
+                if let Some(next) = rotation {
+                    *fill_rotation = next;
+                }
+                if let Some(next) = repeat_u {
+                    *fill_repeat_u = next;
+                }
+                if let Some(next) = repeat_v {
+                    *fill_repeat_v = next;
+                }
+                if let Some(next) = mirror_u {
+                    *fill_mirror_u = next;
+                }
+                if let Some(next) = mirror_v {
+                    *fill_mirror_v = next;
+                }
+                if let Some(next) = bounds {
+                    paint.fill_bounds = Some(next);
+                }
+                if clear_fill_map {
+                    paint.fill_map = None;
+                    paint.fill_map_size = [0, 0];
+                }
+            }
+            EffectKind::Levels { input_black: ib, gamma: g, input_white: iw, output_black: ob, output_white: ow } => {
+                if blend.is_some() {
+                    return Err(bad("Blend mode does not apply to Levels mask layers"));
+                }
+                if fill_value.is_some()
+                    || rotation.is_some()
+                    || repeat_u.is_some()
+                    || repeat_v.is_some()
+                    || mirror_u.is_some()
+                    || mirror_v.is_some()
+                    || bounds.is_some()
+                    || clear_fill_map
+                    || radius.is_some()
+                {
+                    return Err(bad("Fill and Blur settings do not apply to Levels layers"));
+                }
+                if let Some(next) = input_black {
+                    *ib = next;
+                }
+                if let Some(next) = gamma {
+                    *g = next;
+                }
+                if let Some(next) = input_white {
+                    *iw = next;
+                }
+                if let Some(next) = output_black {
+                    *ob = next;
+                }
+                if let Some(next) = output_white {
+                    *ow = next;
+                }
+            }
+            EffectKind::Paint => {
+                if fill_value.is_some()
+                    || rotation.is_some()
+                    || repeat_u.is_some()
+                    || repeat_v.is_some()
+                    || mirror_u.is_some()
+                    || mirror_v.is_some()
+                    || bounds.is_some()
+                    || input_black.is_some()
+                    || gamma.is_some()
+                    || input_white.is_some()
+                    || output_black.is_some()
+                    || output_white.is_some()
+                    || clear_fill_map
+                    || radius.is_some()
+                {
+                    return Err(bad("Effect settings do not apply to Paint layers"));
+                }
+            }
+            EffectKind::Blur { radius: current } => {
+                if fill_value.is_some()
+                    || rotation.is_some()
+                    || repeat_u.is_some()
+                    || repeat_v.is_some()
+                    || mirror_u.is_some()
+                    || mirror_v.is_some()
+                    || bounds.is_some()
+                    || input_black.is_some()
+                    || gamma.is_some()
+                    || input_white.is_some()
+                    || output_black.is_some()
+                    || output_white.is_some()
+                    || clear_fill_map
+                {
+                    return Err(bad("Effect settings do not apply to Blur layers"));
+                }
+                if let Some(next) = radius {
+                    *current = next;
+                }
+            }
+        }
+        validate_effect(&paint.kind)?;
+        if remove {
+            stack.layers.remove(index);
+            stack.active = if stack.layers.is_empty() {
+                0
+            } else if index < stack.active {
+                stack.active - 1
+            } else {
+                stack.active.min(stack.layers.len() - 1)
+            };
+        } else if let Some(to) = destination {
+            let selected = stack.active;
+            let paint = stack.layers.remove(index);
+            stack.layers.insert(to, paint);
+            stack.active = if selected == index {
+                to
+            } else if index < selected && to >= selected {
+                selected.saturating_sub(1)
+            } else if index > selected && to <= selected {
+                selected.saturating_add(1)
+            } else {
+                selected
+            };
+        }
+        if mask.paint.as_ref().is_some_and(|s| s.layers.is_empty()) {
+            // No other paint remains: restore the original mask without a full blend pass.
+            if let Some(stack) = &mask.paint {
+                mask.surface = stack.base.clone();
+            }
+            mask.paint = None;
+        }
+        if let Some(stack) = &mask.paint {
+            validate_blur_budget(&stack.layers)?;
+        }
+        Ok(Value::Null)
+    })?;
+    if let Some(st) = s.active_mut() {
+        st.last_damage = Some(damage);
+    }
+    Ok(result)
+}
+fn fill_source(s: &mut Session, p: &Value) -> Result<Value> {
+    let id = target(s, p)?;
+    let index = index(p)?;
+    let asset_id = p.get("asset").and_then(Value::as_u64).ok_or_else(|| bad("Choose an image from the library"))?;
+    let asset = s.uv.assets.iter().find(|a| a.id == asset_id).ok_or_else(|| bad("Image is no longer in the library"))?;
+    let [width, height] = [asset.document.size.width, asset.document.size.height];
+    if width == 0 || height == 0 || u64::from(width) * u64::from(height) > 64_000_000 {
+        return Err(bad("Fill images must contain at most 64 million pixels"));
+    }
+    let format = photocraft_color::PixelFormat::RGBA8;
+    let mut map = Surface::with_default(format, &[0.0, 0.0, 0.0, 1.0]);
+    let canvas = asset.document.bounds();
+    let mut x = canvas.x0;
+    while x < canvas.x1 {
+        let slab = photocraft_geom::Rect::new(x, canvas.y0, x.saturating_add(4096).min(canvas.x1), canvas.y1);
+        photocraft_compose::render_bands(&asset.document, slab, 256, |band| -> Result<()> {
+            let rgba = band
+                .px
+                .iter()
+                .flat_map(|pixel| {
+                    let gray = (pixel[0] * 0.2126 + pixel[1] * 0.7152 + pixel[2] * 0.0722).clamp(0.0, 1.0);
+                    [gray, gray, gray, 1.0]
+                })
+                .collect::<Vec<_>>();
+            map.try_write_region(band.rect, &rgba).map_err(EngineError::from)?;
+            Ok(())
+        })?;
+        x = slab.x1;
+    }
+    s.edit("Set Fill image", |doc, _| {
+        let canvas = doc.bounds();
+        let mask = doc.layer_mut(id).and_then(|l| l.mask.as_mut()).ok_or_else(|| bad("Layer has no mask"))?;
+        let stack = mask.paint.as_mut().ok_or_else(|| bad("Mask has no effect layers"))?;
+        let fill = stack.layers.get_mut(index).ok_or_else(|| bad("Effect layer is out of range"))?;
+        if !matches!(&fill.kind, EffectKind::Fill { .. }) {
+            return Err(bad("Select a Fill layer first"));
+        }
+        fill.fill_map = Some(map);
+        fill.fill_map_size = [width, height];
+        if fill.fill_bounds.is_none() {
+            fill.fill_bounds = Some([canvas.x0, canvas.y0, canvas.x1, canvas.y1]);
+        }
+        Ok(Value::Null)
+    })
+}
+pub fn specs() -> Vec<CommandSpec> {
+    [
+        ("uv.maskPaint.add", "Add mask stack layer", r#"{"layer":id?,"name":string?,"kind":"paint"|"fill"|"levels"|"blur"?,"blend":"normal"|"darken"|"multiply"|"lighten"|"screen"|"linear_dodge"|"subtract"|"difference"?,"radius":1..64?,"value":number?,"rotation":degrees?,"from_selection":bool?,"repeat_u":bool?,"repeat_v":bool?,"mirror_u":bool?,"mirror_v":bool?,"input_black":number?,"gamma":number?,"input_white":number?,"output_black":number?,"output_white":number?}"#, add as fn(&mut Session, &Value) -> Result<Value>),
+        ("uv.maskPaint.select", "Select mask Paint layer", r#"{"layer":id?,"index":int}"#, select),
+        ("uv.maskPaint.fillSource", "Set Fill image", r#"{"layer":id?,"index":int,"asset":int}"#, fill_source),
+        (
+            "uv.maskPaint.modify",
+            "Edit mask Paint layer",
+            r#"{"layer":id?,"index":int,"visible":bool?,"opacity":number?,"name":string?,"to":int?,"remove":bool?,"blend":"normal"|"darken"|"multiply"|"lighten"|"screen"|"linear_dodge"|"subtract"|"difference"?,"radius":1..64?,"value":number?,"rotation":degrees?,"bounds":[i32,i32,i32,i32]?,"repeat_u":bool?,"repeat_v":bool?,"mirror_u":bool?,"mirror_v":bool?,"clear_fill_map":bool?,"input_black":number?,"gamma":number?,"input_white":number?,"output_black":number?,"output_white":number?}"#,
+            modify,
+        ),
+    ]
+    .into_iter()
+    .map(|(id, label, params, run)| CommandSpec {
+        id,
+        label,
+        params,
+        run,
+        menu: &[],
+        shortcut: None,
+        journal: id != "uv.maskPaint.select",
+        enabled: |s| if s.uv.scene.is_some() { Ok(()) } else { Err("Import a model first".into()) },
+    })
+    .collect()
+}
diff --git a/crates/engine/src/uv_reload_cmds.rs b/crates/engine/src/uv_reload_cmds.rs
new file mode 100644
index 000000000..a742177de
--- /dev/null
+++ b/crates/engine/src/uv_reload_cmds.rs
@@ -0,0 +1,124 @@
+//! Reimport geometry without reopening, replacing or modifying texture documents.
+use crate::{EngineError, Result, Session, commands::CommandSpec};
+use serde::{Deserialize, Serialize};
+use serde_json::{Value, json};
+use std::{collections::BTreeMap, sync::Arc};
+
+#[derive(Clone, Debug, PartialEq, Eq, Serialize, Deserialize)]
+pub struct SourceStamp {
+    size: u64,
+    modified_ns: u64,
+}
+impl SourceStamp {
+    #[cfg(not(target_arch = "wasm32"))]
+    pub(super) fn read(path: &str) -> Result<Option<Self>> {
+        let metadata = std::fs::metadata(path).map_err(|e| EngineError::Other(format!("{path}: {e}")))?;
+        let time = metadata.modified().map_err(|e| EngineError::Other(e.to_string()))?;
+        let ns = time.duration_since(std::time::UNIX_EPOCH).map_err(|e| EngineError::Other(e.to_string()))?.as_nanos();
+        Ok(Some(Self { size: metadata.len(), modified_ns: u64::try_from(ns).map_err(|_| EngineError::Other("Invalid source timestamp".into()))? }))
+    }
+    #[cfg(target_arch = "wasm32")]
+    pub(super) fn read(_: &str) -> Result<Option<Self>> {
+        Err(EngineError::Other("Source-file checking is available in native builds only".into()))
+    }
+}
+fn enabled(s: &Session) -> std::result::Result<(), String> {
+    if s.uv.scene.is_some() && !s.uv.source.is_empty() { Ok(()) } else { Err("Import a model with a source file first".into()) }
+}
+fn check(s: &mut Session, _: &Value) -> Result<Value> {
+    match SourceStamp::read(&s.uv.source) {
+        Ok(now) => {
+            let changed = s.uv.source_stamp.is_some() && now != s.uv.source_stamp;
+            if s.uv.source_stamp.is_none() {
+                s.uv.source_stamp = now;
+            }
+            Ok(json!({"changed":changed,"tracked":s.uv.source_stamp.is_some(),"available":true}))
+        }
+        Err(error) => Ok(json!({"changed":false,"available":false,"error":error.to_string()})),
+    }
+}
+fn reload(s: &mut Session, p: &Value) -> Result<Value> {
+    let old = s.uv.scene.as_ref().ok_or_else(|| EngineError::Other("Import a model first".into()))?;
+    let uv_set = match p.get("uvSet") {
+        None => s.uv.uv_set,
+        Some(value) => {
+            value.as_u64().and_then(|v| usize::try_from(v).ok()).filter(|v| *v <= 31).ok_or_else(|| EngineError::Other("uvSet must be in 0..31".into()))?
+        }
+    };
+    let (mut scene, stamp) = crate::uv_cmds::load_scene(&s.uv.source, uv_set)?;
+    let topology = photocraft_uv::topology::Topology::build(&scene).map_err(|e| EngineError::Other(e.to_string()))?;
+    let uv_changed = s.uv.uv_set != uv_set
+        || old.triangles.len() != scene.triangles.len()
+        || old.triangles.iter().zip(&scene.triangles).any(|(a, b)| a.corners.iter().zip(b.corners).any(|(a, b)| a.vertex != b.vertex || a.uv != b.uv));
+    let mut old_names = BTreeMap::<&str, Vec<usize>>::new();
+    let mut new_names = BTreeMap::<&str, usize>::new();
+    for (id, material) in old.materials.iter().enumerate() {
+        old_names.entry(&material.name).or_default().push(id);
+    }
+    for material in &scene.materials {
+        *new_names.entry(&material.name).or_default() += 1;
+    }
+    let mapping: Vec<_> = scene
+        .materials
+        .iter()
+        .map(|m| old_names.get(m.name.as_str()).filter(|ids| ids.len() == 1 && new_names.get(m.name.as_str()) == Some(&1)).and_then(|ids| ids.first()).copied())
+        .collect();
+    let bindings = mapping.iter().map(|id| id.and_then(|i| s.uv.bindings.get(i).copied().flatten())).collect();
+    let normal_bindings = mapping.iter().map(|id| id.and_then(|i| s.uv.normal_bindings.get(i).copied().flatten())).collect();
+    let map_bindings =
+        s.uv.map_bindings.iter().map(|(kind, slots)| (*kind, mapping.iter().map(|id| id.and_then(|i| slots.get(i).copied().flatten())).collect())).collect();
+    let hidden_materials = mapping.iter().enumerate().filter_map(|(new, old)| old.filter(|old| s.uv.hidden_materials.contains(old)).map(|_| new)).collect();
+    let material = mapping.iter().position(|old| *old == Some(s.uv.material)).unwrap_or(0);
+    for (id, old) in mapping.iter().enumerate() {
+        if old.is_none() {
+            scene.warnings.push(format!(
+                "{}: new or ambiguous material; assign its texture documents manually",
+                scene.materials.get(id).map_or("?", |m| m.name.as_str())
+            ));
+        }
+    }
+    if uv_changed {
+        scene.warnings.push("UV/topology changed. Texture documents and existing masks were retained; review seam-protection masks.".into());
+    }
+    // Everything above is fallible. Publish the new geometry only after it has fully validated.
+    let scene = Arc::new(scene);
+    let wrap_mesh = photocraft_uv::wrap::Mesh::new(&scene).ok().map(Arc::new);
+    s.uv.wrap_mesh = wrap_mesh;
+    s.uv.wrapped_stroke = None;
+    s.uv.scene = Some(scene);
+    s.uv.topology = Some(Arc::new(topology));
+    s.uv.bindings = bindings;
+    s.uv.normal_bindings = normal_bindings;
+    s.uv.map_bindings = map_bindings;
+    s.uv.hidden_materials = hidden_materials;
+    s.uv.material = material;
+    s.uv.uv_set = uv_set;
+    s.uv.source_stamp = stamp;
+    s.uv.selected.clear();
+    s.uv.generation = s.uv.generation.wrapping_add(1);
+    Ok(json!({"reimported":true,"uvChanged":uv_changed,"triangles":s.uv.scene.as_ref().map_or(0,|s|s.triangles.len())}))
+}
+pub fn specs() -> Vec<CommandSpec> {
+    vec![
+        CommandSpec {
+            id: "uv.model.reimport",
+            label: "Reimport model geometry",
+            params: r#"{"uvSet":int?}"#,
+            enabled,
+            run: reload,
+            menu: &[],
+            shortcut: None,
+            journal: true,
+        },
+        CommandSpec {
+            id: "uv.model.checkSource",
+            label: "Check source model for changes",
+            params: "{}",
+            enabled,
+            run: check,
+            menu: &[],
+            shortcut: None,
+            journal: false,
+        },
+    ]
+}
