diff --git a/crates/gpu/examples/bench_mask_fill.rs b/crates/gpu/examples/bench_mask_fill.rs
new file mode 100644
index 000000000..76bf31f45
--- /dev/null
+++ b/crates/gpu/examples/bench_mask_fill.rs
@@ -0,0 +1,230 @@
+//! CPU mask-stack refresh plus GPU render versus direct GPU Fill transforms.
+//! `cargo run --release -p photocraft-gpu --example bench_mask_fill [-- --large] [--side 512]`
+//! This isolates compositor work; it is not an end-to-end UI or input-latency benchmark.
+use std::{error::Error, time::Instant};
+
+use photocraft_color::{ColorMode, PixelFormat, SampleType};
+use photocraft_doc::{
+    Document, Layer, LayerContent, LayerMask,
+    mask_paint::{EffectKind, Paint, Stack},
+};
+use photocraft_geom::{Rect, Size};
+use photocraft_gpu::{Compositor, Stats};
+use photocraft_raster::Surface;
+
+const SOURCE_WIDTH: u32 = 1024;
+const SOURCE_HEIGHT: u32 = 512;
+const MEASURED_FRAMES: usize = 6;
+
+fn render(comp: &mut Compositor, device: &wgpu::Device, queue: &wgpu::Queue, doc: &Document) -> Result<Stats, Box<dyn Error>> {
+    let stats = comp.render(device, queue, doc, doc.bounds(), |_, _| {})?;
+    device.poll(wgpu::PollType::Wait { submission_index: None, timeout: None })?;
+    Ok(stats)
+}
+
+fn scene(size: Size) -> Result<Document, Box<dyn Error>> {
+    let gray = PixelFormat::GRAY8;
+    let rgba = PixelFormat::RGBA8;
+    let mut base = Surface::with_default(gray, &[0.72]);
+    base.write_region(Rect::new(0, 0, 128, 128), &vec![0.92; 128 * 128]);
+
+    let mut paint_surface = Surface::with_default(rgba, &[0.08, 0.05, 0.02, 0.0]);
+    let paint_pixels: Vec<f32> = (0..128 * 128)
+        .flat_map(|index| {
+            let alpha = if index % 7 == 0 { 0.8 } else { 0.35 };
+            [0.25, 0.4, 0.7, alpha]
+        })
+        .collect();
+    paint_surface.write_region(Rect::new(0, 0, 128, 128), &paint_pixels);
+
+    let mut fill_map = Surface::with_default(gray, &[0.0]);
+    let pixels: Vec<f32> = (0..SOURCE_HEIGHT).flat_map(|y| (0..SOURCE_WIDTH).map(move |x| ((x * 13 + y * 29) % 1024) as f32 / 1023.0)).collect();
+    fill_map.write_region(Rect::new(0, 0, SOURCE_WIDTH as i32, SOURCE_HEIGHT as i32), &pixels);
+
+    let width = (size.width as f32 * 0.55).round() as i32;
+    let height = (size.height as f32 * 0.5).round() as i32;
+    let center_x = size.width as i32 / 2;
+    let center_y = size.height as i32 / 2;
+    let bounds = [center_x - width / 2, center_y - height / 2, center_x - width / 2 + width, center_y - height / 2 + height];
+    let layers = vec![
+        Paint {
+            name: "Paint".into(),
+            visible: true,
+            opacity: 0.82,
+            blend: photocraft_color::BlendMode::Normal,
+            surface: paint_surface,
+            fill_map: None,
+            fill_map_size: [0, 0],
+            fill_bounds: None,
+            kind: EffectKind::Paint,
+        },
+        Paint {
+            name: "Image Fill".into(),
+            visible: true,
+            opacity: 0.9,
+            blend: photocraft_color::BlendMode::Normal,
+            surface: Surface::new(rgba),
+            fill_map: Some(fill_map),
+            fill_map_size: [SOURCE_WIDTH, SOURCE_HEIGHT],
+            fill_bounds: Some(bounds),
+            kind: EffectKind::Fill { value: 0.5, rotation: 0.0, repeat_u: true, repeat_v: true, mirror_u: false, mirror_v: false },
+        },
+        Paint {
+            name: "Levels".into(),
+            visible: true,
+            opacity: 0.88,
+            blend: photocraft_color::BlendMode::Normal,
+            surface: Surface::new(rgba),
+            fill_map: None,
+            fill_map_size: [0, 0],
+            fill_bounds: None,
+            kind: EffectKind::Levels { input_black: 0.04, gamma: 0.9, input_white: 0.96, output_black: 0.02, output_white: 0.98 },
+        },
+    ];
+    let mut mask = LayerMask::reveal_all();
+    mask.surface = base.clone();
+    mask.paint = Some(Stack { base, layers, active: 0 });
+
+    let mut layer_surface = Surface::with_default(rgba, &[0.8, 0.72, 0.64, 1.0]);
+    layer_surface.fill_rect(Rect::new(0, 0, size.width as i32, size.height as i32), &[0.8, 0.72, 0.64, 1.0]);
+    let mut layer = Layer::new("Masked raster", LayerContent::Raster(layer_surface));
+    layer.mask = Some(mask);
+    let mut doc = Document::new("mask Fill benchmark", size, ColorMode::Rgb, SampleType::U8);
+    doc.layers.push(layer);
+    Ok(doc)
+}
+
+/// Move the transformed Fill rectangle and rotate its image source, without flattening the stack.
+fn transformed(base: &Document, frame: usize) -> Result<Document, Box<dyn Error>> {
+    let mut doc = base.clone();
+    let mask = doc.layers.get_mut(0).and_then(|layer| layer.mask.as_mut()).ok_or("missing layer mask")?;
+    let stack = mask.paint.as_mut().ok_or("missing mask stack")?;
+    let fill = stack.layers.get_mut(1).ok_or("missing Fill layer")?;
+    let bounds = fill.fill_bounds.ok_or("missing Fill bounds")?;
+    let dx = (frame as i32 % 3 - 1) * 64;
+    let dy = (frame as i32 % 4 - 1) * 48;
+    fill.fill_bounds = Some([bounds[0] + dx, bounds[1] + dy, bounds[2] + dx, bounds[3] + dy]);
+    let EffectKind::Fill { rotation, .. } = &mut fill.kind else { return Err("second mask effect is not Fill".into()) };
+    *rotation = (frame as f32 * 13.0).rem_euclid(180.0);
+    Ok(doc)
+}
+
+fn percentile(samples: &[f64], percentile: f64) -> f64 {
+    let rank = ((samples.len() as f64 * percentile).ceil() as usize).saturating_sub(1).min(samples.len().saturating_sub(1));
+    samples.get(rank).copied().unwrap_or_default()
+}
+
+fn requested_size(args: &[String]) -> Result<Size, Box<dyn Error>> {
+    let mut size = if args.iter().any(|arg| arg == "--large") {
+        Size::new(6000, 4000)
+    } else if args.iter().any(|arg| arg == "--quick") {
+        Size::new(1024, 768)
+    } else {
+        Size::new(4096, 4096)
+    };
+    if let Some(index) = args.iter().position(|arg| arg == "--side") {
+        let value = args.get(index + 1).ok_or_else(|| std::io::Error::new(std::io::ErrorKind::InvalidInput, "--side requires a size from 128 through 8192"))?;
+        let side =
+            value.parse::<u32>().map_err(|_| std::io::Error::new(std::io::ErrorKind::InvalidInput, "--side must be an integer from 128 through 8192"))?;
+        if !(128..=8192).contains(&side) {
+            return Err(std::io::Error::new(std::io::ErrorKind::InvalidInput, "--side must be from 128 through 8192").into());
+        }
+        size = Size::new(side, side);
+    }
+    Ok(size)
+}
+
+fn run_mode(
+    label: &str,
+    base: &Document,
+    device: &wgpu::Device,
+    queue: &wgpu::Queue,
+    acc_format: wgpu::TextureFormat,
+    cpu_refresh: bool,
+) -> Result<(), Box<dyn Error>> {
+    let mut comp = Compositor::try_new_with_format(device, acc_format)?;
+    let mut total_uploads = 0usize;
+    let mut total_uploaded_bytes = 0u64;
+    let cold_start = Instant::now();
+    let mut current = transformed(base, 0)?;
+    if cpu_refresh {
+        let bounds = current.bounds();
+        if let Some(mask) = current.layers.get_mut(0).and_then(|layer| layer.mask.as_mut()) {
+            photocraft_compose::mask_paint::refresh(mask, Some(bounds));
+        }
+    }
+    let cold_stats = render(&mut comp, device, queue, &current)?;
+    let cold_ms = cold_start.elapsed().as_secs_f64() * 1000.0;
+    total_uploads += cold_stats.mask_fill_uploads;
+    total_uploaded_bytes = total_uploaded_bytes.saturating_add(cold_stats.mask_fill_bytes_uploaded);
+
+    let mut samples = Vec::with_capacity(MEASURED_FRAMES);
+    let mut refresh_samples = Vec::with_capacity(MEASURED_FRAMES);
+    let mut measured_uploads = 0usize;
+    let mut measured_uploaded_bytes = 0u64;
+    let mut last_stats = Stats::default();
+    for frame in 1..(MEASURED_FRAMES + 2) {
+        let start = Instant::now();
+        current = transformed(base, frame)?;
+        let refresh_start = Instant::now();
+        if cpu_refresh {
+            let bounds = current.bounds();
+            if let Some(mask) = current.layers.get_mut(0).and_then(|layer| layer.mask.as_mut()) {
+                photocraft_compose::mask_paint::refresh(mask, Some(bounds));
+            }
+        }
+        let refresh_ms = if cpu_refresh { refresh_start.elapsed().as_secs_f64() * 1000.0 } else { 0.0 };
+        let stats = render(&mut comp, device, queue, &current)?;
+        let elapsed_ms = start.elapsed().as_secs_f64() * 1000.0;
+        total_uploads += stats.mask_fill_uploads;
+        total_uploaded_bytes = total_uploaded_bytes.saturating_add(stats.mask_fill_bytes_uploaded);
+        if frame > 1 {
+            samples.push(elapsed_ms);
+            refresh_samples.push(refresh_ms);
+            measured_uploads += stats.mask_fill_uploads;
+            measured_uploaded_bytes = measured_uploaded_bytes.saturating_add(stats.mask_fill_bytes_uploaded);
+        }
+        last_stats = stats;
+    }
+    samples.sort_by(f64::total_cmp);
+    refresh_samples.sort_by(f64::total_cmp);
+    println!(
+        "path={label} cold={cold_ms:.3} ms total_p50={:.3} ms total_p95={:.3} ms refresh_p50={:.3} ms source_uploads_total={total_uploads} source_bytes_total={total_uploaded_bytes} measured_uploads={measured_uploads} measured_bytes={measured_uploaded_bytes} cold_stats(mask_fill_uploads={}, mask_fill_bytes_uploaded={}) last_stats(cells={}, chunks={}, bytes_uploaded={}, prefix_hits={}, prefix_passes_skipped={}, passes={})",
+        percentile(&samples, 0.50),
+        percentile(&samples, 0.95),
+        percentile(&refresh_samples, 0.50),
+        cold_stats.mask_fill_uploads,
+        cold_stats.mask_fill_bytes_uploaded,
+        last_stats.cells,
+        last_stats.chunks,
+        last_stats.bytes_uploaded,
+        last_stats.prefix_hits,
+        last_stats.prefix_passes_skipped,
+        last_stats.passes,
+    );
+    Ok(())
+}
+
+fn main() -> Result<(), Box<dyn Error>> {
+    let args: Vec<_> = std::env::args().collect();
+    let size = requested_size(&args)?;
+    let instance = wgpu::Instance::default();
+    let adapter = pollster::block_on(
+        instance.request_adapter(&wgpu::RequestAdapterOptions { power_preference: wgpu::PowerPreference::HighPerformance, ..Default::default() }),
+    )?;
+    let (device, queue) = pollster::block_on(adapter.request_device(&Default::default()))?;
+    let acc_format = Compositor::preferred_acc_format(&adapter);
+    println!(
+        "adapter={:?} canvas={}x{} fill_source={}x{} repeat=uv transform=move(64,48)+rotate(13deg/frame) measured_frames={} after one warm-up (compositor benchmark only)",
+        adapter.get_info(),
+        size.width,
+        size.height,
+        SOURCE_WIDTH,
+        SOURCE_HEIGHT,
+        MEASURED_FRAMES
+    );
+    let base = scene(size)?;
+    run_mode("cpu_refresh_plus_gpu", &base, &device, &queue, acc_format, true)?;
+    run_mode("gpu_transform_only", &base, &device, &queue, acc_format, false)?;
+    Ok(())
+}
diff --git a/crates/gpu/examples/bench_mask_stroke.rs b/crates/gpu/examples/bench_mask_stroke.rs
new file mode 100644
index 000000000..0a444b242
--- /dev/null
+++ b/crates/gpu/examples/bench_mask_stroke.rs
@@ -0,0 +1,220 @@
+//! 4096² ordinary raster-layer mask versus no mask under a small brush damage rect.
+//!
+//! Compares compositor full-document and dirty-rect updates after identical 128² edits,
+//! then reads the edited area back to verify full/dirty and reveal-all/no-mask equivalence.
+//! This is a GPU compositor diagnostic, not an end-to-end UI or 3D latency benchmark.
+use std::{error::Error, time::Instant};
+
+use photocraft_color::{Color, ColorMode, PixelFormat, SampleType};
+use photocraft_doc::{Document, Layer, LayerContent, LayerMask};
+use photocraft_geom::{Rect, Size};
+use photocraft_gpu::{Compositor, Stats};
+use photocraft_raster::Surface;
+
+const SIDE: u32 = 4096;
+const BRUSH_SIDE: u32 = 128;
+const FRAMES: usize = 6;
+fn brush_rect() -> Rect {
+    Rect::from_xywh(1984, 1984, BRUSH_SIDE, BRUSH_SIDE)
+}
+
+fn document(masked: bool) -> Document {
+    let size = Size::new(SIDE, SIDE);
+    let mut doc = Document::with_background("mask stroke diagnostic", size, ColorMode::Rgb, SampleType::U8, Color::rgb(0.24, 0.28, 0.32));
+    let mut top = Surface::with_default(PixelFormat::RGBA8, &[0.0, 0.0, 0.0, 0.0]);
+    top.fill_rect(doc.bounds(), &[0.46, 0.41, 0.36, 1.0]);
+    let mut layer = Layer::new("Paint", LayerContent::Raster(top));
+    if masked {
+        layer.mask = Some(LayerMask::reveal_all());
+    }
+    doc.layers.push(layer);
+    doc
+}
+
+fn edited(base: &Document, frame: usize) -> Result<Document, Box<dyn Error>> {
+    let mut doc = base.clone();
+    let Some(layer) = doc.layers.last_mut() else { return Err("missing paint layer".into()) };
+    let Some(surface) = layer.surface_mut() else { return Err("paint layer is not raster".into()) };
+    let color = [0.2 + frame as f32 * 0.08, 0.6, 0.35, 0.8];
+    let pixels: Vec<f32> = (0..BRUSH_SIDE * BRUSH_SIDE).flat_map(|_| color).collect();
+    surface.write_region(brush_rect(), &pixels);
+    Ok(doc)
+}
+
+fn poll(device: &wgpu::Device) -> Result<(), Box<dyn Error>> {
+    device.poll(wgpu::PollType::Wait { submission_index: None, timeout: None })?;
+    Ok(())
+}
+
+fn percentile(values: &[f64], p: f64) -> f64 {
+    let rank = ((values.len() as f64 * p).ceil() as usize).saturating_sub(1).min(values.len().saturating_sub(1));
+    values.get(rank).copied().unwrap_or_default()
+}
+
+struct ResultSet {
+    full_pixels: Vec<[f32; 4]>,
+    dirty_pixels: Vec<[f32; 4]>,
+}
+
+type RenderCapture = (Vec<[f32; 4]>, Stats);
+
+fn render_capture(
+    comp: &mut Compositor,
+    device: &wgpu::Device,
+    queue: &wgpu::Queue,
+    doc: &Document,
+    render_region: Rect,
+    capture_region: Rect,
+) -> Result<RenderCapture, Box<dyn Error>> {
+    let mut bytes_per_pixel = 8u32;
+    let mut copied = false;
+    let mut row = 0u32;
+    let buffer = device.create_buffer(&wgpu::BufferDescriptor {
+        label: Some("mask stroke diagnostic readback"),
+        size: u64::from(capture_region.width()) * u64::from(capture_region.height()) * 16,
+        usage: wgpu::BufferUsages::COPY_DST | wgpu::BufferUsages::MAP_READ,
+        mapped_at_creation: false,
+    });
+    let stats = comp.render(device, queue, doc, render_region, |encoder, out| {
+        let overlap = out.rect.intersect(&capture_region);
+        if overlap.width() == 0 || overlap.height() == 0 {
+            return;
+        }
+        bytes_per_pixel = if out.texture.format() == wgpu::TextureFormat::Rgba32Float { 16 } else { 8 };
+        row = (capture_region.width() * bytes_per_pixel).div_ceil(256) * 256;
+        let offset = u64::from((overlap.y0 - capture_region.y0) as u32) * u64::from(row)
+            + u64::from((overlap.x0 - capture_region.x0) as u32) * u64::from(bytes_per_pixel);
+        encoder.copy_texture_to_buffer(
+            wgpu::TexelCopyTextureInfo {
+                texture: out.texture,
+                mip_level: 0,
+                origin: wgpu::Origin3d { x: out.origin[0] + (overlap.x0 - out.rect.x0) as u32, y: out.origin[1] + (overlap.y0 - out.rect.y0) as u32, z: 0 },
+                aspect: wgpu::TextureAspect::All,
+            },
+            wgpu::TexelCopyBufferInfo {
+                buffer: &buffer,
+                layout: wgpu::TexelCopyBufferLayout { offset, bytes_per_row: Some(row), rows_per_image: Some(capture_region.height()) },
+            },
+            wgpu::Extent3d { width: overlap.width(), height: overlap.height(), depth_or_array_layers: 1 },
+        );
+        copied = true;
+    })?;
+    if !copied {
+        return Err("compositor emitted no pixels for the capture region".into());
+    }
+    let (send, receive) = std::sync::mpsc::channel();
+    buffer.slice(..).map_async(wgpu::MapMode::Read, move |result| {
+        let _ = send.send(result);
+    });
+    poll(device)?;
+    receive.recv()??;
+    let mapped = buffer.slice(..).get_mapped_range()?;
+    let mut pixels = Vec::with_capacity(capture_region.width() as usize * capture_region.height() as usize);
+    for y in 0..capture_region.height() as usize {
+        for x in 0..capture_region.width() as usize {
+            let offset = y * row as usize + x * bytes_per_pixel as usize;
+            let px = if bytes_per_pixel == 16 {
+                std::array::from_fn(|i| {
+                    f32::from_le_bytes([mapped[offset + i * 4], mapped[offset + i * 4 + 1], mapped[offset + i * 4 + 2], mapped[offset + i * 4 + 3]])
+                })
+            } else {
+                std::array::from_fn(|i| half::f16::from_le_bytes([mapped[offset + i * 2], mapped[offset + i * 2 + 1]]).to_f32())
+            };
+            pixels.push(px);
+        }
+    }
+    drop(mapped);
+    buffer.unmap();
+    Ok((pixels, stats))
+}
+
+fn run(masked: bool, device: &wgpu::Device, queue: &wgpu::Queue, acc_format: wgpu::TextureFormat) -> Result<ResultSet, Box<dyn Error>> {
+    let base = document(masked);
+    let mut full = Compositor::try_new_with_format(device, acc_format)?;
+    let mut dirty = Compositor::try_new_with_format(device, acc_format)?;
+    full.render(device, queue, &base, base.bounds(), |_, _| {})?;
+    dirty.render(device, queue, &base, base.bounds(), |_, _| {})?;
+    poll(device)?;
+
+    let mut full_ms = Vec::with_capacity(FRAMES);
+    let mut dirty_ms = Vec::with_capacity(FRAMES);
+    let mut final_doc = None;
+    let mut full_stats = Default::default();
+    let mut dirty_stats = Default::default();
+    let mut full_pixels = Vec::new();
+    let mut dirty_pixels = Vec::new();
+    for frame in 0..FRAMES {
+        let current = edited(&base, frame)?;
+        let start = Instant::now();
+        if frame + 1 == FRAMES {
+            (full_pixels, full_stats) = render_capture(&mut full, device, queue, &current, current.bounds(), brush_rect())?;
+        } else {
+            full_stats = full.render(device, queue, &current, current.bounds(), |_, _| {})?;
+            poll(device)?;
+        }
+        full_ms.push(start.elapsed().as_secs_f64() * 1000.0);
+
+        let start = Instant::now();
+        if frame + 1 == FRAMES {
+            (dirty_pixels, dirty_stats) = render_capture(&mut dirty, device, queue, &current, brush_rect(), brush_rect())?;
+        } else {
+            dirty_stats = dirty.render(device, queue, &current, brush_rect(), |_, _| {})?;
+            poll(device)?;
+        }
+        dirty_ms.push(start.elapsed().as_secs_f64() * 1000.0);
+        final_doc = Some(current);
+    }
+    let _final_doc = final_doc.ok_or("no measured frames")?;
+    full_ms.sort_by(f64::total_cmp);
+    dirty_ms.sort_by(f64::total_cmp);
+    println!(
+        "mask={} full_p50_ms={:.3} full_p95_ms={:.3} dirty128_p50_ms={:.3} dirty128_p95_ms={:.3} full_stats(passes={},chunks={},cells={},bytes_uploaded={}) dirty_stats(passes={},chunks={},cells={},bytes_uploaded={})",
+        if masked { "reveal_all" } else { "none" },
+        percentile(&full_ms, 0.5),
+        percentile(&full_ms, 0.95),
+        percentile(&dirty_ms, 0.5),
+        percentile(&dirty_ms, 0.95),
+        full_stats.passes,
+        full_stats.chunks,
+        full_stats.cells,
+        full_stats.bytes_uploaded,
+        dirty_stats.passes,
+        dirty_stats.chunks,
+        dirty_stats.cells,
+        dirty_stats.bytes_uploaded,
+    );
+    Ok(ResultSet { full_pixels, dirty_pixels })
+}
+
+fn max_difference(a: &[[f32; 4]], b: &[[f32; 4]]) -> Result<f32, Box<dyn Error>> {
+    if a.len() != b.len() {
+        return Err(format!("pixel count differs: {} vs {}", a.len(), b.len()).into());
+    }
+    Ok(a.iter().zip(b).flat_map(|(x, y)| x.iter().zip(y).map(|(x, y)| (x - y).abs())).fold(0.0f32, f32::max))
+}
+
+fn main() -> Result<(), Box<dyn Error>> {
+    let backend = match std::env::var("PHOTOCRAFT_MASK_BENCH_BACKEND").ok().as_deref() {
+        Some("vulkan") => wgpu::Backends::VULKAN,
+        Some("dx12") => wgpu::Backends::DX12,
+        None => wgpu::Backends::PRIMARY,
+        Some(other) => return Err(format!("unsupported PHOTOCRAFT_MASK_BENCH_BACKEND: {other}").into()),
+    };
+    let instance = wgpu::Instance::new(wgpu::InstanceDescriptor { backends: backend, ..wgpu::InstanceDescriptor::new_without_display_handle() });
+    let adapter = pollster::block_on(
+        instance.request_adapter(&wgpu::RequestAdapterOptions { power_preference: wgpu::PowerPreference::HighPerformance, ..Default::default() }),
+    )?;
+    let (device, queue) = pollster::block_on(adapter.request_device(&Default::default()))?;
+    let acc_format = Compositor::preferred_acc_format(&adapter);
+    println!("adapter={:?} backend={backend:?} document={}x{} layers=2 brush={}x{} frames={}", adapter.get_info(), SIDE, SIDE, BRUSH_SIDE, BRUSH_SIDE, FRAMES);
+    let plain = run(false, &device, &queue, acc_format)?;
+    let masked = run(true, &device, &queue, acc_format)?;
+    let plain_delta = max_difference(&plain.full_pixels, &plain.dirty_pixels)?;
+    let mask_delta = max_difference(&masked.full_pixels, &masked.dirty_pixels)?;
+    let identity_delta = max_difference(&plain.full_pixels, &masked.full_pixels)?;
+    println!("edited_region_max_delta full_vs_dirty(no_mask)={plain_delta:.8} full_vs_dirty(mask)={mask_delta:.8} no_mask_vs_reveal_all={identity_delta:.8}");
+    if plain_delta > 1.0 / 255.0 || mask_delta > 1.0 / 255.0 || identity_delta > 1.0 / 255.0 {
+        return Err("full/dirty or reveal-all identity pixel difference exceeds 1/255".into());
+    }
+    Ok(())
+}
