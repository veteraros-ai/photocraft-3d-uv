+        let fill = h
+            .state()
+            .session
+            .active()
+            .unwrap()
+            .doc
+            .layer(h.state().session.active().unwrap().active_layer.unwrap())
+            .unwrap()
+            .mask
+            .as_ref()
+            .unwrap()
+            .paint
+            .as_ref()
+            .unwrap()
+            .layers[0]
+            .clone();
+        assert!(fill.fill_map.is_some(), "dropping on the Fill row assigns the image source");
+        assert_eq!(h.state().session.active().unwrap().doc.layers.len(), before + 1, "Fill drop does not place another raster layer");
+        assert!(h.state().ui.transform.is_none(), "Fill drop assigns directly without starting a layer transform");
+        h.state_mut().ui.dock_tabs.properties = 0;
+        h.run_steps(2);
+        if let Ok(path) = std::env::var("PHOTOCRAFT_UV_LIBRARY_SCREENSHOT") {
+            h.render().unwrap().save(path).unwrap();
+        }
+        h.state_mut().run("edit.undo", json!({})).unwrap();
+        assert_eq!(h.state().session.active().unwrap().doc.layers.len(), before + 1);
+        let restored_fill = h
+            .state()
+            .session
+            .active()
+            .unwrap()
+            .doc
+            .layer(h.state().session.active().unwrap().active_layer.unwrap())
+            .unwrap()
+            .mask
+            .as_ref()
+            .unwrap()
+            .paint
+            .as_ref()
+            .unwrap()
+            .layers[0]
+            .clone();
+        assert!(restored_fill.fill_map.is_none(), "undo removes the dropped image source");
+    }
+}
diff --git a/crates/ui-egui/src/uv_lighting.rs b/crates/ui-egui/src/uv_lighting.rs
new file mode 100644
index 000000000..e2a0496c0
--- /dev/null
+++ b/crates/ui-egui/src/uv_lighting.rs
@@ -0,0 +1,413 @@
+//! View-only environment resources, source-profile-aware PBR maps and native environment picker.
+use crate::PhotocraftApp;
+use photocraft_uv::{
+    lighting::Environment,
+    preview::{Channel, Image},
+};
+use std::sync::Arc;
+
+pub(crate) const MAPS: [Channel; 5] = [Channel::Color, Channel::Metallic, Channel::Roughness, Channel::Ao, Channel::Emissive];
+pub(crate) type Key = (u64, u64, u64, u64);
+pub(crate) type RegionHint = (Key, Vec<[u32; 4]>);
+#[derive(Clone)]
+pub(crate) struct GpuMapRequest {
+    pub doc: Arc<photocraft_doc::Document>,
+    pub key: Key,
+    pub linear_srgb: bool,
+    /// A partial update is safe only when it was derived from this exact preceding map key.
+    pub previous_key: Option<Key>,
+    /// Pixels changed since `previous_key`; `None` requires a full recomposite.
+    pub damage: Option<photocraft_geom::Rect>,
+}
+#[derive(Default)]
+pub(crate) struct SurfaceMaps {
+    pub images: [Vec<Option<Image>>; 5],
+    pub gpu: [Vec<Option<GpuMapRequest>>; 5],
+    pub keys: [Vec<Key>; 5],
+    pub regions: [Vec<Option<RegionHint>>; 5],
+    pub use_color_for_pbr: Vec<bool>,
+    pub output: Option<(u64, Image)>,
+    snapshots: [Vec<Option<Arc<photocraft_doc::Document>>>; 5],
+}
+pub(crate) fn gpu_color_encoding(doc: &photocraft_doc::Document, channel: Channel) -> Option<bool> {
+    if !matches!(channel, Channel::Color | Channel::Emissive) || doc.mode != photocraft_color::ColorMode::Rgb {
+        return None;
+    }
+    let profile = photocraft_engine::color_cmds::composite_profile(doc);
+    let hash = profile.content_hash();
+    if hash == photocraft_cms::Builtin::Srgb.profile().content_hash() {
+        Some(true)
+    } else if hash == photocraft_cms::Builtin::LinearSrgb.profile().content_hash() {
+        Some(false)
+    } else {
+        None
+    }
+}
+#[derive(Default)]
+pub(crate) struct Cache {
+    pub path: String,
+    pending_path: String,
+    pub surface: SurfaceMaps,
+    pub environment: Option<Arc<Environment>>,
+    pub name: String,
+    preview: Option<egui::TextureHandle>,
+    #[cfg(not(target_arch = "wasm32"))]
+    pending: Option<std::sync::mpsc::Receiver<Result<(String, Environment), String>>>,
+}
+pub(crate) fn refresh(app: &mut PhotocraftApp, maps: &mut SurfaceMaps) -> Result<(), String> {
+    refresh_impl(app, maps, false)
+}
+pub(crate) fn refresh_gpu(app: &mut PhotocraftApp, maps: &mut SurfaceMaps) -> Result<(), String> {
+    refresh_impl(app, maps, true)
+}
+fn refresh_impl(app: &mut PhotocraftApp, maps: &mut SurfaceMaps, allow_gpu: bool) -> Result<(), String> {
+    let monitor = app.session.active().and_then(|st| app.session.color.canvas_display(&st.doc).ok()).map(|d| d.monitor.clone());
+    let monitor = monitor.as_deref().unwrap_or(photocraft_cms::Builtin::Srgb.profile());
+    let hash = monitor.content_hash();
+    if maps.output.as_ref().is_none_or(|(key, _)| *key != hash) {
+        let mut lut = identity_lut();
+        let transform = photocraft_cms::transform::cached(photocraft_cms::Builtin::Srgb.profile(), monitor, Default::default()).map_err(|e| e.to_string())?;
+        let source = lut.rgba.as_flattened().to_vec();
+        transform.convert_f32(&source, 4, lut.rgba.as_flattened_mut(), 4, true);
+        maps.output = Some((hash, lut));
+    }
+    let opacity_bindings = app.session.uv.map_bindings(Channel::Opacity).to_vec();
+    let material_count = MAPS.iter().map(|channel| app.session.uv.map_bindings(*channel).len()).max().unwrap_or(0);
+    maps.use_color_for_pbr.resize(material_count, false);
+    for material in 0..material_count {
+        maps.use_color_for_pbr[material] = opacity_bindings.get(material).is_none_or(Option::is_none);
+    }
+    for (kind, channel) in MAPS.into_iter().enumerate() {
+        let bindings = app.session.uv.map_bindings(channel).to_vec();
+        maps.images[kind].resize_with(bindings.len(), || None);
+        maps.gpu[kind].resize_with(bindings.len(), || None);
+        maps.keys[kind].resize(bindings.len(), Key::default());
+        maps.regions[kind].resize(bindings.len(), None);
+        maps.regions[kind].fill(None);
+        maps.snapshots[kind].resize(bindings.len(), None);
+        for (material, id) in bindings.into_iter().enumerate() {
+            let Some(index) = id.and_then(|id| app.session.documents().iter().position(|s| s.doc.id == id)) else {
+                if let Some(v) = maps.gpu[kind].get_mut(material) {
+                    *v = None;
+                }
+                if let Some(v) = maps.images[kind].get_mut(material) {
+                    *v = None;
+                }
+                if let Some(v) = maps.keys[kind].get_mut(material) {
+                    *v = Key::default();
+                }
+                continue;
+            };
+            if allow_gpu && crate::uv_mask_paint_preview::fill_manipulation_active(app, index) {
+                // UV workbench refreshes the bounded mask proxy separately. Keep all source
+                // material maps canonical while the Fill controls move; release refreshes them.
+                continue;
+            }
+            let revision = app.session.documents().get(index).map_or(0, |s| s.revision);
+            let gpu_candidate =
+                allow_gpu.then(|| crate::uv_mask_paint_preview::gpu_display_doc(app, index).unwrap_or_else(|| crate::canvas::display_doc(app, index)));
+            let gpu_candidate = gpu_candidate.and_then(|(doc, live)| gpu_color_encoding(&doc, channel).map(|encoding| (doc, live, encoding)));
+            // A spatial Fill's GPU snapshot is parameter-current and does not enqueue a CPU
+            // materialization. Fall back to the coalesced CPU path only when this map cannot use
+            // the GPU planner.
+            let (doc, live, gpu_encoding) = if let Some((doc, live, encoding)) = gpu_candidate {
+                (doc, live, Some(encoding))
+            } else {
+                let (doc, live) = crate::canvas::display_doc(app, index);
+                (doc, live, None)
+            };
+            let colored = matches!(channel, Channel::Color | Channel::Emissive);
+            // Profile assignment/conversion is a document revision. Avoid parsing an ICC
+            // profile for every unchanged slot, including numeric maps, on every refresh.
+            let key = (doc.id.0, revision, live, 0);
+            let gpu_request = gpu_encoding.map(|linear_srgb| {
+                let map_key = (doc.id.0, revision, live, photocraft_engine::color_cmds::composite_profile(&doc).content_hash());
+                let previous = maps.gpu[kind]
+                    .get(material)
+                    .and_then(Option::as_ref)
+                    .filter(|old| old.key.0 == map_key.0 && old.key.3 == map_key.3 && old.doc.size == doc.size);
+                let last_damage = app.session.documents().get(index).and_then(|st| st.last_damage);
+                let damage = previous.and_then(|old| crate::canvas::damage_since(app, index, (old.key.1, old.key.2), (revision, live), 0, last_damage));
+                let previous_key = damage.as_ref().and_then(|_| previous.map(|old| old.key));
+                GpuMapRequest { doc: doc.clone(), key: map_key, linear_srgb, previous_key, damage }
+            });
+            if let Some(slot) = maps.gpu[kind].get_mut(material) {
+                *slot = gpu_request.clone();
+            }
+            if gpu_request.is_some() {
+                if let Some(slot) = maps.images[kind].get_mut(material) {
+                    *slot = None;
+                }
+                maps.snapshots[kind][material] = None;
+                if let Some(slot) = maps.keys[kind].get_mut(material) {
+                    *slot = key;
+                }
+                continue;
+            }
+            if let Some(slot) = maps.gpu[kind].get_mut(material) {
+                *slot = None;
+            }
+            if maps.keys[kind].get(material) == Some(&key) && maps.images[kind].get(material).is_some_and(Option::is_some) {
+                continue;
+            }
+            let old = maps.keys[kind].get(material).copied().unwrap_or_default();
+            let damage = if old.0 == key.0
+                && maps.images[kind]
+                    .get(material)
+                    .and_then(Option::as_ref)
+                    .is_some_and(|im| im.width == doc.size.width as usize && im.height == doc.size.height as usize)
+            {
+                crate::canvas::damage_since(app, index, (old.1, old.2), (revision, live), 0, app.session.documents().get(index).and_then(|st| st.last_damage))
+            } else {
+                None
+            };
+            if maps.images[kind][material].is_none() {
+                maps.snapshots[kind][material] = None;
+            }
+            let regions = crate::uv_damage::regions(&mut maps.snapshots[kind][material], &doc, damage);
+            let mut hints = Vec::new();
+            for rect in regions {
+                let buffer = photocraft_compose::render_reduced_damage(&doc, doc.size.width, doc.size.height, rect);
+                let rect = buffer.rect;
+                let rgba = if colored {
+                    let profile = photocraft_engine::color_cmds::composite_profile(&doc);
+                    let transform = photocraft_cms::transform::cached(&profile, photocraft_cms::Builtin::LinearSrgb.profile(), Default::default())
+                        .map_err(|e| e.to_string())?;
+                    let mut dst = vec![[0.0; 4]; buffer.px.len()];
+                    transform.convert_f32(buffer.px.as_flattened(), 4, dst.as_flattened_mut(), 4, true);
+                    dst
+                } else {
+                    buffer.px
+                };
+                if let Some(v) = maps.images[kind].get_mut(material) {
+                    crate::uv_ui::patch_image(v, [doc.size.width, doc.size.height], rect, rgba)?;
+                }
+                hints.push(if rect.is_empty() { [0; 4] } else { [rect.x0 as u32, rect.y0 as u32, rect.width(), rect.height()] });
+            }
+            if old.0 == key.0
+                && let Some(hint) = maps.regions[kind].get_mut(material)
+            {
+                *hint = Some((old, hints));
+            }
+            if let Some(v) = maps.keys[kind].get_mut(material) {
+                *v = key;
+            }
+        }
+    }
+    Ok(())
+}
+pub(crate) fn identity_lut() -> Image {
+    Image {
+        width: 17 * 17,
+        height: 17,
+        rgba: (0..17 * 17 * 17).map(|i| [(i % 17) as f32 / 16.0, ((i / 17) % 17) as f32 / 16.0, (i / (17 * 17)) as f32 / 16.0, 1.0]).collect(),
+    }
+}
+
+#[cfg(not(target_arch = "wasm32"))]
+fn load(path: &str) -> Result<(String, Environment), String> {
+    use std::io::Read;
+    let file = std::fs::File::open(path).map_err(|e| e.to_string())?;
+    let mut bytes = Vec::new();
+    file.take(256 * 1024 * 1024 + 1).read_to_end(&mut bytes).map_err(|e| e.to_string())?;
+    if bytes.len() > 256 * 1024 * 1024 {
+        return Err(tl!("Environment map exceeds 256 MiB").into());
+    }
+    decode_environment(path, &bytes)
+}
+#[cfg(not(target_arch = "wasm32"))]
+fn decode_environment(path: &str, bytes: &[u8]) -> Result<(String, Environment), String> {
+    let format = photocraft_codecs::detect(bytes).ok_or(tl!("Unknown environment map format"))?;
+    if !matches!(format, photocraft_codecs::Format::Hdr | photocraft_codecs::Format::OpenExr) {
+        return Err(tl!("Choose a linear HDR or EXR panorama").into());
+    }
+    let opts = photocraft_codecs::DecodeOptions {
+        limits: photocraft_codecs::Limits { max_width: 16384, max_height: 8192, max_pixels: 33_554_432, max_alloc: 512 * 1024 * 1024 },
+        ..Default::default()
+    };
+    let decoded = photocraft_codecs::decode_with(bytes, &opts).map_err(|e| e.to_string())?;
+    let rgba = decoded.to_rgba_f32().as_chunks::<4>().0.iter().map(|p| p.map(|x| if x.is_finite() { x.clamp(0.0, 65504.0) } else { 0.0 })).collect();
+    let source = Image { width: decoded.width() as usize, height: decoded.height() as usize, rgba };
+    let env = Environment::prepare(&source).map_err(|e| e.to_string())?;
+    let name = std::path::Path::new(path).file_name().map_or_else(|| "HDR".into(), |s| s.to_string_lossy().into_owned());
+    Ok((name, env))
+}
+pub(crate) fn poll(cache: &mut Cache, ctx: &egui::Context) -> Option<String> {
+    #[cfg(not(target_arch = "wasm32"))]
+    if let Some(rx) = &cache.pending {
+        match rx.try_recv() {
+            Ok(result) => {
+                cache.pending = None;
+                match result {
+                    Ok((name, env)) => {
+                        cache.path = std::mem::take(&mut cache.pending_path);
+                        cache.name = name;
+                        cache.environment = Some(Arc::new(env));
+                        cache.preview = None;
+                    }
+                    Err(e) => return Some(e),
+                }
+            }
+            Err(std::sync::mpsc::TryRecvError::Empty) => ctx.request_repaint_after(std::time::Duration::from_millis(50)),
+            Err(std::sync::mpsc::TryRecvError::Disconnected) => {
+                cache.pending = None;
+                return Some(tl!("Environment preparation was interrupted").into());
+            }
+        }
+    }
+    let _ = (cache, ctx);
+    None
+}
+pub(crate) fn ensure(cache: &mut Cache) -> Arc<Environment> {
+    cache.environment.get_or_insert_with(|| Arc::new(Environment::studio())).clone()
+}
+pub(crate) fn select_environment(app: &mut PhotocraftApp, path: String) -> Result<serde_json::Value, String> {
+    if path.is_empty() {
+        let cache = &mut app.uv_cache.lighting;
+        cache.environment = None;
+        cache.preview = None;
+        cache.name.clear();
+        cache.path.clear();
+        cache.pending_path.clear();
+        #[cfg(not(target_arch = "wasm32"))]
+        {
+            cache.pending = None;
+        }
+        return Ok(serde_json::Value::Null);
+    }
+    if app.uv_cache.lighting.path == path && app.uv_cache.lighting.environment.is_some() {
+        return Ok(serde_json::Value::Null);
+    }
+    #[cfg(not(target_arch = "wasm32"))]
+    {
+        let (tx, rx) = std::sync::mpsc::sync_channel(1);
+        let source = path.clone();
+        let embedded = app
+            .session
+            .uv
+            .environment
+            .clone()
+            .filter(|_| app.session.uv.project_view.get("environment").and_then(serde_json::Value::as_str) == Some(path.as_str()));
+        std::thread::Builder::new()
+            .name("uv-environment".into())
+            .spawn(move || {
+                let _ = tx.send(if let Some(resource) = embedded { decode_environment(&resource.name, &resource.bytes) } else { load(&source) });
+            })
+            .map_err(|e| e.to_string())?;
+        app.uv_cache.lighting.pending_path = path;
+        app.uv_cache.lighting.pending = Some(rx);
+        Ok(serde_json::json!({"loading":true}))
+    }
+    #[cfg(target_arch = "wasm32")]
+    {
+        let _ = (app, path);
+        Err(tl!("Environment loading is available in the desktop build").into())
+    }
+}
+pub(crate) fn panel(app: &mut PhotocraftApp, state: &mut crate::uv_ui::State, ui: &mut egui::Ui) {
+    egui::CollapsingHeader::new(tl!("Environment / PBR")).default_open(true).show(ui, |ui| {
+        ui.spacing_mut().slider_width = (ui.available_width() - 195.0).clamp(60.0, 140.0);
+        let cache = &mut app.uv_cache.lighting;
+        if let Some(e) = poll(cache, ui.ctx()) {
+            state.status = e;
+        }
+        let env = ensure(cache);
+        let settings = &mut state.lighting;
+        ui.checkbox(&mut settings.pbr, tl!("PBR · Roughness / Metallic"));
+        if cache.preview.is_none()
+            && let Some(im) = env.specular.first()
+        {
+            let bytes: Vec<_> = im
+                .rgba
+                .iter()
+                .flat_map(|p| {
+                    let encode = |x: f32| (photocraft_color::convert::linear_to_srgb(x / (1.0 + x)) * 255.0).clamp(0.0, 255.0) as u8;
+                    [encode(p[0]), encode(p[1]), encode(p[2]), 255]
+                })
+                .collect();
+            cache.preview = Some(ui.ctx().load_texture(
+                "uv-environment-preview",
+                egui::ColorImage::from_rgba_unmultiplied([im.width, im.height], &bytes),
+                egui::TextureOptions::LINEAR,
+            ));
+        }
+        if let Some(preview) = &cache.preview {
+            ui.add(egui::Image::new(preview).fit_to_exact_size(egui::vec2(ui.available_width(), ui.available_width() * 0.5)));
+        }
+        ui.label(if cache.name.is_empty() { tl!("Studio environment") } else { &cache.name });
+        let mut choose = false;
+        ui.horizontal(|ui| {
+            choose = ui.button(tl!("HDR / EXR…")).clicked();
+            if ui.button(tl!("Studio")).clicked() {
+                cache.environment = None;
+                cache.preview = None;
+                cache.name.clear();
+                cache.path.clear();
+                cache.pending_path.clear();
+                #[cfg(not(target_arch = "wasm32"))]
+                {
+                    cache.pending = None;
+                }
+            }
+        });
+        #[cfg(not(target_arch = "wasm32"))]
+        if cache.pending.is_some() {
+            ui.spinner();
+            ui.label(tl!("Preparing lighting…"));
+        }
+        ui.add(egui::Slider::new(&mut settings.brightness, 0.0..=8.0).text(tl!("Brightness")));
+        ui.add(egui::Slider::new(&mut settings.rotation, -180.0..=180.0).suffix("°").text(tl!("Rotation")));
+        ui.checkbox(&mut settings.background, tl!("Show environment background"));
+        if settings.background {
+            ui.add(egui::Slider::new(&mut settings.background_brightness, 0.0..=4.0).text(tl!("Background brightness")));
+        }
+        ui.add(egui::Slider::new(&mut settings.emissive, 0.0..=8.0).text(tl!("Emissive intensity")));
+        egui::CollapsingHeader::new(tl!("Material defaults")).show(ui, |ui| {
+            ui.add(egui::Slider::new(&mut settings.roughness, 0.045..=1.0).text(tl!("Roughness")));
+            ui.add(egui::Slider::new(&mut settings.metallic, 0.0..=1.0).text(tl!("Metallic")));
+        });
+        if choose {
+            use crate::file_dialog::{FileDialogAnswer, FileDialogRequest};
+            if let Err(e) = app.ask_file(
+                FileDialogRequest::Open { multiple: false, initial_dir: None, extensions: Some(vec!["hdr".into(), "exr".into()]) },
+                |app, answer| {
+                    let FileDialogAnswer::Paths(paths) = answer else { return Err(tl!("Choose a local HDR / EXR map").into()) };
+                    let path = paths.first().ok_or(tl!("No file selected"))?.clone();
+                    select_environment(app, path)
+                },
+            ) {
+                state.status = e;
+            }
+        }
+    });
+}
+
+pub(crate) fn pending(cache: &Cache) -> bool {
+    #[cfg(not(target_arch = "wasm32"))]
+    {
+        cache.pending.is_some()
+    }
+    #[cfg(target_arch = "wasm32")]
+    {
+        let _ = cache;
+        false
+    }
+}
+
+#[cfg(all(test, not(target_arch = "wasm32")))]
+mod tests {
+    use super::*;
+    #[test]
+    fn hdr_environment_loading_keeps_radiance_and_rejects_other_files() {
+        let _gpu = photocraft_testkit::gpu_lock();
+        let image = photocraft_codecs::Image::from_f32(4, 2, photocraft_codecs::ChannelLayout::Rgb, &[4.0, 2.0, 0.5].repeat(8)).unwrap();
+        let bytes = photocraft_codecs::encode(&image, photocraft_codecs::Format::Hdr, &Default::default()).unwrap();
+        let path = std::env::temp_dir().join(format!("uv-environment-{}.hdr", std::process::id()));
+        std::fs::write(&path, bytes).unwrap();
+        let (_, env) = load(path.to_str().unwrap()).unwrap();
+        assert!((env.specular[0].rgba[0][0] - 4.0).abs() < 0.01);
+        std::fs::write(&path, b"invalid environment").unwrap();
+        assert!(load(path.to_str().unwrap()).is_err());
+        std::fs::remove_file(path).unwrap();
+    }
+}
diff --git a/crates/ui-egui/src/uv_map.wgsl b/crates/ui-egui/src/uv_map.wgsl
new file mode 100644
index 000000000..5a8c11e33
--- /dev/null
+++ b/crates/ui-egui/src/uv_map.wgsl
@@ -0,0 +1,31 @@
+@group(0) @binding(0) var source_map: texture_2d<f32>;
+struct Params {
+    origin: vec2<u32>,
+    linear_srgb: u32,
+    _pad: u32,
+    source_origin: vec2<u32>,
+};
+@group(0) @binding(1) var<uniform> params: Params;
+
+@vertex
+fn vs(@builtin(vertex_index) index: u32) -> @builtin(position) vec4<f32> {
+    var p = vec2<f32>(-1.0, -1.0);
+    if index == 1u { p = vec2<f32>(3.0, -1.0); }
+    if index == 2u { p = vec2<f32>(-1.0, 3.0); }
+    return vec4<f32>(p, 0.0, 1.0);
+}
+
+fn srgb_to_linear(v: f32) -> f32 {
+    if v <= 0.04045 { return v / 12.92; }
+    return pow((v + 0.055) / 1.055, 2.4);
+}
+
+@fragment
+fn fs(@builtin(position) pos: vec4<f32>) -> @location(0) vec4<f32> {
+    let local = vec2<i32>(pos.xy) - vec2<i32>(params.origin) + vec2<i32>(params.source_origin);
+    var pixel = textureLoad(source_map, local, 0);
+    if params.linear_srgb != 0u {
+        pixel = vec4<f32>(srgb_to_linear(pixel.r), srgb_to_linear(pixel.g), srgb_to_linear(pixel.b), pixel.a);
+    }
+    return pixel;
+}
diff --git a/crates/ui-egui/src/uv_mask.rs b/crates/ui-egui/src/uv_mask.rs
new file mode 100644
index 000000000..817616dc3
--- /dev/null
+++ b/crates/ui-egui/src/uv_mask.rs
@@ -0,0 +1,84 @@
+//! Native channel/mask display projected through each material UV, independent of source maps.
+use crate::PhotocraftApp;
+
+/// Whether `material` has any source map bound to the displayed mask document. Mask display may
+/// come from Color, Roughness, Normal, or another UV channel; keep this predicate shared by the
+/// preview renderer and the paint hit-target gate.
+pub(crate) fn has_mask_binding(app: &PhotocraftApp, material: usize, document: photocraft_doc::DocId) -> bool {
+    photocraft_uv::preview::Channel::MAPS.iter().any(|kind| app.session.uv.map_bindings(*kind).get(material) == Some(&Some(document)))
+}
+
+pub(crate) fn source(app: &PhotocraftApp, material: usize) -> Option<usize> {
+    let index = app.session.active_index()?;
+    let st = app.session.documents().get(index)?;
+    if st.channel_view.is_plain(&st.doc) {
+        return None;
+    }
+    has_mask_binding(app, material, st.doc.id).then_some(index)
+}
+pub(crate) fn key(app: &PhotocraftApp, index: usize) -> u64 {
+    use std::hash::{Hash, Hasher};
+    let mut h = std::collections::hash_map::DefaultHasher::new();
+    if let Some(st) = app.session.documents().get(index) {
+        serde_json::to_string(&st.channel_view).unwrap_or_default().hash(&mut h);
+        st.active_layer.hash(&mut h);
+    }
+    let look = crate::channel_view::Look::of(&app.session);
+    look.in_color.hash(&mut h);
+    look.mask_rgb.map(f32::to_bits).hash(&mut h);
+    look.mask_opacity.to_bits().hash(&mut h);
+    crate::uv_mask_paint_preview::sampled_fill_proxy(app, index).map(|proxy| proxy.key).hash(&mut h);
+    h.finish()
+}
+pub(crate) fn overlay(
+    app: &PhotocraftApp,
+    index: usize,
+    doc: &photocraft_doc::Document,
+    rect: photocraft_geom::Rect,
+    output_size: [u32; 2],
+    pixels: &mut [[f32; 4]],
+    factor: u32,
+) {
+    let Some(st) = app.session.documents().get(index) else {
+        return;
+    };
+    let mut view = st.channel_view.clone();
+    if view.target == photocraft_engine::channel_cmds::ChannelTarget::LayerMask
+        && let Some(layer) = st.active_layer.filter(|id| doc.layer(*id).is_some_and(|layer| layer.mask.is_some()))
+    {
+        view.layer_mask = Some(photocraft_engine::mask_view_cmds::LayerMaskView { layer, filter: false, mode: photocraft_engine::mask_view_cmds::MaskViewMode::Gray });
+    }
+    let look = crate::channel_view::Look::of(&app.session);
+    let live_fill = crate::uv_mask_paint_preview::sampled_fill_proxy(app, index)
+        .filter(|proxy| view.layer_mask.is_some_and(|shown| shown.layer == proxy.layer) && view.shown_layer_mask(doc).is_some());
+    let px = if let Some(proxy) = live_fill {
+        crate::channel_view::render_fill_mask_proxy(doc, &view, rect, output_size, look, &proxy)
+    } else {
+        crate::channel_view::render(doc, &view, rect, factor, look, st.active_layer)
+    };
+    if let Some(px) = px {
+        for (out, p) in pixels.iter_mut().zip(px) {
+            let rgba = p.to_array().map(|v| v as f32 / 255.0);
+            for i in 0..3 {
+                out[i] = rgba[i] + out[i] * (1.0 - rgba[3]);
+            }
+            out[3] = 1.0;
+        }
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    #[test]
+    fn uv_mask_cache_follows_native_overlay_display_options() {
+        let _gpu = photocraft_testkit::gpu_lock();
+        let mut app = PhotocraftApp::new(photocraft_engine::Session::new(), Default::default());
+        let first = key(&app, 0);
+        app.session.prefs.edit(|p| p.layer_mask_overlay.color = "#00ff00".into());
+        let green = key(&app, 0);
+        assert_ne!(first, green);
+        app.session.prefs.edit(|p| p.layer_mask_overlay.opacity = 75.0);
+        assert_ne!(green, key(&app, 0));
+    }
+}
diff --git a/crates/ui-egui/src/uv_mask_paint.rs b/crates/ui-egui/src/uv_mask_paint.rs
new file mode 100644
index 000000000..c81b00f52
--- /dev/null
+++ b/crates/ui-egui/src/uv_mask_paint.rs
@@ -0,0 +1,1613 @@
+//! Local experimental mask-effect list, visible only while a mask is selected in 3D.
+use crate::{PhotocraftApp, theme::Tokens};
+use photocraft_doc::{Layer, mask_paint::EffectKind};
+use serde_json::{Value, json};
+
+const MASK_EFFECT_ROW_INDENT: f32 = 28.0;
+const MASK_EFFECT_BLEND_WIDTH: f32 = 58.0;
+const MASK_EFFECT_OPACITY_WIDTH: f32 = 40.0;
+
+#[derive(Clone, Copy)]
+struct LevelsPicker {
+    doc: u64,
+    layer: u64,
+    index: usize,
+    point: u8,
+    tool: crate::state::Tool,
+}
+
+fn levels_picker_id() -> egui::Id {
+    egui::Id::unique("uv-mask-levels-picker")
+}
+
+pub(crate) fn levels_picker_active(app: &PhotocraftApp, ctx: &egui::Context) -> bool {
+    ctx.data(|data| data.get_temp::<LevelsPicker>(levels_picker_id())).is_some_and(|picker| {
+        picker.tool == app.ui.tool
+            && app.session.active().is_some_and(|st| {
+                st.doc.id.0 == picker.doc
+                    && st.active_layer.is_some_and(|layer| layer.0 == picker.layer)
+                    && selected_effect(ctx, picker.doc, picker.layer) == Some(picker.index)
+            })
+    })
+}
+
+fn picker_point(app: &PhotocraftApp, ctx: &egui::Context) -> Option<LevelsPicker> {
+    ctx.data(|data| data.get_temp::<LevelsPicker>(levels_picker_id())).filter(|picker| {
+        picker.tool == app.ui.tool
+            && app.session.active().is_some_and(|st| {
+                st.doc.id.0 == picker.doc
+                    && st.active_layer.is_some_and(|layer| layer.0 == picker.layer)
+                    && selected_effect(ctx, picker.doc, picker.layer) == Some(picker.index)
+            })
+    })
+}
+
+/// Apply one bounded grayscale sample from the Levels input prefix.
+pub(crate) fn sample_levels_at(app: &mut PhotocraftApp, ctx: &egui::Context, point: [f64; 2]) -> bool {
+    sample_levels_at_inner(app, ctx, point)
+}
+
+pub(crate) fn sample_levels_at_uv(app: &mut PhotocraftApp, ctx: &egui::Context, material: usize, uv: [f64; 2]) -> bool {
+    let Some(picker) = picker_point(app, ctx) else { return false };
+    let Some(st) = app.session.active() else { return false };
+    if uv.iter().any(|value| !value.is_finite() || !(0.0..=1.0).contains(value)) {
+        return true;
+    }
+    let channel = app.session.uv.current_channel();
+    if app.session.uv.map_bindings(channel).get(material).copied().flatten() != Some(st.doc.id) {
+        return true;
+    }
+    let point = [uv[0] * f64::from(st.doc.size.width), (1.0 - uv[1]) * f64::from(st.doc.size.height)];
+    let _ = picker;
+    sample_levels_at_inner(app, ctx, point)
+}
+
+fn sample_levels_at_inner(app: &mut PhotocraftApp, ctx: &egui::Context, point: [f64; 2]) -> bool {
+    let Some(picker) = picker_point(app, ctx) else { return false };
+    let Some(st) = app.session.active() else { return false };
+    if !point[0].is_finite()
+        || !point[1].is_finite()
+        || point[0] < 0.0
+        || point[1] < 0.0
+        || point[0] >= f64::from(st.doc.size.width)
+        || point[1] >= f64::from(st.doc.size.height)
+    {
+        return true;
+    }
+    let Some(stack) = st.doc.layer(photocraft_doc::LayerId(picker.layer)).and_then(|layer| layer.mask.as_ref()).and_then(|mask| mask.paint.as_ref()) else {
+        return false;
+    };
+    let (x, y) = (point[0].floor() as i32, point[1].floor() as i32);
+    let Some(sample) =
+        photocraft_compose::mask_paint::compose_prefix(stack, picker.index, photocraft_geom::Rect::new(x, y, x.saturating_add(1), y.saturating_add(1)))
+            .and_then(|values| values.first().copied())
+    else {
+        return true;
+    };
+    let Some(effect) = stack.layers.get(picker.index) else { return true };
+    let EffectKind::Levels { input_black, input_white, .. } = &effect.kind else { return true };
+    let sample = sample.clamp(0.0, 1.0);
+    let params = match picker.point {
+        0 => json!({"layer":picker.layer,"index":picker.index,"input_black":sample.min(*input_white - 0.002)}),
+        1 => {
+            let t = ((sample - *input_black) / (*input_white - *input_black).max(0.002)).clamp(0.01, 0.99);
+            let next_gamma = (t.ln() / 0.5f32.ln()).clamp(0.01, 9.99);
+            json!({"layer":picker.layer,"index":picker.index,"gamma":next_gamma})
+        }
+        _ => json!({"layer":picker.layer,"index":picker.index,"input_white":sample.max(*input_black + 0.002)}),
+    };
+    if let Err(error) = app.run("uv.maskPaint.modify", params) {
+        app.ui.status = error;
+        app.ui.status_error = true;
+    }
+    true
+}
+
+pub(crate) fn prune_levels_picker(app: &PhotocraftApp, ctx: &egui::Context) {
+    if ctx.input(|input| input.key_pressed(egui::Key::Escape)) || !levels_picker_active(app, ctx) {
+        ctx.data_mut(|data| data.remove::<LevelsPicker>(levels_picker_id()));
+    }
+}
+
+fn effect_selection_id(doc: u64, layer: u64) -> egui::Id {
+    egui::Id::unique(("uv-mask-effect-selection", doc, layer))
+}
+
+fn expanded_effects_id() -> egui::Id {
+    egui::Id::unique("uv-mask-paint-expanded-layer")
+}
+
+/// Open the selected layer's mask stack without switching the canvas to mask display.
+pub(crate) fn expand_effects(ctx: &egui::Context, doc: u64, layer: u64) {
+    ctx.data_mut(|data| data.insert_temp(expanded_effects_id(), (doc, layer)));
+}
+
+/// Collapse the mask stack when the user returns to the layer's image thumbnail/row.
+pub(crate) fn collapse_effects(ctx: &egui::Context) {
+    ctx.data_mut(|data| data.remove_temp::<(u64, u64)>(expanded_effects_id()));
+}
+
+fn effects_expanded(ctx: &egui::Context, doc: u64, layer: u64) -> bool {
+    ctx.data(|data| data.get_temp::<(u64, u64)>(expanded_effects_id())) == Some((doc, layer))
+}
+
+pub(crate) fn clear_effect_selection(ctx: &egui::Context, doc: u64, layer: u64) {
+    ctx.data_mut(|data| data.remove::<usize>(effect_selection_id(doc, layer)));
+}
+
+pub(crate) fn select_effect(ctx: &egui::Context, doc: u64, layer: u64, index: usize) {
+    ctx.data_mut(|data| data.insert_temp(effect_selection_id(doc, layer), index));
+}
+
+pub(crate) fn selected_effect(ctx: &egui::Context, doc: u64, layer: u64) -> Option<usize> {
+    ctx.data_mut(|data| data.get_temp::<usize>(effect_selection_id(doc, layer)))
+}
+
+#[derive(Clone, Copy)]
+struct EffectDrag {
+    doc: u64,
+    layer: u64,
+    index: usize,
+}
+
+#[derive(Clone, Copy)]
+struct PendingEffectClick {
+    doc: u64,
+    layer: u64,
+    index: usize,
+    at: f64,
+    alt: bool,
+}
+
+fn effect_drag_id() -> egui::Id {
+    egui::Id::unique("uv-mask-effect-drag")
+}
+
+fn pending_effect_click_id() -> egui::Id {
+    egui::Id::unique("uv-mask-effect-click")
+}
+
+fn effect_rename_id(doc: u64, layer: u64, index: usize) -> egui::Id {
+    egui::Id::unique(("uv-mask-effect-rename", doc, layer, index))
+}
+
+fn queue_effect_selection(app: &PhotocraftApp, layer: photocraft_doc::LayerId, index: usize, alt: bool, actions: &mut Vec<(String, Value)>) {
+    let already_showing_this_mask = app
+        .session
+        .active()
+        .and_then(photocraft_engine::mask_view_cmds::current)
+        .is_some_and(|view| view.layer == layer && view.mode == photocraft_engine::mask_view_cmds::MaskViewMode::Gray);
+    let show_mask = gray_view_after_effect_click(already_showing_this_mask, alt);
+    actions.push(("ui.maskTarget".into(), json!({"enabled":true,"show":show_mask})));
+    actions.push(("uv.maskPaint.select".into(), json!({"layer":layer.0,"index":index})));
+}
+
+/// Convert a visual insertion boundary to the final engine index after removing the source row.
+fn effect_drop_index(count: usize, source: usize, target: usize, above: bool) -> Option<usize> {
+    if count == 0 || source >= count || target >= count {
+        return None;
+    }
+    // Rows are displayed in reverse stack order. Inserting above a visual row means inserting
+    // after its engine index; below means before it. The engine's `to` parameter is the final
+    // index after removing the source row, so shift the boundary left when the source precedes it.
+    let boundary = if above { target + 1 } else { target };
+    Some(if source < boundary { boundary - 1 } else { boundary }.min(count - 1))
+}
+
+/// Mirror the engine's active mask-effect identity into the Properties selection after add/select.
+pub(crate) fn show_active_effect_properties(app: &mut PhotocraftApp, ctx: &egui::Context) -> bool {
+    let Some((doc, layer, index)) = app.session.active().and_then(|state| {
+        let layer = state.active_layer?;
+        let index = state.doc.layer(layer)?.mask.as_ref()?.paint.as_ref()?.active;
+        Some((state.doc.id.0, layer.0, index))
+    }) else {
+        return false;
+    };
+    select_effect(ctx, doc, layer, index);
+    app.ui.mask_target = true;
+    app.ui.vector_mask_target = false;
+    app.ui.filter_mask_target = None;
+    app.sync_mask_targets();
+    app.ui.panels.properties = true;
+    app.ui.dock_tabs.properties = 0;
+    app.ui.dock.collapsed.retain(|group| *group != crate::dock::Group::Properties);
+    true
+}
+
+fn effect_is_selected(ctx: &egui::Context, doc: u64, layer: u64, index: usize) -> bool {
+    selected_effect(ctx, doc, layer) == Some(index)
+}
+
+pub(crate) fn rows(app: &mut PhotocraftApp, ui: &mut egui::Ui, layer: &Layer, actions: &mut Vec<(String, Value)>) -> bool {
+    let Some(doc_id) = app.session.active().map(|st| st.doc.id.0) else { return false };
+    if app.ui.workspace != "3D" || !effects_expanded(ui.ctx(), doc_id, layer.id.0) || app.session.active().and_then(|s| s.active_layer) != Some(layer.id) {
+        return false;
+    }
+    let Some(stack) = layer.mask.as_ref().and_then(|m| m.paint.as_ref()) else { return false };
+    let tokens = Tokens::get(ui.ctx());
+    if let Some(pending) = ui.ctx().data(|data| data.get_temp::<PendingEffectClick>(pending_effect_click_id())) {
+        let now = ui.input(|input| input.time);
+        if pending.doc != doc_id || pending.layer != layer.id.0 {
+            ui.ctx().data_mut(|data| data.remove::<PendingEffectClick>(pending_effect_click_id()));
+        } else if now - pending.at > 0.30 {
+            queue_effect_selection(app, layer.id, pending.index, pending.alt, actions);
+            ui.ctx().data_mut(|data| data.remove::<PendingEffectClick>(pending_effect_click_id()));
+        }
+    }
+    let mut row_rects = Vec::with_capacity(stack.layers.len());
+    for (index, paint) in stack.layers.iter().enumerate().rev() {
+        ui.push_id(("mask-paint", layer.id.0, index), |ui| {
+            let row_bounds = ui.available_rect_before_wrap().intersect(ui.clip_rect());
+            let response = ui
+                .horizontal(|ui| {
+                    ui.spacing_mut().item_spacing.x = 1.0;
+                    let has_blend = matches!(&paint.kind, EffectKind::Paint | EffectKind::Fill { .. } | EffectKind::Blur { .. });
+                    let blend_width = if has_blend { MASK_EFFECT_BLEND_WIDTH } else { 0.0 };
+                    // Compact controls stay readable while leaving the name the remaining width.
+                    let opacity_width = MASK_EFFECT_OPACITY_WIDTH;
+                    let delete_width = 16.0;
+                    let spacing = ui.spacing().item_spacing.x;
+                    let gaps = (if has_blend { 6.0 } else { 5.0 }) * spacing;
+                    // Squeeze the child indent first on narrow panels, then give the name every
+                    // remaining pixel between its icon and Blend. The small reserve covers rounding.
+                    let available_width = ui.available_width().min(row_bounds.width());
+                    let fixed_width = 16.0 + 14.0 + blend_width + opacity_width + delete_width + gaps + 2.0;
+                    let indent = MASK_EFFECT_ROW_INDENT.min((available_width - fixed_width - 24.0).max(0.0));
+                    let name_width = (available_width - fixed_width - indent).max(0.0);
+                    ui.add_space(indent);
+                    let (eye, eye_response) = ui.allocate_exact_size(egui::vec2(16.0, 20.0), egui::Sense::click());
+                    crate::icons::paint(
+                        ui,
+                        eye,
+                        if paint.visible { "eye" } else { "eye-off" },
+                        12.0,
+                        if paint.visible { tokens.icon } else { tokens.text_faint },
+                    );
+                    let eye_response = eye_response.on_hover_text(tl!("Visibility"));
+                    eye_response.widget_info(|| egui::WidgetInfo::labeled(egui::Role::Button, true, tl!("Visibility")));
+                    if eye_response.clicked() {
+                        actions.push(("uv.maskPaint.modify".into(), json!({"layer":layer.id.0,"index":index,"visible":!paint.visible})));
+                    }
+                    let (icon_rect, icon_response) = ui.allocate_exact_size(egui::vec2(14.0, 20.0), egui::Sense::click());
+                    let icon = match &paint.kind {
+                        EffectKind::Paint => "brush",
+                        EffectKind::Fill { .. } => "paint-bucket",
+                        EffectKind::Levels { .. } => "contrast",
+                        EffectKind::Blur { .. } => "droplet",
+                    };
+                    crate::icons::paint(ui, icon_rect, icon, 12.0, tokens.icon);
+                    let selected = effect_is_selected(ui.ctx(), doc_id, layer.id.0, index);
+                    icon_response.widget_info(|| egui::WidgetInfo::labeled(egui::Role::Button, true, tl!("Select mask effect")));
+                    if icon_response.clicked_by(egui::PointerButton::Primary) {
+                        queue_effect_selection(app, layer.id, index, ui.input(|input| input.modifiers.alt), actions);
+                    }
+                    let rename_id = effect_rename_id(doc_id, layer.id.0, index);
+                    let editing_name = ui.ctx().data(|data| data.get_temp::<String>(rename_id));
+                    if let Some(mut edited_name) = editing_name {
+                        let input_id = rename_id.with("input");
+                        let focus_id = rename_id.with("focus-on-entry");
+                        let response = ui
+                            .add_sized(
+                                egui::vec2(name_width, 20.0),
+                                egui::TextEdit::singleline(&mut edited_name).id(input_id).desired_width(name_width).char_limit(128),
+                            )
+                            .accessible_name(tl!("Name"));
+                        if ui.ctx().data_mut(|data| data.remove_temp::<bool>(focus_id).unwrap_or(false)) {
+                            response.request_focus();
+                            crate::field_tab::select_all(ui.ctx(), input_id, &edited_name);
+                        }
+                        if response.changed() {
+                            ui.ctx().data_mut(|data| data.insert_temp(rename_id, edited_name.clone()));
+                        }
+                        let escape = ui.input(|input| input.key_pressed(egui::Key::Escape));
+                        let enter = ui.input(|input| input.key_pressed(egui::Key::Enter));
+                        if escape {
+                            ui.ctx().data_mut(|data| {
+                                data.remove::<String>(rename_id);
+                                data.remove::<bool>(focus_id);
+                            });
+                        } else if enter || response.lost_focus() {
+                            if edited_name != paint.name {
+                                actions.push(("uv.maskPaint.modify".into(), json!({"layer":layer.id.0,"index":index,"name":edited_name})));
+                            }
+                            ui.ctx().data_mut(|data| {
+                                data.remove::<String>(rename_id);
+                                data.remove::<bool>(focus_id);
+                            });
+                        }
+                    } else {
+                        let name = ui
+                            .add_sized(
+                                egui::vec2(name_width, 20.0),
+                                egui::Button::selectable(selected, &paint.name).truncate().sense(egui::Sense::click_and_drag()),
+                            )
+                            .on_hover_text(&paint.name);
+                        if name.double_clicked_by(egui::PointerButton::Primary) {
+                            ui.ctx().data_mut(|data| {
+                                data.remove::<PendingEffectClick>(pending_effect_click_id());
+                                data.insert_temp(rename_id, paint.name.clone());
+                                data.insert_temp(rename_id.with("focus-on-entry"), true);
+                            });
+                            ui.ctx().memory_mut(|memory| memory.request_focus(rename_id.with("input")));
+                        } else if name.drag_started_by(egui::PointerButton::Primary) {
+                            ui.ctx().data_mut(|data| {
+                                data.remove::<PendingEffectClick>(pending_effect_click_id());
+                                data.insert_temp(effect_drag_id(), EffectDrag { doc: doc_id, layer: layer.id.0, index });
+                            });
+                        } else if name.clicked_by(egui::PointerButton::Primary) {
+                            let now = ui.input(|input| input.time);
+                            let alt = ui.input(|input| input.modifiers.alt);
+                            let pending = ui.ctx().data(|data| data.get_temp::<PendingEffectClick>(pending_effect_click_id()));
+                            ui.ctx().data_mut(|data| data.remove::<PendingEffectClick>(pending_effect_click_id()));
+                            if let Some(pending) = pending
+                                && (pending.doc != doc_id || pending.layer != layer.id.0 || pending.index != index || now - pending.at > 0.30)
+                            {
+                                queue_effect_selection(app, photocraft_doc::LayerId(pending.layer), pending.index, pending.alt, actions);
+                            }
+                            ui.ctx().data_mut(|data| {
+                                data.insert_temp(pending_effect_click_id(), PendingEffectClick { doc: doc_id, layer: layer.id.0, index, at: now, alt })
+                            });
+                            ui.ctx().request_repaint_after(std::time::Duration::from_millis(310));
+                        }
+                        name.context_menu(|ui| {
+                            add_menu(ui, layer.id.0, actions);
+                            ui.separator();
+                            for (label, to, enabled) in [
+                                (tl!("Move Up"), index.saturating_add(1), index + 1 < stack.layers.len()),
+                                (tl!("Move Down"), index.saturating_sub(1), index > 0),
+                            ] {
+                                if ui.add_enabled(enabled, egui::Button::new(label)).clicked() {
+                                    actions.push(("uv.maskPaint.modify".into(), json!({"layer":layer.id.0,"index":index,"to":to})));
+                                    ui.close();
+                                }
+                            }
+                        });
+                    }
+                    if has_blend {
+                        blend_selector(ui, doc_id, layer.id.0, index, paint.blend, actions);
+                    }
+                    opacity_popup(app, ui, layer.id, index, paint.opacity, actions);
+                    delete_effect_button(ui, layer.id.0, index, &paint.kind, actions);
+                })
+                .response;
+            if matches!(&paint.kind, EffectKind::Fill { .. }) {
+                let drop_rect =
+                    egui::Rect::from_min_max(egui::pos2(row_bounds.left(), response.rect.top()), egui::pos2(row_bounds.right(), response.rect.bottom()));
+                app.uv_cache.library.fill_targets.push((drop_rect, doc_id, layer.id.0, index));
+            }
+            row_rects.push((index, response.rect));
+            ui.painter().hline(response.rect.x_range(), response.rect.bottom(), egui::Stroke::new(0.5, tokens.text_faint));
+        });
+    }
+    let drag = ui.ctx().data(|data| data.get_temp::<EffectDrag>(effect_drag_id()));
+    if let Some(drag) = drag.filter(|drag| drag.doc == doc_id && drag.layer == layer.id.0) {
+        let pointer = ui.input(|input| input.pointer.interact_pos());
+        let released = ui.input(|input| input.pointer.button_released(egui::PointerButton::Primary));
+        if let Some(pointer) = pointer {
+            if let Some((target, rect)) = row_rects.iter().find(|(_, rect)| rect.contains(pointer)) {
+                let above = pointer.y < rect.center().y;
+                let to = effect_drop_index(stack.layers.len(), drag.index, *target, above);
+                let line_y = if above { rect.top() } else { rect.bottom() };
+                ui.painter().hline(rect.x_range(), line_y, egui::Stroke::new(2.0, tokens.accent));
+                if let Some(to) = to.filter(|to| released && *to != drag.index) {
+                    actions.push(("uv.maskPaint.modify".into(), json!({"layer":layer.id.0,"index":drag.index,"to":to})));
+                }
+            }
+        }
+        if released {
+            ui.ctx().data_mut(|data| data.remove::<EffectDrag>(effect_drag_id()));
+        }
+    }
+    !stack.layers.is_empty()
+}
+
+fn delete_effect_label(kind: &EffectKind) -> &'static str {
+    match kind {
+        EffectKind::Paint => tl!("Delete Paint layer"),
+        EffectKind::Fill { .. } => tl!("Delete Fill layer"),
+        EffectKind::Levels { .. } => tl!("Delete Levels layer"),
+        EffectKind::Blur { .. } => tl!("Delete Blur layer"),
+    }
+}
