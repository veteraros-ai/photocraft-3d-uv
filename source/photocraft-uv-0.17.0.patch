+pub(crate) fn has_channel(app: &PhotocraftApp, channel: Channel) -> bool {
+    let bindings = app.session.uv.map_bindings(channel);
+    bindings.iter().flatten().any(|id| app.session.documents().iter().any(|d| d.doc.id == *id))
+}
