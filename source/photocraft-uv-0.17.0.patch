+        );
+        app.run("edit.undo", json!({})).unwrap();
+        assert_eq!(
+            app.session.active().unwrap().doc.layer(layer_id).unwrap().mask.as_ref().unwrap().paint.as_ref().unwrap().layers[0].fill_bounds,
+            initial_bounds
