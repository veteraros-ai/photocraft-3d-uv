+//! Project the native Clone Source overlay onto visible UV triangles, without GPU readback.
+use crate::PhotocraftApp;
+use egui::{Pos2, Rect};
+use photocraft_uv::{
+    Scene,
+    prepared::Geometry,
+    preview::{Camera, Materials},
+};
+
+// Clipping is in screen f32 coordinates. Its boundary vertices can land a few
+// ulps outside the original f64 triangle: evaluate its affine map without an
+// inside-triangle rejection, or neighboring preview triangles acquire holes.
+fn weights(p: [f64; 2], t: [[f64; 2]; 3]) -> Option<[f64; 3]> {
+    let [a, b, c] = t;
+    let cross = |a: [f64; 2], b: [f64; 2]| a[0] * b[1] - a[1] * b[0];
+    let e = [b[0] - a[0], b[1] - a[1]];
+    let f = [c[0] - a[0], c[1] - a[1]];
+    let q = [p[0] - a[0], p[1] - a[1]];
+    let area = cross(e, f);
+    if !area.is_finite() || area.abs() < 1e-15 {
+        return None;
+    }
+    let (v, w) = (cross(q, f) / area, cross(e, q) / area);
+    Some([1.0 - v - w, v, w])
+}
+
+#[allow(clippy::too_many_arguments)]
+pub(crate) fn preview(
+    app: &mut PhotocraftApp,
+    ui: &egui::Ui,
+    g: &Geometry,
+    scene: &Scene,
+    camera: Camera,
+    maps: &Materials<'_>,
+    size: [u32; 2],
+    viewport: Rect,
+) {
+    let Some(p) = ui.input(|i| i.pointer.hover_pos()).filter(|p| viewport.contains(*p)) else { return };
+    let at = (p - viewport.min) / viewport.size();
+    let Some(hit) = g.hit(scene, camera, maps, [f64::from(at.x), f64::from(at.y)], size) else { return };
+    let Some(tri) = g.triangles.get(hit.triangle) else { return };
+    let Some(st) = app.session.active() else { return };
+    if app.session.uv.map_bindings(app.session.uv.current_channel()).get(tri.material).copied().flatten() != Some(st.doc.id) {
+        return;
+    }
+    let dimensions = [f64::from(st.doc.size.width), f64::from(st.doc.size.height)];
+    let point = [hit.uv[0] * dimensions[0], (1.0 - hit.uv[1]) * dimensions[1]];
+    let painter = ui.painter_at(viewport);
+    let Some((texture, patch, tint)) = crate::canvas::clone_preview_texture(app, &painter, point, None) else { return };
+    if patch.is_empty() {
+        return;
+    }
+    let rect = Rect::from_min_max(egui::pos2(patch.x0 as f32, patch.y0 as f32), egui::pos2(patch.x1 as f32, patch.y1 as f32));
+    let mut mesh = egui::Mesh::with_texture(texture);
+    for (id, t) in g.triangles.iter().enumerate().filter(|(_, t)| t.material == tri.material) {
+        let uv = t.uv.map(|q| [f64::from(q[0]) * dimensions[0], (1.0 - f64::from(q[1])) * dimensions[1]]);
+        let points = uv.map(|q| egui::pos2(q[0] as f32, q[1] as f32));
+        if !Rect::from_points(&points).intersects(rect) {
+            continue;
+        }
+        let mut poly = points.to_vec();
+        for (axis, edge, sign) in [(0, rect.left(), -1.0), (0, rect.right(), 1.0), (1, rect.top(), -1.0), (1, rect.bottom(), 1.0)] {
+            let mut out = Vec::new();
+            for (a, b) in poly.iter().zip(poly.iter().cycle().skip(1)).take(poly.len()) {
+                let val = |p: Pos2| ((if axis == 0 { p.x } else { p.y }) - edge) * sign;
+                let (a0, b0) = (val(*a), val(*b));
+                if a0 <= 0.0 {
+                    out.push(*a);
+                }
+                if (a0 <= 0.0) != (b0 <= 0.0) {
+                    out.push(a.lerp(*b, a0 / (a0 - b0)));
+                }
+            }
+            poly = out;
+        }
+        if poly.len() < 3 {
+            continue;
+        }
+        let center = poly.iter().fold(egui::Vec2::ZERO, |a, p| a + p.to_vec2()) / poly.len() as f32;
+        let Some(center_weights) = weights([f64::from(center.x), f64::from(center.y)], uv) else { continue };
+        let position = std::array::from_fn(|j| t.positions.iter().zip(center_weights).map(|(p, w)| f64::from(p[j]) * w).sum());
+        let Some(q) = g.project_normalized(camera, position, size) else { continue };
+        // Discard occluded triangles; the source must not shine through another part of the mesh.
+        if id != hit.triangle && g.hit(scene, camera, maps, q, size).is_none_or(|h| h.triangle != id) {
+            continue;
+        }
+        let mut vertices = Vec::new();
+        for p in poly {
+            let Some(w) = weights([f64::from(p.x), f64::from(p.y)], uv) else { continue };
+            let pos = std::array::from_fn(|j| t.positions.iter().zip(w).map(|(p, w)| f64::from(p[j]) * w).sum());
+            let Some(q) = g.project_normalized(camera, pos, size) else { continue };
+            vertices.push(egui::epaint::Vertex {
+                pos: viewport.min + egui::vec2(q[0] as f32 * viewport.width(), q[1] as f32 * viewport.height()),
+                uv: egui::pos2((p.x - patch.x0 as f32) / patch.width() as f32, (p.y - patch.y0 as f32) / patch.height() as f32),
+                color: tint,
+            });
+        }
+        let base = mesh.vertices.len() as u32;
+        for i in 1..vertices.len().saturating_sub(1) {
+            mesh.indices.extend_from_slice(&[base, base + i as u32, base + i as u32 + 1]);
+        }
+        mesh.vertices.extend(vertices);
+    }
+    painter.add(egui::Shape::mesh(mesh));
+}
diff --git a/crates/ui-egui/src/uv_damage.rs b/crates/ui-egui/src/uv_damage.rs
new file mode 100644
index 000000000..3eaaf346e
--- /dev/null
+++ b/crates/ui-egui/src/uv_damage.rs
@@ -0,0 +1,144 @@
+//! Retained COW snapshots recover sparse changes across multiple commits in one frame.
+use photocraft_doc::{Document, LayerContent};
+use photocraft_geom::Rect;
+use std::sync::Arc;
+
+pub(crate) fn regions(previous: &mut Option<Arc<Document>>, doc: &Arc<Document>, fallback: Option<Rect>) -> Vec<Rect> {
+    let old = previous.replace(doc.clone());
+    let regions = match sparse(old.as_deref(), doc) {
+        Some(regions) => regions.into_iter().map(|r| fallback.map_or(r, |f| r.intersect(&f))).filter(|r| !r.is_empty()).collect(),
+        None => vec![fallback.unwrap_or_else(|| doc.bounds())],
+    };
+    coalesce(regions, doc.bounds())
+}
+
+fn coalesce(mut regions: Vec<Rect>, bounds: Rect) -> Vec<Rect> {
+    // Full adjustments must become one upload, not one submission per raster tile.
+    regions.sort_by_key(|r| (r.y0, r.y1, r.x0, r.x1));
+    let mut rows: Vec<Rect> = Vec::new();
+    for r in regions {
+        if let Some(last) = rows.last_mut()
+            && last.y0 == r.y0
+            && last.y1 == r.y1
+            && r.x0 <= last.x1
+        {
+            last.x1 = last.x1.max(r.x1);
+        } else {
+            rows.push(r);
+        }
+    }
+    rows.sort_by_key(|r| (r.x0, r.x1, r.y0, r.y1));
+    let mut out: Vec<Rect> = Vec::new();
+    for r in rows {
+        if let Some(last) = out.last_mut()
+            && last.x0 == r.x0
+            && last.x1 == r.x1
+            && r.y0 <= last.y1
+        {
+            last.y1 = last.y1.max(r.y1);
+        } else {
+            out.push(r);
+        }
+    }
+    let area: u64 = out.iter().map(|r| u64::from(r.width()) * u64::from(r.height())).sum();
+    if out.len() > 64 && area > u64::from(bounds.width()) * u64::from(bounds.height()) / 4 {
+        vec![out.iter().fold(Rect::EMPTY, |a, b| a.union(b))]
+    } else {
+        out
+    }
+}
+
+// Compare only changed encoded tiles. Equal rows are a byte comparison, without
+// allocating float buffers or decoding untouched texels at a distant UV seam.
+fn changed_bounds(a: Option<&[u8]>, b: Option<&[u8]>, default: &[u8], bpp: usize) -> Option<Rect> {
+    let side = photocraft_geom::TILE_SIZE as usize;
+    let stride = side.checked_mul(bpp)?;
+    if stride == 0 {
+        return None;
+    }
+    let mut bounds = Rect::EMPTY;
+    for y in 0..side {
+        let range = y * stride..(y + 1) * stride;
+        let (a, b) = (a.and_then(|a| a.get(range.clone())), b.and_then(|b| b.get(range)));
+        if a.zip(b).is_some_and(|(a, b)| a == b) {
+            continue;
+        }
+        let equal = |x: usize| {
+            let range = x * bpp..(x + 1) * bpp;
+            a.and_then(|v| v.get(range.clone())).unwrap_or(default) == b.and_then(|v| v.get(range)).unwrap_or(default)
+        };
+        if let Some(left) = (0..side).find(|x| !equal(*x)) {
+            let right = (left..side).rfind(|x| !equal(*x)).unwrap_or(left) + 1;
+            bounds = bounds.union(&Rect::new(left as i32, y as i32, right as i32, y as i32 + 1));
+        }
+    }
+    (!bounds.is_empty()).then_some(bounds)
+}
+fn sparse(old: Option<&Document>, doc: &Document) -> Option<Vec<Rect>> {
+    let old = old.filter(|old| old.id == doc.id && old.size == doc.size && old.layers.len() == doc.layers.len())?;
+    let mut probe = doc.clone();
+    let mut regions = Vec::new();
+    // Group/effect/adjustment changes use the compositor's conservative damage path.
+    for (a, b) in old.layers.iter().zip(&mut probe.layers) {
+        match (&a.content, &mut b.content) {
+            (LayerContent::Raster(x), LayerContent::Raster(y)) => {
+                if x.format() != y.format() || x.default_bytes() != y.default_bytes() {
+                    return None;
+                }
+                let coords: std::collections::BTreeSet<_> = x.tiles().chain(y.tiles()).map(|(coord, _)| *coord).collect();
+                for coord in coords {
+                    let (a, b) = (x.tile(coord), y.tile(coord));
+                    if a.zip(b).is_some_and(|(a, b)| Arc::ptr_eq(a, b)) {
+                        continue;
+                    }
+                    if let Some(local) = changed_bounds(a.map(|t| t.bytes()), b.map(|t| t.bytes()), x.default_bytes(), x.format().bytes_per_pixel()) {
+                        let origin = coord.rect();
+                        regions.push(Rect::new(origin.x0 + local.x0, origin.y0 + local.y0, origin.x0 + local.x1, origin.y0 + local.y1));
+                    }
+                }
+                *y = x.clone();
+            }
+            _ => return None,
+        }
+    }
+    if !photocraft_engine::layer_multi_cmds::same_pixels(old, &probe) {
+        return None;
+    }
+    let reach = crate::canvas::effect_reach(&doc.layers);
+    Some(regions.into_iter().map(|r| r.inflate(reach).intersect(&doc.bounds())).filter(|r| !r.is_empty()).collect())
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    #[test]
+    fn full_adjustments_merge_tiles_but_distant_islands_remain_separate() {
+        let _gpu = photocraft_testkit::gpu_lock();
+        let bounds = Rect::from_xywh(0, 0, 4096, 4096);
+        let tiles = (0..16).flat_map(|y| (0..16).map(move |x| Rect::from_xywh(x * 256, y * 256, 256, 256))).collect();
+        assert_eq!(coalesce(tiles, bounds), vec![bounds]);
+        let islands = vec![Rect::from_xywh(1, 1, 20, 20), Rect::from_xywh(3800, 1, 20, 20)];
+        assert_eq!(coalesce(islands.clone(), bounds), islands);
+    }
+    #[test]
+    fn uv_damage_recovers_distant_tiles_across_multiple_commits_and_undo() {
+        let _gpu = photocraft_testkit::gpu_lock();
+        let mut s = photocraft_engine::Session::new();
+        s.execute("file.new", serde_json::json!({"width":4096,"height":4096})).unwrap();
+        let before = s.active().unwrap().doc.clone();
+        let mut previous = Some(before.clone());
+        for x in [20, 3800] {
+            s.edit("point", |doc, layer| {
+                doc.layer_mut(layer.unwrap()).unwrap().surface_mut().unwrap().write_pixel(x, 20, &[1.0, 0.0, 0.0, 1.0]);
+                Ok(())
+            })
+            .unwrap();
+        }
+        let current = s.active().unwrap().doc.clone();
+        let rects = regions(&mut previous, &current, None);
+        assert_eq!(rects.len(), 2);
+        assert_eq!(rects.iter().map(|r| u64::from(r.width()) * u64::from(r.height())).sum::<u64>(), 2);
+        s.execute("edit.undo", serde_json::json!({})).unwrap();
+        assert_eq!(regions(&mut previous, &s.active().unwrap().doc, None).len(), 1);
+    }
+}
diff --git a/crates/ui-egui/src/uv_gpu.rs b/crates/ui-egui/src/uv_gpu.rs
new file mode 100644
index 000000000..33d8d1cea
--- /dev/null
+++ b/crates/ui-egui/src/uv_gpu.rs
@@ -0,0 +1,2691 @@
+//! GPU-resident model preview. Only camera uniforms change during navigation.
+//! Separate depth/MSAA attachments keep the editor's own render pass untouched.
+use eframe::{
+    egui_wgpu::RenderState,
+    wgpu::{self, util::DeviceExt},
+};
+use photocraft_uv::{
+    Scene,
+    prepared::Geometry,
+    preview::{Camera, Image},
+};
+use std::{collections::BTreeSet, sync::Arc};
+
+const FORMAT: wgpu::TextureFormat = wgpu::TextureFormat::Rgba8Unorm;
+const DEPTH: wgpu::TextureFormat = wgpu::TextureFormat::Depth32Float;
+const STRIDE: u64 = 72;
+type Key = (u64, u64, u64, u64);
+struct GpuSurface {
+    maps: Vec<Map>,
+    gpu_spares: Vec<Option<Map>>,
+    present: [bool; 5],
+    use_color_for_pbr: bool,
+    version: u64,
+}
+impl GpuSurface {
+    fn flags(&self) -> u32 {
+        self.present.iter().enumerate().fold(0, |bits, (i, yes)| bits | (u32::from(*yes) << i))
+    }
+}
+struct GpuEnvironment {
+    source: Arc<photocraft_uv::lighting::Environment>,
+    layout: wgpu::BindGroupLayout,
+    output_hash: u64,
+    group: wgpu::BindGroup,
+    _textures: Vec<wgpu::Texture>,
+}
+impl GpuEnvironment {
+    fn new(
+        rs: &RenderState,
+        _mips: &crate::uv_mips::Mips,
+        source: Arc<photocraft_uv::lighting::Environment>,
+        output: Option<&(u64, Image)>,
+    ) -> Result<Self, String> {
+        let device = &rs.device;
+        let layout = device.create_bind_group_layout(&wgpu::BindGroupLayoutDescriptor {
+            label: Some("uv environment"),
+            entries: &[
+                env_texture_entry(0),
+                env_texture_entry(1),
+                wgpu::BindGroupLayoutEntry {
+                    binding: 2,
+                    visibility: wgpu::ShaderStages::FRAGMENT,
+                    ty: wgpu::BindingType::Sampler(wgpu::SamplerBindingType::Filtering),
+                    count: None,
+                },
+                env_texture_entry(3),
+                env_texture_entry(4),
+            ],
+        });
+        let upload = |levels: &[Image]| -> Result<(wgpu::Texture, wgpu::TextureView), String> {
+            let first = levels.first().ok_or("Empty environment")?;
+            let tex = device.create_texture(&wgpu::TextureDescriptor {
+                label: Some("uv linear HDR environment"),
+                size: extent([first.width as u32, first.height as u32]),
+                mip_level_count: levels.len() as u32,
+                sample_count: 1,
+                dimension: wgpu::TextureDimension::D2,
+                format: wgpu::TextureFormat::Rgba16Float,
+                usage: wgpu::TextureUsages::TEXTURE_BINDING | wgpu::TextureUsages::COPY_DST,
+                view_formats: &[],
+            });
+            for (mip, im) in levels.iter().enumerate() {
+                let data: Vec<_> = im.rgba.iter().flat_map(|p| p.iter().flat_map(|x| crate::gpu_canvas::f32_to_f16(*x).to_le_bytes())).collect();
+                rs.queue.write_texture(
+                    wgpu::TexelCopyTextureInfo { texture: &tex, mip_level: mip as u32, origin: wgpu::Origin3d::ZERO, aspect: wgpu::TextureAspect::All },
+                    &data,
+                    wgpu::TexelCopyBufferLayout { offset: 0, bytes_per_row: Some(im.width as u32 * 8), rows_per_image: Some(im.height as u32) },
+                    extent([im.width as u32, im.height as u32]),
+                );
+            }
+            let view = tex.create_view(&Default::default());
+            Ok((tex, view))
+        };
+        let (specular, sv) = upload(&source.specular)?;
+        let (diffuse, dv) = upload(std::slice::from_ref(&source.diffuse))?;
+        let (brdf, bv) = upload(std::slice::from_ref(&photocraft_uv::lighting::brdf_lut()))?;
+        let (output_texture, ov) = upload(std::slice::from_ref(output.map_or(&crate::uv_lighting::identity_lut(), |(_, im)| im)))?;
+        let sampler = device.create_sampler(&wgpu::SamplerDescriptor {
+            label: Some("uv sky sampler"),
+            address_mode_u: wgpu::AddressMode::Repeat,
+            address_mode_v: wgpu::AddressMode::ClampToEdge,
+            mag_filter: wgpu::FilterMode::Linear,
+            min_filter: wgpu::FilterMode::Linear,
+            mipmap_filter: wgpu::MipmapFilterMode::Linear,
+            ..Default::default()
+        });
+        let group = device.create_bind_group(&wgpu::BindGroupDescriptor {
+            label: Some("uv sky"),
+            layout: &layout,
+            entries: &[
+                wgpu::BindGroupEntry { binding: 0, resource: wgpu::BindingResource::TextureView(&sv) },
+                wgpu::BindGroupEntry { binding: 1, resource: wgpu::BindingResource::TextureView(&dv) },
+                wgpu::BindGroupEntry { binding: 2, resource: wgpu::BindingResource::Sampler(&sampler) },
+                wgpu::BindGroupEntry { binding: 3, resource: wgpu::BindingResource::TextureView(&bv) },
+                wgpu::BindGroupEntry { binding: 4, resource: wgpu::BindingResource::TextureView(&ov) },
+            ],
+        });
+        Ok(Self { source, layout, output_hash: output.map_or(0, |(hash, _)| *hash), group, _textures: vec![specular, diffuse, brdf, output_texture] })
+    }
+}
+fn env_texture_entry(binding: u32) -> wgpu::BindGroupLayoutEntry {
+    wgpu::BindGroupLayoutEntry {
+        binding,
+        visibility: wgpu::ShaderStages::FRAGMENT,
+        ty: wgpu::BindingType::Texture {
+            sample_type: wgpu::TextureSampleType::Float { filterable: true },
+            view_dimension: wgpu::TextureViewDimension::D2,
+            multisampled: false,
+        },
+        count: None,
+    }
+}
+struct Map {
+    texture: wgpu::Texture,
+    view: wgpu::TextureView,
+    size: [u32; 2],
+    key: Key,
+    // CPU snapshots only exist for CPU-uploaded maps. A compositor-backed map has no
+    // byte mirror: keeping one here would either require a readback or let a later
+    // changed-region upload compare against stale pixels.
+    data: Option<Vec<u8>>,
+    source: MapSource,
+    cutout: bool,
+    levels: Vec<wgpu::TextureView>,
+}
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+enum MapSource {
+    Cpu,
+    GpuComposite,
+    CpuFallback,
+}
+struct Material {
+    masked: bool,
+    cutout: bool,
+    color: MaterialColor,
+    normal: Map,
+    group: wgpu::BindGroup,
+    _uniform: wgpu::Buffer,
+    surface_version: u64,
+}
+enum MaterialColor {
+    Owned(Box<Map>),
+    Surface { size: [u32; 2], key: Key, cutout: bool },
+}
+impl MaterialColor {
+    fn size(&self) -> [u32; 2] {
+        match self {
+            Self::Owned(map) => map.size,
+            Self::Surface { size, .. } => *size,
+        }
+    }
+    fn key(&self) -> Key {
+        match self {
+            Self::Owned(map) => map.key,
+            Self::Surface { key, .. } => *key,
+        }
+    }
+    fn cutout(&self) -> bool {
+        match self {
+            Self::Owned(map) => map.cutout,
+            Self::Surface { cutout, .. } => *cutout,
+        }
+    }
+}
+fn material_map_key(key: Key, size: [u32; 2]) -> Key {
+    (key.0, key.1, key.2, key.3 ^ ((u64::from(size[0])) << 32) ^ u64::from(size[1]))
+}
+struct Batch {
+    material: usize,
+    vertices: std::ops::Range<u32>,
+}
+struct Mesh {
+    geometry: Arc<Geometry>,
+    vertices: wgpu::Buffer,
+    batches: Vec<Batch>,
+    wire_vertices: wgpu::Buffer,
+    wire_batches: Vec<Batch>,
+    selection: wgpu::Buffer,
+    group: wgpu::BindGroup,
+    selected: BTreeSet<usize>,
+}
+struct Target {
+    _texture: wgpu::Texture,
+    view: wgpu::TextureView,
+    _depth: wgpu::Texture,
+    depth: wgpu::TextureView,
+    _depth_msaa: Option<wgpu::Texture>,
+    depth_msaa: Option<wgpu::TextureView>,
+    _msaa: Option<wgpu::Texture>,
+    msaa: Option<wgpu::TextureView>,
+    size: [u32; 2],
+    samples: u32,
+}
+
+type FrameKey = (u64, Camera, [u32; 2], bool, u64, bool, [u8; 4], u32);
+
+pub(crate) struct Renderer {
+    rs: RenderState,
+    health: photocraft_gpu::DeviceHealth,
+    adapter_label: String,
+    camera: wgpu::Buffer,
+    lighting: photocraft_uv::lighting::Settings,
+    environment: GpuEnvironment,
+    surfaces: Vec<GpuSurface>,
+    background_pipelines: Vec<wgpu::RenderPipeline>,
+    wireframe_pipelines: Vec<wgpu::RenderPipeline>,
+    camera_layout: wgpu::BindGroupLayout,
+    material_layout: wgpu::BindGroupLayout,
+    sampler: wgpu::Sampler,
+    mips: crate::uv_mips::Mips,
+    compositor: Option<photocraft_gpu::Compositor>,
+    compositor_error: Option<String>,
+    last_map_stats: Option<photocraft_gpu::Stats>,
+    map_blit_layout: wgpu::BindGroupLayout,
+    map_blit: wgpu::RenderPipeline,
+    pipelines: Vec<wgpu::RenderPipeline>,
+    aa_samples: u32,
+    mesh: Option<Mesh>,
+    materials: Vec<Option<Material>>,
+    target: Option<Target>,
+    spare_target: Option<Target>,
+    texture_id: Option<egui::TextureId>,
+    last: Option<FrameKey>,
+    wireframe_enabled: bool,
+    wireframe_color: [u8; 4],
+    wireframe_opacity: f32,
+    map_generation: u64,
+    last_pbr_active: bool,
+    regions: std::collections::BTreeMap<(usize, bool), crate::uv_lighting::RegionHint>,
+    #[cfg(test)]
+    timer: Option<photocraft_gpu::timing::GpuTimer>,
+}
+pub(crate) struct Draw<'a> {
+    pub scene: &'a Scene,
+    pub geometry: Arc<Geometry>,
+    pub camera: Camera,
+    pub size: [u32; 2],
+    pub antialias: bool,
+    pub selected: &'a BTreeSet<usize>,
+    pub hidden: &'a BTreeSet<usize>,
+    pub generation: u64,
+    pub colors: &'a [Option<Image>],
+    pub normals: &'a [Option<Image>],
+    pub keys: &'a [Key],
+    pub normal_keys: &'a [(u64, u64, u64)],
+    pub masked: &'a BTreeSet<usize>,
+}
+fn floats(values: &[f32]) -> Vec<u8> {
+    values.iter().flat_map(|v| v.to_le_bytes()).collect()
+}
+fn extent(size: [u32; 2]) -> wgpu::Extent3d {
+    wgpu::Extent3d { width: size[0], height: size[1], depth_or_array_layers: 1 }
+}
+fn texture(device: &wgpu::Device, size: [u32; 2], format: wgpu::TextureFormat, samples: u32, usage: wgpu::TextureUsages, label: &str) -> wgpu::Texture {
+    device.create_texture(&wgpu::TextureDescriptor {
+        label: Some(label),
+        size: extent(size),
+        mip_level_count: 1,
+        sample_count: samples,
+        dimension: wgpu::TextureDimension::D2,
+        format,
+        usage,
+        view_formats: &[],
+    })
+}
+impl Renderer {
+    fn ensure_surface(&mut self, id: usize) -> Result<(), String> {
+        while self.surfaces.len() <= id {
+            let mut maps = Vec::new();
+            for _ in 0..5 {
+                maps.push(self.map_region(None, Key::default(), true, None, None)?);
+            }
+            self.surfaces.push(GpuSurface {
+                maps,
+                gpu_spares: std::iter::repeat_with(|| None).take(5).collect(),
+                present: [false; 5],
+                use_color_for_pbr: false,
+                version: 0,
+            });
+        }
+        Ok(())
+    }
+    pub(crate) fn set_lighting(
+        &mut self,
+        settings: photocraft_uv::lighting::Settings,
+        maps: &crate::uv_lighting::SurfaceMaps,
+        environment: Arc<photocraft_uv::lighting::Environment>,
+    ) -> Result<(), String> {
+        let settings = settings.sanitized();
+        if settings != self.lighting {
+            self.lighting = settings;
+            self.last = None;
+            self.last_pbr_active = false;
+        }
+        if !Arc::ptr_eq(&self.environment.source, &environment) || self.environment.output_hash != maps.output.as_ref().map_or(0, |(hash, _)| *hash) {
+            self.environment = GpuEnvironment::new(&self.rs, &self.mips, environment, maps.output.as_ref())?;
+            self.last = None;
+        }
+        for material in 0..maps.images.iter().map(Vec::len).chain(maps.gpu.iter().map(Vec::len)).max().unwrap_or(0) {
+            self.ensure_surface(material)?;
+            let use_color_for_pbr = maps.use_color_for_pbr.get(material).copied().unwrap_or(false);
+            if let Some(surface) = self.surfaces.get_mut(material)
+                && surface.use_color_for_pbr != use_color_for_pbr
+            {
+                surface.use_color_for_pbr = use_color_for_pbr;
+                surface.version = surface.version.wrapping_add(1);
+                self.map_generation = self.map_generation.wrapping_add(1);
+            }
+            for kind in 0..5 {
+                let image = maps.images.get(kind).and_then(|m| m.get(material)).and_then(Option::as_ref);
+                let gpu_request = maps.gpu.get(kind).and_then(|m| m.get(material)).and_then(Option::as_ref);
+                let key = gpu_request.map_or_else(|| maps.keys.get(kind).and_then(|m| m.get(material)).copied().unwrap_or_default(), |request| request.key);
+                let present = image.is_some() || gpu_request.is_some();
+                let gpu_source = gpu_request.is_some();
+                let changed = self.surfaces.get(material).and_then(|s| s.maps.get(kind)).is_none_or(|m| {
+                    m.key != key || if gpu_source { !matches!(m.source, MapSource::GpuComposite | MapSource::CpuFallback) } else { m.source != MapSource::Cpu }
+                }) || self.surfaces.get(material).and_then(|s| s.present.get(kind)).copied() != Some(present);
+                if changed {
+                    let hint = maps.regions.get(kind).and_then(|slots| slots.get(material)).cloned().flatten();
+                    let map = if let Some(request) = gpu_request {
+                        let spare = self.surfaces.get_mut(material).and_then(|surface| surface.gpu_spares.get_mut(kind)).and_then(Option::take);
+                        match self.map_gpu_composite(&request.doc, request.key, request.linear_srgb, spare) {
+                            Ok(map) => map,
+                            Err(_) => {
+                                // Unsupported GPU features and transient device errors keep a
+                                // complete CPU map available; never expose a partially written
+                                // destination or leave the previous revision active.
+                                let fallback_doc = crate::gpu_canvas::materialize_paint_masks(&request.doc);
+                                let rendered = photocraft_compose::render(&fallback_doc, fallback_doc.bounds());
+                                let rgba = if request.linear_srgb {
+                                    rendered
+                                        .px
+                                        .into_iter()
+                                        .map(|mut p| {
+                                            for c in &mut p[..3] {
+                                                *c = if *c <= 0.04045 { *c / 12.92 } else { ((*c + 0.055) / 1.055).powf(2.4) };
+                                            }
+                                            p
+                                        })
+                                        .collect()
+                                } else {
+                                    rendered.px
+                                };
+                                let image = Image { width: request.doc.size.width as usize, height: request.doc.size.height as usize, rgba };
+                                let empty = self.map_single(None, Key::default(), true, None, None)?;
+                                let previous = self.surfaces.get_mut(material).and_then(|s| s.maps.get_mut(kind)).map(|map| std::mem::replace(map, empty));
+                                let mut map = self.map_region(Some(&image), request.key, true, previous, None)?;
+                                map.source = MapSource::CpuFallback;
+                                map
+                            }
+                        }
+                    } else {
+                        let empty = self.map_single(None, Key::default(), true, None, None)?;
+                        let previous = self.surfaces.get_mut(material).and_then(|s| s.maps.get_mut(kind)).map(|map| std::mem::replace(map, empty));
+                        self.map_region(image, key, true, previous, hint)?
+                    };
+                    let mut map = map;
+                    map.cutout = kind == 0 && (gpu_source || image.is_some_and(|im| im.rgba.iter().any(|pixel| pixel[3] < 1.0)));
+                    if let Some(surface) = self.surfaces.get_mut(material) {
+                        if let Some(slot) = surface.maps.get_mut(kind) {
+                            let old = std::mem::replace(slot, map);
+                            if old.source == MapSource::GpuComposite
+                                && let Some(spare) = surface.gpu_spares.get_mut(kind)
+                            {
+                                *spare = Some(old);
+                            }
+                        }
+                        if let Some(v) = surface.present.get_mut(kind) {
+                            *v = present;
+                        }
+                        surface.version = surface.version.wrapping_add(1);
+                    }
+                    self.map_generation = self.map_generation.wrapping_add(1);
+                }
+            }
+        }
+        Ok(())
+    }
+    pub fn adapter_label(&self) -> &str {
+        &self.adapter_label
+    }
+    pub(crate) fn take_map_stats(&mut self) -> Option<photocraft_gpu::Stats> {
+        self.last_map_stats.take()
+    }
+    pub fn texture_sizes(&self) -> Vec<([u32; 2], [u32; 2])> {
+        self.materials.iter().map(|m| m.as_ref().map_or(([0; 2], [0; 2]), |m| (m.color.size(), m.normal.size))).collect()
+    }
+    pub fn max_texture_side(&self) -> u32 {
+        self.rs.device.limits().max_texture_dimension_2d
+    }
+    pub fn frame_info(&self) -> Option<([u32; 2], u32)> {
+        self.target.as_ref().map(|t| (t.size, t.samples))
+    }
+    pub fn set_wireframe(&mut self, enabled: bool, color: [u8; 4], opacity: f32) {
+        let opacity = if opacity.is_finite() { opacity.clamp(0.0, 1.0) } else { 0.75 };
+        self.wireframe_enabled = enabled;
+        self.wireframe_color = color;
+        self.wireframe_opacity = opacity;
+    }
+    pub fn diagnostics(&self, channel: photocraft_uv::preview::Channel) -> serde_json::Value {
+        let frame = self.frame_info();
+        let maps: Vec<_> = self
+            .surfaces
+            .iter()
+            .enumerate()
+            .map(|(material, surface)| {
+                let maps: Vec<_> = surface
+                    .maps
+                    .iter()
+                    .enumerate()
+                    .filter(|(kind, _)| surface.present.get(*kind).copied().unwrap_or(false))
+                    .map(|(kind, map)| {
+                        let channel = match kind {
+                            0 => "Color",
+                            1 => "Normal",
+                            2 => "AO",
+                            3 => "Metallic",
+                            4 => "Roughness",
+                            _ => "Unknown",
+                        };
+                        let source = match map.source {
+                            MapSource::Cpu => "cpu",
+                            MapSource::GpuComposite => "gpu-composite",
+                            MapSource::CpuFallback => "cpu-fallback",
+                        };
+                        serde_json::json!({"channel": channel, "source": source, "size": map.size})
+                    })
+                    .collect();
+                serde_json::json!({"material": material, "maps": maps})
+            })
+            .collect();
+        serde_json::json!({
+            "rendererActive": self.health.is_ok(),
+            "backend": self.adapter_label,
+            "renderTargetSize": frame.map(|(size, _)| size),
+            "samples": frame.map(|(_, samples)| samples),
+            "pbrEnabled": self.lighting.pbr,
+            "pbrActive": self.last_pbr_active && self.last.as_ref().is_some_and(|(_, camera, _, _, _, _, _, _)| camera.channel == channel),
+            "channel": channel.label(),
+            "mapCompositorActive": self.compositor.is_some() && self.health.is_ok(),
+            "mapCompositorError": self.compositor_error,
+            "maps": maps,
+            "maxTextureDimension2d": self.max_texture_side(),
+        })
+    }
+    pub fn clear(&mut self) {
+        self.regions.clear();
+        self.mesh = None;
+        self.materials.clear();
+        self.surfaces.clear();
+        self.target = None;
+        self.spare_target = None;
+        self.last = None;
+        self.last_pbr_active = false;
+        if let Some(id) = self.texture_id.take() {
+            self.rs.renderer.write().free_texture(&id);
+        }
+    }
+    pub fn new(rs: RenderState, health: photocraft_gpu::DeviceHealth) -> Result<Self, String> {
+        Self::new_with_map_compositor(rs, health, true)
+    }
+    fn new_with_map_compositor(rs: RenderState, health: photocraft_gpu::DeviceHealth, enable_map_compositor: bool) -> Result<Self, String> {
+        use std::future::Future;
+        let validation = rs.device.push_error_scope(wgpu::ErrorFilter::Validation);
+        let memory = rs.device.push_error_scope(wgpu::ErrorFilter::OutOfMemory);
+        let result = std::panic::catch_unwind(std::panic::AssertUnwindSafe(|| Self::create(rs.clone(), health, enable_map_compositor)));
+        let mut cx = std::task::Context::from_waker(std::task::Waker::noop());
+        for pop in [memory.pop(), validation.pop()] {
+            if let std::task::Poll::Ready(Some(error)) = std::pin::pin!(pop).poll(&mut cx) {
+                return Err(format!("3D GPU setup failed: {error}"));
+            }
+        }
+        result.map_err(|_| "3D GPU setup panicked; using CPU preview".to_owned())?
+    }
+    fn create(rs: RenderState, health: photocraft_gpu::DeviceHealth, enable_map_compositor: bool) -> Result<Self, String> {
