+                photocraft_compose::mask_paint::refresh_changes_in_canvas(mask, old, mask_canvas);
+            }
+        }
         if let (Some(k), Some(id)) = (restrict, active) {
             channel_cmds::restrict_to_color(&before, &mut doc, id, k);
         }
