+pub(crate) struct Preview {
+    generation: u64,
+    doc: DocId,
+    revision: u64,
+    layer: LayerId,
+    index: usize,
+    opacity: f32,
+    bounds: Option<[i32; 4]>,
+    rotation: Option<f32>,
+    shown: Option<(u64, Arc<Document>)>,
+    mask_sampler: FillMaskSampler,
+    materialized: Option<(u64, Arc<Document>)>,
+}
