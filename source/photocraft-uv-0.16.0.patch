+                assert_eq!(
+                    preview.session.active().unwrap().doc.layer(layer).unwrap().mask.as_ref().unwrap().paint.as_ref().unwrap().layers[changed_index].opacity,
+                    commit.opacity
+                );
+            }
+        }
+    }
